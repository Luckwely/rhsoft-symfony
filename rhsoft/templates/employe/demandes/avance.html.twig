{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mes Demandes{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Mes Demandes
            </h3>
            <p class="text-muted mb-0">
                Gérez vos avances et attestations
            </p>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="demandesTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a href="{{ path("app_employe_demandes_avance") }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-coin text-success me-2"></i>Avance
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a href="{{ path("app_employe_demandes_demission") }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Démission
            </a>
        </li>
    </ul>

    <!-- CONTENU -->
    <div class="tab-pane fade show active">
        <div class="row g-4">
            <!-- FORMULAIRE AVANCE -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-plus-circle text-success me-2"></i>Demander une avance
                        </h5>
                        <small class="text-muted">Remplissez le formulaire ci-dessous</small>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.montant, 'Montant demandé *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    {# We use form_widget without extra markup if MoneyType handles the text wrapper, or strip the addon if MoneyType outputs its own symbol #}
                                    {{ form_widget(form.montant, {'attr': {'class': 'form-control', 'placeholder': '500', 'min': '50', 'max': '800', 'step': '10'}}) }}
                                </div>
                                <small class="text-muted">Montant maximum autorisé: 800 €</small>
                                {{ form_errors(form.montant) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.motif, 'Motif *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.motif, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.motif) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.commentaire, 'Commentaire (optionnel)', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': '3', 'placeholder': 'Précisions complémentaires...'}}) }}
                                {{ form_errors(form.commentaire) }}
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-send me-2"></i>Envoyer la demande
                            </button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <!-- INFOS AVANCE & HISTORIQUE -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-info-circle text-info me-2"></i>Informations
                        </h5>
                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                            <div>
                                <span class="text-muted small">Maximum autorisé</span>
                                <div class="fw-bold text-primary fs-4">800 €</div>
                            </div>
                            <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">Par demande</span>
                        </div>
                        <div class="mt-3 alert alert-warning border-0 rounded-3 small">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            L'avance sera déduite de votre prochain salaire.
                        </div>
                        <div class="mt-2 alert alert-info border-0 rounded-3 small mb-0">
                            <i class="bi bi-clock me-1"></i>
                            Délai de traitement: 48h ouvrées
                        </div>
                    </div>
                </div>

                <!-- TABLEAU DEMANDES PRÉCÉDENTES -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock-history text-primary me-2"></i>Demandes précédentes
                        </h5>
                        <small class="text-muted">Historique de vos avances</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-borderless mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3 py-2">Montant</th>
                                        <th class="py-2">Date</th>
                                        <th class="py-2 text-center pe-3">Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in demandesPrecedentes %}
                                        <tr>
                                            <td class="ps-3 fw-semibold">{{ item.montant }} €</td>
                                            <td>{{ item.dateDemande ? item.dateDemande|date('d/m/Y') : '-' }}</td>
                                            <td class="text-center pe-3">
                                                {% if item.statut == 'valide' %}
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                                    </span>
                                                {% elseif item.statut == 'refuse' %}
                                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                                        <i class="bi bi-clock-fill me-1"></i>En attente
                                                    </span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center py-3 text-muted">Aucune demande enregistrée.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
