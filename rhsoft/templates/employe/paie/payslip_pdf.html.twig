<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; font-size: 13px; color: #212529; }
        .header { display: table; width: 100%; margin-bottom: 20px; border-bottom: 2px solid #0d6efd; padding-bottom: 15px; }
        .header .company { font-size: 18px; font-weight: bold; color: #0d6efd; }
        .header .meta { text-align: right; }
        h1 { font-size: 20px; margin: 0 0 5px 0; }
        table.info { width: 100%; margin-bottom: 20px; }
        table.info td { padding: 4px 0; vertical-align: top; }
        table.info td.label { color: #6c757d; width: 150px; }
        table.amounts { width: 100%; border-collapse: collapse; margin-top: 15px; }
        table.amounts th, table.amounts td { border: 1px solid #dee2e6; padding: 8px 10px; text-align: left; }
        table.amounts th { background-color: #f8f9fa; }
        table.amounts td.number { text-align: right; }
        .net-row { font-weight: bold; background-color: #e7f1ff; }
        .footer { margin-top: 40px; font-size: 11px; color: #6c757d; text-align: center; }
    </style>
</head>
<body>
    <div class="header">
        <div class="company">{{ entreprise.nom }}</div>
        {% if entreprise.adresse %}<div>{{ entreprise.adresse }}</div>{% endif %}
        {% if entreprise.tel %}<div>{{ entreprise.tel }}</div>{% endif %}
    </div>

    <h1>Fiche de paie</h1>
    <p>Période : <strong>{{ payslip.mois }}/{{ payslip.annee }}</strong></p>

    <table class="info">
        <tr>
            <td class="label">Employé</td>
            <td>{{ employee.prenom }} {{ employee.nom }}</td>
        </tr>
        <tr>
            <td class="label">Poste</td>
            <td>{{ employee.poste|default('-') }}</td>
        </tr>
        <tr>
            <td class="label">Email</td>
            <td>{{ employee.email }}</td>
        </tr>
        <tr>
            <td class="label">Statut</td>
            <td>{{ payslip.status }}</td>
        </tr>
    </table>

    <table class="amounts">
        <thead>
            <tr>
                <th>Élément</th>
                <th class="number">Montant</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Salaire brut</td>
                <td class="number">{{ payslip.salaireBrut }} €</td>
            </tr>
            <tr>
                <td>Cotisations</td>
                <td class="number">- {{ payslip.cotisations }} €</td>
            </tr>
            <tr class="net-row">
                <td>Salaire net à payer</td>
                <td class="number">{{ payslip.salaireNet }} €</td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        Document généré le {{ "now"|date('d/m/Y à H:i') }} — {{ entreprise.nom }}
    </div>
</body>
</html>
