{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion des Employés - Sorties{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Gestion des Employés
        </h3>
        <p class="text-muted mb-0">
            Gérez vos collaborateurs, embauches et sorties
        </p>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a href="{{ path('app_rh_employee') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-list-ul me-2"></i>Liste des Employés
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_embauche') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-person-plus text-success me-2"></i>Embauches
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_sortie') }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-person-x text-danger me-2"></i>Sorties
                <span class="badge bg-danger ms-1">{{ sorties.getTotalItemCount }}</span>
            </a>
        </li>
    </ul>

    <!-- BARRE DE RECHERCHE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="GET" action="{{ path('app_rh_employee_sortie') }}" class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" value="{{ app.request.query.get('q') }}" class="form-control bg-light border-0" placeholder="Rechercher par nom, prénom ou email...">
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CONTENU ONGLETS -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-x text-danger me-2"></i>Sorties d'employés
                </h5>
                <small class="text-muted">Historique des départs</small>
            </div>
            <button class="btn btn-outline-danger btn-sm">
                <i class="bi bi-download me-1"></i>Exporter
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Employé</th>
                            <th class="py-3">Poste</th>
                            <th class="py-3">Date Sortie</th>
                            <th class="py-3">Motif</th>
                            <th class="py-3 text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for employee in sorties %}
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        {% if employee.photo %}
                                            <img src="{{ asset('uploads/employees/' ~ employee.photo) }}" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" alt="">
                                        {% else %}
                                            <div class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                                {{ employee.prenom|slice(0,1)|upper }}{{ employee.nom|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        <div>
                                            <div class="fw-semibold">{{ employee.prenom }} {{ employee.nom }}</div>
                                            <small class="text-muted">{{ employee.email }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>{{ employee.poste ?? 'N/A' }}</td>
                                <td>{{ employee.dateSortie ? employee.dateSortie|date('d/m/Y') : 'N/A' }}</td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                        {{ employee.motifSortie ?? 'Démission' }}
                                    </span>
                                </td>
                                <td class="text-center pe-3">
                                    <a href="{{ path('app_rh_employee_certificat', {id: employee.id}) }}" class="btn btn-sm btn-outline-primary" target="_blank">
                                        <i class="bi bi-file-earmark-pdf me-1"></i>Générer certificat
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Aucun départ enregistré.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>{{ sorties.getTotalItemCount }} départs enregistrés
            </small>
            <div>
                {{ knp_pagination_render(sorties) }}
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
</style>
{% endblock %}
