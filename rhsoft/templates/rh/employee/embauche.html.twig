{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion des Employés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Gestion des Employés
        </h3>
        <p class="text-muted mb-0">
            Gérez vos collaborateurs, embauches et sorties
        </p>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a href="{{ path('app_rh_employee') }}" class="nav-link border-0 rounded-3 px-4"
                <i class="bi bi-list-ul me-2"></i>Liste des Employés
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_embauche') }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-person-plus text-success me-2"></i>Embauches
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_sortie') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-person-x text-danger me-2"></i>Sorties
            </a>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-person-plus text-success me-2"></i>Nouvelle Embauche
            </h5>
            <small class="text-muted">Enregistrez un nouvel employé dans la plateforme</small>
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
                <div class="col-md-6">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.prenom) }}
                    {{ form_errors(form.prenom) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.telephone) }}
                    {{ form_errors(form.telephone) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.roles) }}
                    {{ form_errors(form.roles) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.adresse, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.adresse) }}
                    {{ form_errors(form.adresse) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.dateEmbauche, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.dateEmbauche) }}
                    {{ form_errors(form.dateEmbauche) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.soldeConge, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.soldeConge) }}
                    {{ form_errors(form.soldeConge) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.salaireBase, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.salaireBase) }}
                    {{ form_errors(form.salaireBase) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.photo, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.photo) }}
                    {{ form_errors(form.photo) }}
                </div>
                <div class="col-md-12">
                    {{ form_label(form.cv, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.cv) }}
                    {{ form_errors(form.cv) }}
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check2 me-1"></i>Valider l'embauche
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
