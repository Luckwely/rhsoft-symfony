{% extends "layouts/base_rh.html.twig" %}

{% block title %}Tableau de bord - Administration{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Tableau de bord
            </h3>
            <p class="text-muted mb-0">
                {{ "now"|date("d/m/Y") }} • Vue d'ensemble de l'activité
            </p>
        </div>
    </div>

    <!-- 4 KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Effectif</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.totalEmployees|default(0) }}</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Congés en attente</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.pendingLeaves|default(0) }}</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Absences aujourd'hui</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.absentToday|default(0) }}</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Retards aujourd'hui</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.lateToday|default(0) }}</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-file-earmark-person text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTIVITE RECENTE & ACTIONS RAPIDES -->
    <div class="row g-4">
        <!-- Card: Activité récente -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock-history text-primary me-2"></i>Activité récente
                        </h5>
                        <small class="text-muted">Dernières actions sur la plateforme</small>
                    </div>
                    <button class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-right me-1"></i>Voir tout
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 d-flex align-items-center gap-3 py-3">
                            <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-person-plus text-success fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Jean Dupont</div>
                                <div class="text-muted small">a été embauché comme Développeur Frontend</div>
                            </div>
                            <span class="badge bg-light text-muted small">Il y a 2h</span>
                        </div>
                        <div class="list-group-item border-0 d-flex align-items-center gap-3 py-3">
                            <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-calendar-check text-warning fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Marie Martin</div>
                                <div class="text-muted small">a demandé un congé du 25/10 au 02/11</div>
                            </div>
                            <span class="badge bg-light text-muted small">Il y a 4h</span>
                        </div>
                        <div class="list-group-item border-0 d-flex align-items-center gap-3 py-3">
                            <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-exclamation-triangle text-danger fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Anomalie détectée</div>
                                <div class="text-muted small">Pointage de Paul Dubois : 15 min de retard</div>
                            </div>
                            <span class="badge bg-light text-muted small">Il y a 5h</span>
                        </div>
                        <div class="list-group-item border-0 d-flex align-items-center gap-3 py-3">
                            <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-file-earmark-text text-info fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Rapport mensuel</div>
                                <div class="text-muted small">Le rapport de septembre 2025 est disponible</div>
                            </div>
                            <span class="badge bg-light text-muted small">Hier</span>
                        </div>
                        <div class="list-group-item border-0 d-flex align-items-center gap-3 py-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-building text-primary fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Nouvelle entreprise</div>
                                <div class="text-muted small">TechInnovate SAS a rejoint la plateforme</div>
                            </div>
                            <span class="badge bg-light text-muted small">Hier</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card: Actions Rapides -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-lightning text-primary me-2"></i>Actions Rapides
                    </h5>
                    <small class="text-muted">Accédez aux tâches courantes</small>
                </div>
                <div class="card-body">
                    <!-- Action 1: Inviter un employé -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2" style="cursor: pointer;">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-person-plus text-primary fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Inviter un employé</div>
                            <div class="text-muted small">Envoyer une invitation par email</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>

                    <!-- Action 2: Nouvelle offre d'emploi -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2" style="cursor: pointer;">
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-briefcase text-success fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Nouvelle offre d'emploi</div>
                            <div class="text-muted small">Publier une annonce</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>

                    <!-- Action 3: Valider les pointages -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2" style="cursor: pointer;">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-clock text-warning fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Valider les pointages</div>
                            <div class="text-muted small">5 pointages en attente</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>

                    <!-- Action 4: Générer un rapport -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3" style="cursor: pointer;">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-graph-up text-info fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Générer un rapport</div>
                            <div class="text-muted small">Rapport RH mensuel</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <div class="text-center text-muted small">
                        <i class="bi bi-arrow-repeat me-1"></i>Dernière mise à jour : {{ "now"|date("H:i") }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
