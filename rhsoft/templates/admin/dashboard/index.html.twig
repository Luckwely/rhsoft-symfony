{% extends "layouts/base_admin.html.twig" %}

{% block title %}Tableau de bord - Administration{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-0">
                Tableau de bord
            </h1>
            <p class="text-muted small mb-0">Bienvenue, Administrateur • Vue d'ensemble de l'activité</p>
        </div>
    </div>

    <!-- SECTION 1: 4 STATS CARDS -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Effectif Total</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.totalEmployees|default(0) }}</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Présents Aujourd'hui</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.presentToday|default(0) }} / {{ dashboard.totalEmployees|default(0) }}</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-person-check text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Congés En Attente</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.pendingLeaves|default(0) }}</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Masse Salariale</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.payrollMass|default(0)|number_format(2, ',', ' ') }} €</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-euro text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: 2 COLONNES -->
    <div class="row g-4 mb-4">
        <!-- Colonne Gauche: Activité Récente -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock-history text-primary me-2"></i>Activité Récente
                        </h5>
                        <small class="text-muted">Dernières actions en temps réel</small>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary">Aujourd'hui</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        {% for activity in dashboard.recentActivity %}
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="{{ activity.iconBg }} bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-{{ activity.icon }} {{ activity.iconBg|replace({'bg-': 'text-'}) }}"></i>
                                    </div>
                                    <div>
                                        <span class="fw-semibold">{{ activity.employee.prenom }} {{ activity.employee.nom }}</span>
                                        <span class="text-muted small">{{ activity.message }}</span>
                                    </div>
                                </div>
                                <span class="badge {{ activity.badgeClass }}">{{ activity.badgeLabel }}</span>
                            </div>
                        {% else %}
                            <div class="list-group-item border-0 py-4 text-center text-muted">
                                Aucune activité récente
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                    <a href="{{ path('app_admin_pointage') }}" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-right me-1"></i>Voir toutes les activités
                    </a>
                </div>
            </div>
        </div>

        <!-- Colonne Droite: Alertes RH -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-bell text-primary me-2"></i>Alertes RH
                        </h5>
                        <small class="text-muted">Actions requises</small>
                    </div>
                    <span class="badge bg-danger">3 urgentes</span>
                </div>
                <div class="card-body bg-light rounded-bottom">
                    <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-white rounded-3 shadow-sm">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-file-earmark-check text-danger fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small">Contrats qui expirent</span>
                                <span class="badge bg-danger">{{ dashboard.alertContractsExpiring|default(0) }}</span>
                            </div>
                            <small class="text-muted">Moins de 30 jours</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-white rounded-3 shadow-sm">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-clock-history text-warning fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small">Périodes d'essai</span>
                                <span class="badge bg-warning text-dark">{{ dashboard.alertProbation|default(0) }}</span>
                            </div>
                            <small class="text-muted">Qui se terminent</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 shadow-sm">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-person-plus text-info fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small">Entretiens annuels</span>
                                <span class="badge bg-info">{{ dashboard.alertAnnualReviews|default(0) }}</span>
                            </div>
                            <small class="text-muted">À planifier</small>
                        </div>
                    </div>
                    <div class="mt-3 text-center">
                        <a href="{{ path('app_admin_employee') }}" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-eye me-1"></i>Voir tout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 3: PLEINE LARGEUR - Répartition par Service -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-pie-chart text-primary me-2"></i>Répartition par Service
                        </h5>
                        <small class="text-muted">Effectif par département</small>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        {% for service in dashboard.services %}
                            <span class="badge bg-primary bg-opacity-10 text-primary">{{ service.service }}: {{ service.total }}</span>
                        {% else %}
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">Aucun service défini</span>
                        {% endfor %}
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="chartService" height="280"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 4: TABLEAU - Derniers Pointages -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock text-primary me-2"></i>Derniers Pointages
                        </h5>
                        <small class="text-muted">Pointages du jour</small>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-right me-1"></i>Voir tout
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Employé</th>
                                    <th class="py-3">Service</th>
                                    <th class="py-3 text-center">Entrée</th>
                                    <th class="py-3 text-center">Sortie</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for pointage in dashboard.recentPointages %}
                                    {% set employee = pointage.employee %}
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                                    {{ ((employee.prenom|default('')|slice(0,1) ~ employee.nom|default('')|slice(0,1))|upper)|default('--') }}
                                                </div>
                                                <div>
                                                    <div class="fw-semibold small">{{ employee.prenom ~ ' ' ~ employee.nom }}</div>
                                                    <div class="text-muted small">{{ employee.poste ?: employee.service ?: 'N/A' }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>{{ employee.service ?: 'N/A' }}</td>
                                        <td class="text-center">{{ pointage.heureEntree ? pointage.heureEntree|date('H:i') : '-' }}</td>
                                        <td class="text-center">{{ pointage.heureSortie ? pointage.heureSortie|date('H:i') : '-' }}</td>
                                        <td class="text-center pe-3">
                                            {% set statut = pointage.statut|default('inconnu') %}
                                            {% set badgeClass = statut == 'present' ? 'bg-success bg-opacity-10 text-success' : statut == 'retard' ? 'bg-warning bg-opacity-10 text-warning' : statut == 'absent' ? 'bg-danger bg-opacity-10 text-danger' : 'bg-secondary bg-opacity-10 text-secondary' %}
                                            {% set icon = statut == 'present' ? 'check-circle-fill' : statut == 'retard' ? 'exclamation-triangle' : statut == 'absent' ? 'x-circle-fill' : 'dash' %}
                                            <span class="badge {{ badgeClass }}">
                                                <i class="bi bi-{{ icon }} me-1"></i>{{ pointage.statutLabel() }}
                                            </span>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Aucun pointage récent trouvé</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage des 8 derniers pointages
                    </small>
                    <a href="{{ path('app_admin_pointage') }}" class="btn btn-sm btn-outline-primary">
                        Voir tous les pointages <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Graphique Répartition par Service - Doughnut Chart
    const ctx = document.getElementById('chartService').getContext('2d');

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: {{ dashboard.serviceLabels|default([])|json_encode()|raw }},
            datasets: [{
                data: {{ dashboard.serviceCounts|default([])|json_encode()|raw }},
                backgroundColor: [
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(25, 135, 84, 0.8)',
                    'rgba(255, 193, 7, 0.8)',
                    'rgba(13, 202, 240, 0.8)',
                    'rgba(220, 53, 69, 0.8)',
                    'rgba(108, 117, 125, 0.8)'
                ],
                borderColor: [
                    '#0d6efd',
                    '#198754',
                    '#ffc107',
                    '#0dcaf0',
                    '#dc3545',
                    '#6c757d'
                ],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 20,
                        usePointStyle: true,
                        pointStyle: 'circle',
                        font: {
                            size: 13,
                            weight: '500'
                        }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = ((context.parsed / total) * 100).toFixed(1);
                            return context.label + ': ' + context.parsed + ' employés (' + percentage + '%)';
                        }
                    }
                }
            },
            cutout: '65%'
        }
    });
});
</script>
{% endblock %}
