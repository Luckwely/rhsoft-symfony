{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Paramètres - RH Soft Pro{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi {{ label == 'error' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill' }} me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- 1. HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Paramètres
        </h3>
        <p class="text-muted mb-0">
            <i class="bi bi-sliders me-1"></i>Gérez la configuration de votre espace RH
        </p>
    </div>

    <!-- 2. LAYOUT 2 COLONNES: MENU GAUCHE + CONTENU DROITE -->
    <div class="row g-4">
        <!-- Menu de navigation latéral -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 80px;">
                <div class="list-group list-group-flush">
                    <a href="#entreprise" class="list-group-item list-group-item-action active border-0 rounded-top-4" data-bs-toggle="list">
                        <i class="bi bi-building me-2"></i>Entreprise
                    </a>
                    <a href="#utilisateurs" class="list-group-item list-group-item-action border-0" data-bs-toggle="list">
                        <i class="bi bi-people me-2"></i>Utilisateurs & Rôles
                    </a>
                    <a href="#pointage" class="list-group-item list-group-item-action border-0" data-bs-toggle="list">
                        <i class="bi bi-clock-history me-2"></i>Pointage & Horaires
                    </a>
                </div>
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="col-lg-9">
            <div class="tab-content">

                <!-- ONGLET 1: ENTREPRISE -->
                <div class="tab-pane fade show active" id="entreprise">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-building text-primary me-2"></i>Informations Entreprise
                            </h5>
                            <small class="text-muted">Modifiez les informations de votre entreprise</small>
                        </div>
                        <div class="card-body">
                            <form method="POST" class="row g-3">
                                <input type="hidden" name="action_type" value="entreprise">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Nom de l'entreprise</label>
                                    <input type="text" name="nom" class="form-control" value="{{ entreprise.nom }}">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Logo</label>
                                    <input type="file" class="form-control">
                                    <small class="text-muted">Format PNG, JPG. Max 2MB</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Adresse</label>
                                    <input type="text" name="adresse" class="form-control" value="{{ entreprise.adresse }}">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Téléphone</label>
                                    <input type="text" name="telephone" class="form-control" value="{{ entreprise.tel }}">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">NIF</label>
                                    <input type="text" name="nif" class="form-control" value="{{ entreprise.nif }}">
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check2 me-1"></i>Enregistrer
                                    </button>
                                    <button type="reset" class="btn btn-outline-secondary ms-2">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Annuler
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- ONGLET 2: UTILISATEURS & ROLES -->
                <div class="tab-pane fade" id="utilisateurs">
                    <!-- Liste des utilisateurs -->
                    <div class="card border-0 shadow-sm rounded-4 mb-3">
                        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-0">
                                    <i class="bi bi-people text-primary me-2"></i>Utilisateurs
                                </h5>
                                <small class="text-muted">Gérez les accès et les statuts des comptes</small>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <!-- Added overflow-visible to prevent clipping dropdowns -->
                            <div class="table-responsive overflow-visible" style="min-height: 300px;">
                                <table class="table table-hover align-middle table-borderless mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-3">Nom</th>
                                            <th>Email</th>
                                            <th>Rôle</th>
                                            <th>Statut</th>
                                            <th class="text-center pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for u in users %}
                                            {# Ajustez selon la propriété réelle de votre entité User (ex: isSuspended ou isActive) #}
                                            {% set isSuspended = u.isSuspended is defined ? u.isSuspended : (u.isActive is defined ? not u.isActive : false) %}
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                                            {{ u.email|slice(0, 2)|upper }}
                                                        </div>
                                                        <span class="fw-semibold">{{ u.email|split('@')[0]|capitalize }}</span>
                                                    </div>
                                                </td>
                                                <td>{{ u.email }}</td>
                                                <td>
                                                    <!-- Inline Role Form -->
                                                    <form action="{{ path('admin_user_update_role', {id: u.id}) }}" method="POST" class="d-flex align-items-center gap-2">
                                                        <input type="hidden" name="token" value="{{ csrf_token('role_user_' ~ u.id) }}">
                                                        <select name="role" class="form-select form-select-sm rounded-pill px-3" onchange="this.form.submit()">
                                                            <option value="ROLE_EMPLOYE" {% if 'ROLE_EMPLOYE' in u.roles and 'ROLE_ADMIN' not in u.roles %}selected{% endif %}>Agent</option>
                                                            <option value="ROLE_MANAGER" {% if 'ROLE_MANAGER' in u.roles %}selected{% endif %}>Manager</option>
                                                            <option value="ROLE_RH" {% if 'ROLE_RH' in u.roles %}selected{% endif %}>RH</option>
                                                            <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in u.roles %}selected{% endif %}>Admin</option>
                                                        </select>
                                                    </form>
                                                </td>
                                                <td>
                                                    {% if isSuspended %}
                                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">Suspendu</span>
                                                    {% else %}
                                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Actif</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center pe-3">
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-light border-0 shadow-none" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 py-2">
                                                            <li>
                                                                <form action="{{ path('admin_user_toggle_suspend', {id: u.id}) }}" method="POST">
                                                                    <input type="hidden" name="token" value="{{ csrf_token('suspend_user_' ~ u.id) }}">
                                                                    {% if isSuspended %}
                                                                        <button type="submit" class="dropdown-item py-2 text-success">
                                                                            <i class="bi bi-check-circle me-2"></i>Activer le compte
                                                                        </button>
                                                                    {% else %}
                                                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                                                            <i class="bi bi-slash-circle me-2"></i>Suspendre le compte
                                                                        </button>
                                                                    {% endif %}
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-3">Aucun utilisateur trouvé pour cette entreprise.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ONGLET 3: POINTAGE -->
                <div class="tab-pane fade" id="pointage">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-clock-history text-primary me-2"></i>Règles de Pointage
                            </h5>
                            <small class="text-muted">Configurez les horaires et règles de pointage</small>
                        </div>
                        <div class="card-body">
                            <form method="POST" class="row g-3">
                                <input type="hidden" name="action_type" value="pointage">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tolérance Retard</label>
                                    <div class="input-group">
                                        <input type="number" name="tolerance_retard" class="form-control" value="{{ entreprise.toleranceRetard }}">
                                        <span class="input-group-text">minutes</span>
                                    </div>
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check2 me-1"></i>Enregistrer
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Style pour les onglets actifs -->
<style>
    .list-group-item {
        padding: 14px 20px;
        transition: all 0.2s ease;
        color: #6c757d;
        font-weight: 500;
    }
    .list-group-item:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .list-group-item.active {
        background-color: #0d6efd;
        color: #ffffff;
        border-color: #0d6efd;
    }
    .list-group-item i {
        font-size: 18px;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
