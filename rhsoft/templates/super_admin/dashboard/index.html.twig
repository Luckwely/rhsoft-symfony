{% extends "layouts/base_super_admin.html.twig" %}

{% block title %}Dashboard Global SuperAdmin{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-0">
                Dashboard Global
            </h1>
            <p class="text-muted small mb-0">Vue d'ensemble de l'activité RH Soft Pro</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 d-flex align-items-center">
                <i class="bi bi-calendar3 me-2"></i>{{ "now"|date("d/m/Y") }}
            </span>
        </div>
    </div>

    <!-- Row 1: 3 Cards Stat -->
    <div class="row g-4 mb-4">
        <!-- Card 1: CA du Mois -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">CA du Mois</span>
                            <h2 class="display-6 fw-bold mb-0">{{ dashboard.caMonth|default(0)|number_format(0, ',', ' ') }} €</h2>

                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-euro text-success fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Entreprises Actives -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Entreprises Actives</span>
                            <h2 class="display-6 fw-bold mb-0">{{ dashboard.activeCompanies|default(0) }}</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-buildings text-primary fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Utilisateurs Actifs -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Utilisateurs Actifs</span>
                            <h2 class="display-6 fw-bold mb-0">{{ dashboard.totalUsers|default(0) }}</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people text-info fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Graphique + Tableau -->
    <div class="row g-4">
        <!-- Colonne 6: Graphique CA -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Évolution du CA
                        </h5>
                        <small class="text-muted">6 derniers mois</small>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-currency-euro me-1"></i>Chiffre d'affaires
                    </span>
                </div>
                <div class="card-body">
                    <canvas id="chartCA" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Colonne 6: Dernières Inscriptions -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-list-check text-primary me-2"></i>Dernières Inscriptions
                        </h5>
                        <small class="text-muted">5 dernières entreprises</small>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-right me-1"></i>Nouveautés
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Entreprise</th>
                                    <th>Plan</th>
                                    <th>Date</th>
                                    <th class="text-center">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for company in dashboard.recentCompanies %}
                                    {% set firstLetter = company.nom ? company.nom|slice(0, 1)|upper : 'E' %}
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                                    {{ firstLetter }}
                                                </div>
                                                <div>
                                                    <div class="fw-semibold small">{{ company.nom }}</div>
                                                    <div class="text-muted small">{{ company.email }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary text-uppercase">
                                                {{ company.plan|default('Standard') }}
                                            </span>
                                        </td>
                                        <td>
                                            <span class="small">{{ company.createdAt ? company.createdAt|date('d/m/Y') : '-' }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if company.status == 'active' %}
                                                <span class="badge bg-success bg-opacity-10 text-success">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Actif
                                                </span>
                                            {% elseif company.status == 'trial' %}
                                                <span class="badge bg-warning bg-opacity-10 text-warning">
                                                    <i class="bi bi-clock-fill me-1"></i>Essai
                                                </span>
                                           {% else %}
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary text-capitalize">
                                                    <i class="bi bi-pause-circle-fill me-1"></i>{{ company.status }}
                                                </span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">Aucune entreprise enregistrée pour le moment.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage des 5 dernières inscriptions
                    </small>
                    <a href="{{ path('app_super_admin_entreprise') }}" class="btn btn-link text-decoration-none p-0">
                        Voir tout <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="row g-3 mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-6 col-md-3">
                            <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-building text-primary fs-3 d-block mb-1"></i>
                                <div class="small text-muted">Total Entreprises</div>
                                <span class="fw-bold">{{ dashboard.totalCompanies|default(0) }}</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="bg-success bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-people text-success fs-3 d-block mb-1"></i>
                                <div class="small text-muted">Total Utilisateurs</div>
                                <span class="fw-bold">{{ dashboard.totalUsers|default(0) }}</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-credit-card text-warning fs-3 d-block mb-1"></i>
                                <div class="small text-muted">Abonnements Actifs</div>
                                <span class="fw-bold">{{ dashboard.activeSubscriptions|default(0) }}</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="bg-info bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-clock text-info fs-3 d-block mb-1"></i>
                                <div class="small text-muted">Essais en cours</div>
                                <span class="fw-bold">{{ dashboard.trialCompanies|default(0) }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Données du graphique
    const ctx = document.getElementById('chartCA').getContext('2d');

    const months = {{ dashboard.chartLabels|default([])|json_encode()|raw }};
    const values = {{ dashboard.chartValues|default([])|json_encode()|raw }};

    const gradient = ctx.createLinearGradient(0, 0, 0, 250);
    gradient.addColorStop(0, 'rgba(13, 110, 253, 0.3)');
    gradient.addColorStop(1, 'rgba(13, 110, 253, 0.0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: months,
            datasets: [{
                label: 'CA Mensuel (€)',
                data: values,
                borderColor: '#0d6efd',
                backgroundColor: gradient,
                borderWidth: 3,
                pointBackgroundColor: '#0d6efd',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return new Intl.NumberFormat('fr-FR', {
                                style: 'currency',
                                currency: 'EUR'
                            }).format(context.parsed.y);
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        callback: function(value) {
                            return new Intl.NumberFormat('fr-FR', {
                                style: 'currency',
                                currency: 'EUR',
                                maximumFractionDigits: 0
                            }).format(value);
                        }
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}
