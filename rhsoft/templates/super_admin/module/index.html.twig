{% extends "layouts/base_super_admin.html.twig" %}

{% block title %}Gestion des Modules{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-0">
                Gestion des Modules
            </h1>
            <p class="text-muted small mb-0">Activez ou désactivez les modules pour chaque entreprise</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Nouveau Module
            </button>
        </div>
    </div>

    <!-- Statistiques des modules -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-primary mb-1">Modules</span>
                    <h5 class="fw-bold mb-0">{{ stats.totalModules }}</h5>
                    <small class="text-muted">Disponibles</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-success mb-1">Activés</span>
                    <h5 class="fw-bold mb-0 text-success">{{ stats.tauxActivation }}</h5>
                    <small class="text-muted">Taux d'activation</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-info mb-1">Paie</span>
                    <h5 class="fw-bold mb-0 text-info">{{ stats.paie }}</h5>
                    <small class="text-muted">Entreprises</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-warning mb-1">Pointage</span>
                    <h5 class="fw-bold mb-0 text-warning">{{ stats.pointage }}</h5>
                    <small class="text-muted">Entreprises</small>
                </div>
            </div>
        </div>
    </div>

<!-- Filtres -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="GET" action="{{ path('app_super_admin_module') }}">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="position-relative">
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" name="q" value="{{ app.request.query.get('q') }}" class="form-control ps-5" placeholder="Rechercher une entreprise..." aria-label="Rechercher">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="module" class="form-select">
                            <option value="">Tous les modules</option>
                            <option value="paie" {{ app.request.query.get('module') == 'paie' ? 'selected' : '' }}>Module Paie</option>
                            <option value="pointage" {{ app.request.query.get('module') == 'pointage' ? 'selected' : '' }}>Module Pointage</option>
                            <option value="rh" {{ app.request.query.get('module') == 'rh' ? 'selected' : '' }}>Module RH</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="">Tous les statuts</option>
                            <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Activé</option>
                            <option value="inactive" {{ app.request.query.get('status') == 'inactive' ? 'selected' : '' }}>Désactivé</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i>Filtrer
                        </button>
                        {% if app.request.query.count > 0 %}
                            <a href="{{ path('app_super_admin_module') }}" class="btn btn-outline-secondary" title="Réinitialiser">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau des modules -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Entreprise</th>
                            <th class="py-3 text-center">Module Paie</th>
                            <th class="py-3 text-center">Module Pointage</th>
                            <th class="py-3 text-center pe-3">Module RH</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entreprise in pagination %}
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    {% if entreprise.logo %}<img src="{{ asset('uploads/logos/'~entreprise.logo) }}" class="rounded-circle" style="width:36px;height:36px;">
                                    {% else %}<div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;">{{ entreprise.nom|slice(0,2)|upper }}</div>{% endif %}
                                    <div><div class="fw-semibold">{{ entreprise.nom }}</div><div class="text-muted small">{{ entreprise.email }}</div></div>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input module-toggle" type="checkbox"
                                        data-id="{{ entreprise.id }}" data-module="paie"
                                        {{ entreprise.modulePaie ? 'checked' : '' }}>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input module-toggle" type="checkbox"
                                        data-id="{{ entreprise.id }}" data-module="pointage"
                                        {{ entreprise.modulePointage ? 'checked' : '' }}>
                                </div>
                            </td>
                            <td class="text-center pe-3">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input module-toggle" type="checkbox"
                                        data-id="{{ entreprise.id }}" data-module="rh"
                                        {{ entreprise.moduleRh ? 'checked' : '' }}>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center p-5">
                                    <i class="bi bi-search text-muted fs-2 d-block mb-2"></i>
                                    <h6 class="fw-bold">Aucune entreprise trouvée</h6>
                                    <p class="text-muted small mb-0">Essayez de modifier vos filtres de recherche</p>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>

                        <script>
                        document.querySelectorAll('.module-toggle').forEach(toggle => {
                            toggle.addEventListener('change', function() {
                                fetch(`{{ path('app_super_admin_toggle_module', {id: 'ID'}) }}`.replace('ID', this.dataset.id), {
                                    method: 'POST',
                                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                                    body: new URLSearchParams({
                                        module: this.dataset.module,
                                        value: this.checked
                                    })
                                }).then(res => res.json()).then(data => {
                                    if(!data.success) this.checked = !this.checked; // revert si erreur
                                });
                            });
                        });
                        </script>
                </table>
            </div>
        </div>
    <!-- Pagination -->
        <div class="card-footer bg-transparent border-0 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>Affichage de {{ pagination.itemNumberPerPage * (pagination.currentPageNumber - 1) + 1 }} à {{ min(pagination.itemNumberPerPage * pagination.currentPageNumber, pagination.totalItemCount) }} sur {{ pagination.totalItemCount }} entreprises
            </small>

            {# Renders the KnpPaginator render template UI #}
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>

    <!-- Légende des modules -->
    <div class="row g-3 mt-2">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-4 align-items-center">
                        <span class="fw-semibold small">Légende :</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" checked disabled>
                            </div>
                            <span class="text-success small">Activé</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" disabled>
                            </div>
                            <span class="text-muted small">Désactivé</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary">Module Paie</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success">Module Pointage</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-info">Module RH</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
