{% extends "layouts/base_super_admin.html.twig" %}

{% block title %}Administration - Paramètres Système{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-0">
                Administration Système
            </h1>
            <p class="text-muted small mb-0">Gérez les paramètres, templates et logs de la plateforme</p>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="connexions-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#connexions"
                    type="button"
                    role="tab"
                    aria-controls="connexions"
                    aria-selected="true">
                <i class="bi bi-box-arrow-in-right me-2"></i>Connexions
                <span class="badge bg-danger ms-2">{{ total_connections }}</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="erreurs-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#erreurs"
                    type="button"
                    role="tab"
                    aria-controls="erreurs"
                    aria-selected="false">
                <i class="bi bi-exclamation-triangle me-2"></i>Logs Erreurs
                <span class="badge bg-warning ms-2">{{ total_errors }}</span>
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="adminTabsContent">

        <!-- TAB 4: CONNEXIONS -->
        <div class="tab-pane fade show active" id="connexions" role="tabpanel" aria-labelledby="connexions-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-box-arrow-in-right text-primary me-2"></i>Historique des Connexions
                    </h5>
                    <small class="text-muted">Suivez toutes les connexions des utilisateurs</small>
                </div>
                <button class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-2"></i>Exporter
                </button>
            </div>

            <!-- Filtres Connexions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="GET" action="{{ path('app_super_admin_parametre') }}">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-9">
                                <select name="conn_status" class="form-select">
                                    <option value="">Tous</option>
                                    <option value="success" {{ app.request.query.get('conn_status') == 'success' ? 'selected' : '' }}>Succès</option>
                                    <option value="failed" {{ app.request.query.get('conn_status') == 'failed' ? 'selected' : '' }}>Échec</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-funnel me-1"></i>Filtrer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tableau des connexions -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Date</th>
                                    <th class="py-3">Email</th>
                                    <th class="py-3">Entreprise</th>
                                    <th class="py-3">IP</th>
                                    <th class="py-3 text-center">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for conn in connections %}
                                <tr>
                                    <td class="ps-3">
                                        <span class="fw-semibold">{{ conn.loggedAt|date('d/m/Y') }}</span>
                                        <span class="text-muted small d-block">{{ conn.loggedAt|date('H:i:s') }}</span>
                                    </td>
                                    <td>{{ conn.userEmail ?? 'N/A' }}</td>
                                    <td>{{ conn.companyName ?? 'N/A' }}</td>
                                    <td><code>{{ conn.ipAddress ?? 'N/A' }}</code></td>
                                    <td class="text-center">
                                        <span class="badge bg-{{ conn.level == 'success' ? 'success' : 'danger' }} bg-opacity-10 text-{{ conn.level == 'success' ? 'success' : 'danger' }}">
                                            <i class="bi bi-{{ conn.level == 'success' ? 'check-circle-fill' : 'x-circle-fill' }} me-1"></i>{{ conn.level|capitalize }}
                                        </span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Aucune connexion enregistrée.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage de {{ connections.itemNumberPerPage * (connections.currentPageNumber - 1) + 1 }} à {{ min(connections.itemNumberPerPage * connections.currentPageNumber, connections.totalItemCount) }} sur {{ connections.totalItemCount }} connexions
                    </small>
                    {{ knp_pagination_render(connections) }}
                </div>
            </div>
        </div>

        <!-- TAB 5: ERREURS -->
        <div class="tab-pane fade" id="erreurs" role="tabpanel" aria-labelledby="erreurs-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>Logs Système
                    </h5>
                    <small class="text-muted">Suivez les erreurs et événements système</small>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-download me-2"></i>Exporter
                    </button>
                    <button class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-repeat me-2"></i>Rafraîchir
                    </button>
                </div>
            </div>

            {% if latest_critical %}
            <!-- Alerte dernière erreur critique -->
                <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between" role="alert">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-danger bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-bug text-danger fs-4"></i>
                        </div>
                        <div>
                            <h5 class="alert-heading fw-bold mb-0">Dernière erreur critique</h5>
                            <p class="mb-0 small"><strong>Message :</strong> {{ latest_critical.message }}</p>
                            <p class="mb-0 small text-muted">Fichier : {{ latest_critical.sourceFile }} • {{ latest_critical.loggedAt|date('d/m/Y H:i:s') }}</p>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-danger">Critique</span>
                    </div>
                </div>
            {% endif %}

            <!-- Filtres Erreurs -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="GET" action="{{ path('app_super_admin_parametre') }}">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-5">
                                <div class="position-relative">
                                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                    <input type="text" name="err_search" value="{{ app.request.query.get('err_search') }}" class="form-control ps-5" placeholder="Rechercher...">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <select name="err_level" class="form-select">
                                    <option value="">Tous les niveaux</option>
                                    <option value="critical" {{ app.request.query.get('err_level') == 'critical' ? 'selected' : '' }}>Critique</option>
                                    <option value="error" {{ app.request.query.get('err_level') == 'error' ? 'selected' : '' }}>Erreur</option>
                                    <option value="warning" {{ app.request.query.get('err_level') == 'warning' ? 'selected' : '' }}>Avertissement</option>
                                    <option value="info" {{ app.request.query.get('err_level') == 'info' ? 'selected' : '' }}>Info</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-funnel me-1"></i>Filtrer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tableau des erreurs -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Date</th>
                                    <th class="py-3">Niveau</th>
                                    <th class="py-3">Message</th>
                                    <th class="py-3 pe-3">Fichier</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for err in errors %}
                                    <tr class="{{ err.level == 'critical' ? 'table-danger' : '' }}">
                                        <td class="ps-3">
                                            <span class="fw-semibold">{{ err.loggedAt|date('d/m/Y') }}</span>
                                            <span class="text-muted small d-block">{{ err.loggedAt|date('H:i:s') }}</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-{{ err.level == 'critical' ? 'danger' : (err.level == 'warning' ? 'warning' : 'secondary') }}">
                                                <i class="bi bi-exclamation-circle me-1"></i>{{ err.level|capitalize }}
                                            </span>
                                        </td>
                                        <td>{{ err.message }}</td>
                                        <td class="pe-3">
                                            <code class="small">{{ err.sourceFile ?? 'N/A' }}</code>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Aucun log d'erreur trouvé.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pagination -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage de {{ errors.itemNumberPerPage * (errors.currentPageNumber - 1) + 1 }} à {{ min(errors.itemNumberPerPage * errors.currentPageNumber, errors.totalItemCount) }} sur {{ errors.totalItemCount }} logs
                    </small>
                    {{ knp_pagination_render(errors) }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
        padding: 10px 20px;
    }

    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }

    .nav-tabs .nav-link .badge {
        font-size: 10px;
        padding: 3px 8px;
    }

    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }

    .tab-pane {
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
