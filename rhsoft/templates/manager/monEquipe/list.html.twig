{% extends 'layouts/base_manager.html.twig' %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Mon Equipes
            </h3>
            <p class="text-muted mb-0">
                Gérez équipe et suivez leur activité
            </p>
        </div>
    </div>

    <!-- BARRE DE RECHERCHE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" name="q" class="form-control ps-5" placeholder="Rechercher par nom, prénom, email..." value="{{ app.request.query.get('q') }}">
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">
                        <i class="bi bi-search me-1"></i>Rechercher
                    </button>
                    <a href="{{ path('app_admin_employee') }}" class="btn btn-outline-secondary" title="Réinitialiser">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLEAU PRINCIPAL -->
    <form method="post" action="{{ path('app_admin_employee_bulk_delete') }}" id="bulk-form">
        <input type="hidden" name="_token" value="{{ csrf_token('bulk-delete') }}">

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                <div>
                    <span class="fw-semibold">
                        <i class="bi bi-list-ul text-primary me-2"></i>Liste des employés
                    </span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-borderless mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th style="width: 50px;">Photo</th>
                                <th>{{ knp_pagination_sortable(employees, 'Nom & Prénom', 'u.nom') }}</th>
                                <th>{{ knp_pagination_sortable(employees, 'Email', 'u.email') }}</th>
                                <th>{{ knp_pagination_sortable(employees, 'Statut', 'u.statut') }}</th>
                                <th style="width: 200px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for employee in employees %}
                            <tr>
                                <td>
                                    <span class="text-muted small">#{{ employee.id }}</span>
                                </td>
                                <td>
                                {% if employee.photo %}
                                    <img src="{{ asset('uploads/employees/' ~ employee.photo) }}" width="40" height="40" class="rounded-circle object-fit-cover" style="object-fit:cover;">
                                {% else %}
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;font-size:14px">
                                        {{ employee.prenom|slice(0,1)|upper }}{{ employee.nom|slice(0,1)|upper }}
                                    </div>
                                {% endif %}
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        {{ employee.prenom }} {{ employee.nom }}
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        {{ employee.email }}
                                    </span>
                                </td>
                                <td>
                                {% if employee.isActive %}
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-2">
                                        <i class="bi bi-clock-history me-1"></i>En attente
                                    </span>
                                {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#details-{{ employee.id }}" title="Voir détails">
                                            <i class="bi bi-eye"></i> Voir fiche
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- ACCORDION FICHE RH COMPLETE MODERNISEE -->
                            <tr class="collapse" id="details-{{ employee.id }}">
                                <td colspan="7" class="p-0">
                                    <div class="bg-light p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="fw-bold mb-0">
                                                <i class="bi bi-person-badge text-primary me-2"></i>
                                                Fiche Complète: {{ employee.prenom }} {{ employee.nom }}
                                            </h6>
                                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                                ID: #{{ employee.id }}
                                            </span>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-telephone text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Téléphone</small>
                                                            <span class="fw-semibold">{{ employee.telephone ?? 'Non renseigné' }}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-geo-alt text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Adresse</small>
                                                            <span class="fw-semibold">{{ employee.adresse ?? 'Non renseignée' }}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-calendar3 text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Date Embauche</small>
                                                            <span class="fw-semibold">
                                                                {{ employee.dateEmbauche ? employee.dateEmbauche|date('d/m/Y') : 'N/A' }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-clock-history text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Ancienneté</small>
                                                            <span class="fw-semibold">
                                                                {{ employee.dateEmbauche ? date().diff(employee.dateEmbauche).y ~ ' ans' : 'N/A' }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-calendar-check text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Solde Congé</small>
                                                            <span class="fw-semibold">{{ employee.soldeConge ?? '25' }} jours</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-file-earmark-pdf text-danger"></i>
                                                        <div>
                                                            <small class="text-muted d-block">CV</small>
                                                            {% if employee.cv %}
                                                                <a href="{{ asset('uploads/employees/' ~ employee.cv) }}" target="_blank" class="fw-semibold text-primary text-decoration-none">
                                                                    <i class="bi bi-download me-1"></i>Télécharger PDF
                                                                </a>
                                                            {% else %}
                                                                <span class="text-muted">Non renseigné</span>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="bg-white rounded-3 p-3 shadow-sm">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <div>
                                                            <i class="bi bi-calendar-week text-primary me-2"></i>
                                                            <strong>Planning Semaine {{ "now"|date('W') }}</strong>
                                                            <span class="text-muted small ms-2">({{ "now"|date('d/m/Y') }} - {{ "now"|date_modify("+6 days")|date('d/m/Y') }})</span>
                                                        </div>
                                                        <a href="{{ path('app_admin_planning', {id: employee.id}) }}" class="btn btn-sm btn-outline-success">
                                                            <i class="bi bi-pencil-square me-1"></i>Modifier
                                                        </a>
                                                    </div>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-hover mb-0">
                                                            <thead class="bg-light">
                                                                <tr>
                                                                    <th>Jour</th>
                                                                    <th>Shift</th>
                                                                    <th>Pause</th>
                                                                    <th>Pausette</th>
                                                                    <th>Statut</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>

                                                            {% set days = [
                                                                'lundi',
                                                                'mardi',
                                                                'mercredi',
                                                                'jeudi',
                                                                'vendredi',
                                                                'samedi',
                                                                'dimanche'
                                                            ] %}
                                                            {% set dayOrder = {
                                                                'lundi': 1,
                                                                'mardi': 2,
                                                                'mercredi': 3,
                                                                'jeudi': 4,
                                                                'vendredi': 5,
                                                                'samedi': 6,
                                                                'dimanche': 7
                                                            } %} {# MAP POUR TRIER #}
                                                            {% set monday = "monday this week"|date('Y-m-d') %}
                                                            {% set plannings = employee.plannings|filter(
                                                                p => p.weekStart|date('Y-m-d') == monday
                                                            ) %}

                                                            {% if plannings|length > 0 %}
                                                                {# TRI PAR JOUR AVEC LA MAP #}
                                                            {% set plannings = plannings|sort((a, b) => dayOrder[a.dayOfWeek] <=> dayOrder[b.dayOfWeek]) %}

                                                                {% for p in plannings %}
                                                                <tr class="{{ p.isDayOff ? 'table-warning' : '' }}">
                                                                    <td><span class="fw-semibold">{{ p.dayOfWeek|capitalize }}</span></td>
                                                                    <td>
                                                                        {% if p.isDayOff %}
                                                                            <span class="badge bg-warning-subtle text-warning rounded-pill"><i class="bi bi-calendar-x me-1"></i>Repos</span>
                                                                        {% else %}
                                                                            <span class="text-primary">{{ p.heureDebut|date('H:i') }} - {{ p.heureFin|date('H:i') }}</span>
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ p.pauseMinutes ? p.pauseMinutes ~ ' min' : '-' }}</td>
                                                                    <td>
                                                                        {% if p.isDayOff %}
                                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Repos</span>
                                                                        {% else %}
                                                                            <span class="badge bg-success-subtle text-success rounded-pill">Présent</span>
                                                                        {% endif %}
                                                                    </td>
                                                                </tr>
                                                                {% endfor %}

                                                            {% else %}
                                                                {# DONNEES FACTICES #}
                                                                {% for day in days %}
                                                                <tr>
                                                                    <td><span class="fw-semibold">{{ day|capitalize }}</span></td>
                                                                    <td>
                                                                        {% if day in ['samedi', 'dimanche'] %}
                                                                            <span class="badge bg-warning-subtle text-warning rounded-pill"><i class="bi bi-calendar-x me-1"></i>Repos</span>
                                                                        {% else %}
                                                                            <span class="text-primary">09:00 - 17:00</span>
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ day in ['samedi', 'dimanche'] ? '-' : '60 min' }}</td>
                                                                    <td>
                                                                        {% if day in ['samedi', 'dimanche'] %}
                                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Repos</span>
                                                                        {% else %}
                                                                            <span class="badge bg-success-subtle text-success rounded-pill">Présent</span>
                                                                        {% endif %}
                                                                    </td>
                                                                </tr>
                                                                {% endfor %}
                                                            {% endif %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="py-4">
                                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                            <i class="bi bi-people text-muted fs-1"></i>
                                        </div>
                                        <h5 class="fw-bold">Aucun employé trouvé</h5>
                                        <p class="text-muted small">Commencez par ajouter votre premier employé</p>
                                        <p class="text-muted small mb-0">Contactez votre RH ou administrateur pour ajouter un employé à votre équipe.</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-transparent border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 py-3">
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    {{ employees.getTotalItemCount }} employés au total
                </div>
                <div>
                    {{ knp_pagination_render(employees) }}
                </div>
            </div>
        </div>
    </form>
</div>

<!-- MODAL DE CONFIRMATION MODERNISE -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="bg-danger-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-trash3 text-danger fs-2"></i>
                </div>
                <p class="fw-semibold mb-0">Êtes-vous sûr de vouloir supprimer le/les employé(s) sélectionné(s) ?</p>
                <p class="text-muted small">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" form="bulk-form" class="btn btn-danger px-4">
                    <i class="bi bi-trash3 me-1"></i>Oui, Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPTS -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Select All
    const selectAll = document.getElementById('selectAll');
    const rowCheckboxes = document.querySelectorAll('.rowCheckbox');
    const btnBulkDelete = document.getElementById('btnBulkDelete');

    if (selectAll) {
        selectAll.addEventListener('change', function() {
            rowCheckboxes.forEach(cb => cb.checked = this.checked);
            updateBulkButton();
        });
    }

    rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateBulkButton);
    });

    function updateBulkButton() {
        const checked = document.querySelectorAll('.rowCheckbox:checked').length;
        btnBulkDelete.disabled = checked === 0;
    }

    // Initial state
    updateBulkButton();

    // Collapse toggle - change icon on button
    document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(btn => {
        btn.addEventListener('click', function() {
            const icon = this.querySelector('.bi-eye, .bi-eye-slash');
            if (icon) {
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            }
        });
    });

    // Modal delete - single employee
    const confirmDeleteModal = document.getElementById('confirmDeleteModal');
    if (confirmDeleteModal) {
        confirmDeleteModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            if (button && button.getAttribute('data-id')) {
                // Single delete - we need to submit the form with the specific ID
                const employeeId = button.getAttribute('data-id');
                this.querySelector('.modal-footer .btn-danger').addEventListener('click', function(e) {
                    e.preventDefault();
                    const form = document.getElementById('bulk-form');
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'ids[]';
                    input.value = employeeId;
                    form.appendChild(input);
                    form.submit();
                });
            } else {
                // Bulk delete - form already handles it
                this.querySelector('.modal-footer .btn-danger').onclick = function() {
                    document.getElementById('bulk-form').submit();
                };
            }
        });
    }
});
</script>
{% endblock %}
