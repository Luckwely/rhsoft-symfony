{% extends 'layouts/base_manager.html.twig' %}

{% block title %}Mon Profil - Solde CP{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Mon Profil
            </h3>
            <p class="text-muted mb-0">
                Gérez vos informations et documents
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; font-size: 16px;">
                {{ user.prenom|first }}{{ user.nom|first }}
            </div>
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-semibold">{{ user.prenom }} {{ user.nom }}</span>
                <small class="text-muted">{{ user.poste ?? 'Manager' }}</small>
            </div>
        </div>
    </div>

    <!-- NAVIGATION PAR LIENS (SANS JS) -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link active border-0 rounded-3 px-4" href="{{ path('app_manager_profile_solde') }}">
                <i class="bi bi-calendar-check text-white me-2"></i>Mon solde congé
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link border-0 rounded-3 px-4 text-secondary" href="{{ path('app_manager_profile_paie') }}">
                <i class="bi bi-file-earmark-text text-success me-2"></i>Mes fiches de paie
            </a>
        </li>
    </ul>

    <!-- CONTENU UNIQUE: MON SOLDE CONGÉ -->
    <div>
        <!-- CARDS SOLDE (Dynamiques) -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Solde CP</span>
                                <h2 class="fw-bold mb-0 mt-1 text-primary">{{ user.soldeCp ?? 0 }}</h2>
                                <small class="text-muted">Jours restants</small>
                            </div>
                            <div class="bg-primary-subtle rounded-3 p-3">
                                <i class="bi bi-umbrella text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Solde RTT</span>
                                <h2 class="fw-bold mb-0 mt-1 text-info">{{ user.soldeRtt ?? 0 }}</h2>
                                <small class="text-muted">Jours restants</small>
                            </div>
                            <div class="bg-info-subtle rounded-3 p-3">
                                <i class="bi bi-clock text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Pris</span>
                                <h2 class="fw-bold mb-0 mt-1 text-warning">{{ user.joursPris ?? 0 }}</h2>
                                <small class="text-muted">Jours utilisés</small>
                            </div>
                            <div class="bg-warning-subtle rounded-3 p-3">
                                <i class="bi bi-calendar-check text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLEAU HISTORIQUE CONGÉS (Dynamique avec boucle) -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>Historique des congés pris
                </h5>
                <a href="{{ path('app_manager_conge_new') }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Demander un congé
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-borderless mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3 py-3">Type</th>
                                <th class="py-3">Période</th>
                                <th class="py-3 text-center">Durée</th>
                                <th class="py-3 text-center pe-3">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for conge in conges %}
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-umbrella me-1"></i>{{ conge.motif }}
                                        </span>
                                    </td>
                                    <td>{{ conge.dateDebut|date('d/m/Y') }} au {{ conge.dateFin|date('d/m/Y') }}</td>
                                    <td class="text-center"><span class="fw-semibold">{{ conge.duree }} jours</span></td>
                                    <td class="text-center pe-3">
                                        {% if conge.statut == 'Approuvé' %}
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                            </span>
                                        {% elseif conge.statut == 'Refusé' %}
                                            <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                                <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                            </span>
                                        {% else %}
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                                <i class="bi bi-clock me-1"></i>En attente
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Aucune demande de congé enregistrée.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>{{ conges|length }} demande(s) trouvée(s)
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link { color: #6c757d; font-weight: 500; transition: all 0.3s ease; }
    .nav-tabs .nav-link:hover { background-color: #f8f9fa; color: #0d6efd; }
    .nav-tabs .nav-link.active { background-color: #0d6efd; color: #ffffff; box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3); }
</style>
{% endblock %}
