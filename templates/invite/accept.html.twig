{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Activer votre compte{% endblock %}

{% block body %}
<div class="bg-light min-vh-100 d-flex align-items-center py-5">
    <div class="container">
        <!-- Flash Messages -->
        <div>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="row g-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Left Column - Image/Illustration -->
            <div class="col-lg-6 d-none d-lg-flex bg-primary bg-gradient align-items-center justify-content-center p-5">
                <div class="text-center text-white">
                    <div class="mb-4">
                        <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="8" cy="7" r="4"/>
                            <path d="M12 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <h2 class="display-5 fw-bold mb-3">Bienvenue {{ user.prenom }} !</h2>
                    <p class="lead opacity-75">Définissez votre mot de passe pour <strong>{{ user.entreprise.nom }}</strong></p>
                    <div class="mt-4">
                        <span class="badge bg-light text-primary me-2 px-3 py-2">Sécurisé</span>
                        <span class="badge bg-light text-primary me-2 px-3 py-2">Rapide</span>
                        <span class="badge bg-light text-primary px-3 py-2">Facile</span>
                    </div>
                </div>
            </div>

            <!-- Right Column - Activation Form -->
            <div class="col-lg-6 bg-white p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold text-primary">Activer votre compte</h1>
                    <p class="text-muted">{{ user.prenom }}, définissez votre mot de passe pour {{ user.entreprise.nom }}</p>
                </div>

                <form method="post" class="needs-validation" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="password" class="form-label fw-semibold">Nouveau mot de passe</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                                        </svg>
                                    </span>
                                    <input type="password" name="password" id="password" class="form-control form-control-lg border-start-0" placeholder="Minimum 8 caractères" required minlength="8">
                                </div>
                                <div class="invalid-feedback">Veuillez saisir un mot de passe d'au moins 8 caractères</div>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>Minimum 8 caractères
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <label for="password_confirm" class="form-label fw-semibold">Confirmer mot de passe</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                                            <polyline points="21 3 15 9 21 15"/>
                                        </svg>
                                    </span>
                                    <input type="password" name="password_confirm" id="password_confirm" class="form-control form-control-lg border-start-0" placeholder="Confirmez votre mot de passe" required minlength="8">
                                </div>
                                <div class="invalid-feedback">Veuillez confirmer votre mot de passe</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold">
                                <svg class="me-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                    <path d="M12 7v4"/>
                                    <path d="M14 11h-4"/>
                                </svg>
                                Activer mon compte
                            </button>
                        </div>

                        <div class="col-12">
                            <hr class="my-2">
                            <div class="text-center">
                                <p class="text-muted small mb-0">
                                    <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                    Compte sécurisé - {{ user.entreprise.nom }}
                                </p>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
