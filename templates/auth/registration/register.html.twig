{% extends "layouts/auth-layout.html.twig" %}

{% block title %}Register{% endblock %}

{% block body %}

        <div class="container">
            <!-- Flash Messages -->
            <div>
                {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ flash_error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                {% endfor %}
                {% for message in app.flashes('danger') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            </div>

            <div class="row g-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Left Column - Image/Illustration -->
                <div class="col-lg-6 d-none d-lg-flex bg-primary bg-gradient align-items-center justify-content-center p-5">
                    <div class="text-center text-white">
                        <a href="{{ path('app_home')}}">
                            <img src="../uploads/home/logo.png" alt="Logo RH Soft Pro" width="220" height="220" style="object-fit: contain;">
                        </a>
                        <h2 class="display-5 fw-bold mb-3">Bienvenue</h2>
                        <p class="lead opacity-75">Créez votre compte et rejoignez notre communauté d'entreprises innovantes</p>
                    </div>
                </div>

                <!-- Right Column - Registration Form -->
                <div class="col-lg-6 bg-white p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold text-primary">Inscription</h1>
                        <p class="text-muted">Remplissez le formulaire ci-dessous pour créer votre compte</p>
                    </div>

                    {{ form_start(registrationForm, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.nom) }}
                                    {{ form_widget(registrationForm.nom) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.nom) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.prenom) }}
                                    {{ form_widget(registrationForm.prenom) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.prenom) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.nom_entreprise) }}
                                    {{ form_widget(registrationForm.nom_entreprise) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.nom_entreprise) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.nif_entreprise) }}
                                    {{ form_widget(registrationForm.nif_entreprise) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.nif_entreprise) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.email) }}
                                    {{ form_widget(registrationForm.email) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.email) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.tel_entreprise) }}
                                    {{ form_widget(registrationForm.tel_entreprise) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.tel_entreprise) }}</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    {{ form_label(registrationForm.adresse_entreprise) }}
                                    {{ form_widget(registrationForm.adresse_entreprise) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.adresse_entreprise) }}</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group">
                                    {{ form_label(registrationForm.logo_entreprise) }}
                                    {{ form_widget(registrationForm.logo_entreprise) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.logo_entreprise) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.plainPassword.first) }}
                                    {{ form_widget(registrationForm.plainPassword.first) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.plainPassword.first) }}</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.plainPassword.second) }}
                                    {{ form_widget(registrationForm.plainPassword.second) }}
                                    <span class="text-danger small">{{ form_errors(registrationForm.plainPassword.second) }}</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    {{ form_widget(registrationForm.agreeTerms) }}
                                    {{ form_label(registrationForm.agreeTerms) }}
                                    <span class="text-danger small d-block">{{ form_errors(registrationForm.agreeTerms) }}</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold">
                                    <i class="bi bi-person-plus me-2"></i>Register
                                </button>
                            </div>

                            <div class="col-12 text-center">
                                <p class="text-muted mt-2">Vous avez déjà un compte ? <a href="{{ path('app_login') }}" class="text-primary fw-semibold">Connectez-vous</a></p>
                            </div>
                        </div>
                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>

{% endblock %}
