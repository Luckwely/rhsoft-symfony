{% extends "layouts/auth-layout.html.twig" %}

{% block title %}Register{% endblock %}

{% block body %}
   <div class="bg-light min-vh-100 d-flex align-items-center py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8 col-12">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                        <!-- Card Header with Gradient -->
                        <div class="card-header bg-primary bg-gradient text-white text-center py-4 border-0">
                            <div class="mb-3">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 4L12 14L2 4"/>
                                    <path d="M2 8L12 18L22 8"/>
                                    <path d="M22 8v10a2 2 0 01-2 2H4a2 2 0 01-2-2V8"/>
                                </svg>
                            </div>
                            <h1 class="h3 fw-bold mb-0">Vérifier votre email</h1>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 p-md-5">
                            <div class="text-center mb-4">
                                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#198754" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                                        <polyline points="22 4 12 14.01 9 11.01"/>
                                    </svg>
                                </div>
                                <p class="text-muted mb-0">Nous avons envoyé un email de confirmation à</p>
                                <p class="fw-bold text-primary fs-5 mb-0">{{ user.email }}</p>
                            </div>

                            <div class="alert alert-info border-0 rounded-3 d-flex align-items-start" role="alert">
                                <svg class="flex-shrink-0 me-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="16" x2="12" y2="12"/>
                                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                                </svg>
                                <div>
                                    <strong>Instructions :</strong>
                                    <p class="mb-0">Cliquez sur le lien dans l'email pour activer votre compte Rhsoft</p>
                                </div>
                            </div>

                            <div class="bg-light rounded-3 p-3 mb-4">
                                <div class="d-flex align-items-center justify-content-between flex-wrap">
                                    <span class="text-muted small">
                                        <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"/>
                                            <polyline points="12 6 12 12 16 14"/>
                                        </svg>
                                        Lien valide 24h
                                    </span>
                                    <span class="text-muted small">
                                        <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                        Sécurisé
                                    </span>
                                </div>
                            </div>

                            <div class="text-center">
                                <p class="text-muted mb-3">Vous n'avez rien reçu ?</p>
                                <div class="d-grid gap-2">
                                    <button class="btn btn-outline-secondary" onclick="window.location.reload();">
                                        <svg class="me-2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="23 4 23 10 17 10"/>
                                            <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
                                        </svg>
                                        Renvoyer l'email
                                    </button>
                                    <a href="{{ path("app_register") }}" class="btn btn-link text-primary">
                                        <svg class="me-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="19" y1="12" x2="5" y2="12"/>
                                            <polyline points="12 19 5 12 12 5"/>
                                        </svg>
                                        Réessayer avec une autre adresse
                                    </a>
                                </div>
                            </div>

                            <hr class="my-4">

                            <div class="text-center">
                                <p class="text-muted small mb-0">
                                    <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                    Vérifiez vos spams si l'email n'apparaît pas dans votre boîte de réception
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Link -->
                    <div class="text-center mt-4">
                        <a href="#" class="text-decoration-none text-muted small">
                            <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
                            </svg>
                            Besoin d'aide ? Contactez le support
                        </a>
                    </div>
                </div>
            </div>
        </div>
   </div>
{% endblock %}
