{% extends "layouts/auth-layout.html.twig" %}

{% block title %}Connexion{% endblock %}

{% block body %}

<div class="container">
    <!-- Flash Messages -->
    <div>
        {% if error %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% if app.user %}
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>
                <a href="{{ logout_path() }}" class="alert-link ms-2">Se déconnecter</a>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}
    </div>

    <div class="row g-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Left Column - Image/Illustration -->
        <div class="col-lg-6 d-none d-lg-flex bg-primary bg-gradient align-items-center justify-content-center p-5">
            <div class="text-center text-white">
                <a href="{{ path('app_home')}}">
                    <img src="../uploads/home/logo.png" alt="Logo RH Soft Pro" width="220" height="220" style="object-fit: contain;">
                </a>
                <h2 class="display-5 fw-bold mb-3">Heureux de vous revoir</h2>
                <p class="lead opacity-75">Connectez-vous pour accéder à votre espace personnel et gérer vos activités</p>
            </div>
        </div>

        <!-- Right Column - Login Form -->
        <div class="col-lg-6 bg-white p-4 p-md-5">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold text-primary">Connexion</h1>
                <p class="text-muted">Connectez-vous à votre compte Rhsoft</p>
            </div>

            <form method="post" class="needs-validation" novalidate>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="email" class="form-label fw-semibold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                </span>
                                <input type="email" value="{{ last_username }}" name="email" id="email" class="form-control form-control-lg border-start-0" placeholder="exemple@email.com" autocomplete="email" autofocus required>
                            </div>
                            <div class="invalid-feedback">Veuillez saisir votre adresse email</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            <label for="password" class="form-label fw-semibold">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0110 0v4"/>
                                    </svg>
                                </span>
                                <input type="password" name="password" id="password" class="form-control form-control-lg border-start-0" placeholder="Votre mot de passe" autocomplete="current-password" required>
                            </div>
                            <div class="invalid-feedback">Veuillez saisir votre mot de passe</div>
                            {#<div class="text-end mt-2">
                                <a href="#" class="text-decoration-none small text-primary">Mot de passe oublié ?</a>
                            </div>#}
                        </div>
                    </div>

                    <div class="col-12">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    </div>

                    {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html
                    #}
                    {#
                    <div class="col-12">
                        <div class="form-check">
                            <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                            <label for="_remember_me" class="form-check-label">Se souvenir de moi</label>
                        </div>
                    </div>
                    #}

                    <div class="col-12">
                        <button class="btn btn-primary btn-lg w-100 py-3 fw-bold" type="submit">
                            <svg class="me-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/>
                                <polyline points="10 17 15 12 10 7"/>
                                <line x1="15" y1="12" x2="3" y2="12"/>
                            </svg>
                            Se connecter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}
