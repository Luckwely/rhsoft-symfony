{% extends 'layouts/base_admin.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <h3 class="mb-0">Modifier Employé: {{ employee.prenom }} {{ employee.nom }}</h3>
            <a href="{{ path('app_employee_list') }}" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
            <div class="row">
                {# PRÉNOM #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.prenom, 'Prénom *') }}
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control' ~ (form.prenom.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.prenom) }}
                </div>
                {# NOM #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.nom, 'Nom *') }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control' ~ (form.nom.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.nom) }}
                </div>
                {# EMAIL #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.email, 'Email *') }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control' ~ (form.email.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.email) }}
                </div>
                {# TELEPHONE #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.telephone, 'Téléphone') }}
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control'}}) }}
                </div>
                {# ADRESSE #}
                <div class="col-12 mb-3">
                    {{ form_label(form.adresse, 'Adresse') }}
                    {{ form_widget(form.adresse, {'attr': {'class': 'form-control', 'rows': 2}}) }}
                </div>
                {# DATE EMBAUCHE + SOLDE #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.dateEmbauche, 'Date Embauche') }}
                    {{ form_widget(form.dateEmbauche, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.soldeConge, 'Solde Congé') }}
                    {{ form_widget(form.soldeConge, {'attr': {'class': 'form-control'}}) }}
                </div>
                {# PHOTO #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.photo, 'Nouvelle Photo') }}
                    {% if employee.photo %}
                        <div class="mb-2">
                            <img src="{{ asset('uploads/employees/' ~ employee.photo) }}" width="80" class="rounded">
                        </div>
                    {% endif %}
                    {{ form_widget(form.photo, {'attr': {'class': 'form-control'}}) }}
                </div>
                {# CV #}
                <div class="col-md-6 mb-3">
                    {{ form_label(form.cv, 'Nouveau CV PDF') }}
                    {% if employee.cv %}
                        <div class="mb-2">
                            <a href="{{ asset('uploads/employees/' ~ employee.cv) }}" target="_blank">CV Actuel</a>
                        </div>
                    {% endif %}
                    {{ form_widget(form.cv, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>

            {{ form_rest(form) }}
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Mettre à jour
                </button>
                <a href="{{ path('app_employee_list') }}" class="btn btn-secondary">Annuler</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
