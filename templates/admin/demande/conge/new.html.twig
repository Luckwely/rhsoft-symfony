{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Nouvelle demande de congé{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Nouvelle demande de congé</h3>
            <p class="text-muted mb-0">
                Créez une demande de congé pour un employé
            </p>
        </div>
        <a href="{{ path('app_admin_conge') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour à la liste
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.employee, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.employee) }}
                        {{ form_errors(form.employee) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.typeConge, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.typeConge) }}
                        {{ form_errors(form.typeConge) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.dateDebut) }}
                        {{ form_errors(form.dateDebut) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.dateFin) }}
                        {{ form_errors(form.dateFin) }}
                    </div>
                    <div class="col-12 mb-3">
                        {{ form_label(form.motif, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.motif) }}
                        {{ form_errors(form.motif) }}
                    </div>
                </div>

                {{ form_rest(form) }}

                <div class="d-flex gap-2 justify-content-end">
                    <a href="{{ path('app_admin_conge') }}" class="btn btn-outline-secondary px-4">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2 me-1"></i>Créer la demande
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
