{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Gestion des Démissions{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- 1. HEADER STICKY -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Gestion des Démissions
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-clock-history me-1"></i>Traitez les démissions de vos employées
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0 flex-wrap">
            <a href="{{ path('app_admin_demission_new') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus me-1"></i>Nouvelle démission
            </a>
        </div>
    </div>

    <!-- 2. FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- 3. TABS NAVIGATION -->
    <ul class="nav nav-tabs border-0 gap-2 mb-3" id="congeTabs">
        <li class="nav-item" role="presentation">
            <a href="{{ path('app_admin_conge') }}" class="nav-link border-0 rounded-3 px-4" id="pending-tab">
                <i class="bi bi-hourglass-split me-1"></i>Congés
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_demission_list') }}" class="nav-link active border-0 rounded-3 px-4" id="calendar-tab">
                <i class="bi bi-calendar3 me-1"></i>Démissions
                <span class="badge bg-white text-primary ms-1">{{ demissions.getTotalItemCount }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_demandes_avance') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-coin me-1"></i>Avances sur salaire
            </a>
        </li>
    </ul>

    <!-- TABS CONTENT -->
    <div class="tab-content" id="congeTabsContent">

        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light sticky-top" style="top: 0; z-index: 10;">
                        <tr>
                            <th class="ps-3 py-3" style="width: 50px;">#</th>
                            <th class="py-3">Employé</th>
                            <th class="py-3">Date de la demande</th>
                            <th class="py-3">Date de départ</th>
                            <th class="py-3 text-center">Statut</th>
                            <th class="py-3 text-center pe-3" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for demission in demissions %}
                        <!-- 1. MAIN ROW -->
                        <tr>
                            <td class="ps-3"><span class="text-muted small">{{ loop.index }}</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                        {{ demission.employee.prenom|default('U')|slice(0, 1) }}{{ demission.employee.nom|default('')|slice(0, 1) }}
                                    </div>
                                    <div>
                                        <div class="fw-semibold">{{ demission.employee.prenom }} {{ demission.employee.nom }}</div>
                                        <div class="text-muted small">{{ demission.employee.email }}</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="fw-semibold">{{ demission.dateDemande ? demission.dateDemande|date('d/m/Y') : 'N/A' }}</span></td>
                            <td><span class="fw-semibold">{{ demission.dateDepart ? demission.dateDepart|date('d/m/Y') : 'N/A' }}</span></td>
                            <td class="text-center">
                                {% if demission.statut == 'en_attente' %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif demission.statut == 'validee' %}
                                    <span class="badge bg-success">Validée</span>
                                {% else %}
                                    <span class="badge bg-danger">Refusée</span>
                                {% endif %}
                            </td>
                            <td class="text-center pe-3">
                                <div class="d-flex gap-1 justify-content-center">
                                    {% if demission.statut == 'en_attente' %}
                                        <form action="{{ path('app_admin_demission_valider', {'id': demission.id}) }}" method="POST" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('demission_action_' ~ demission.id) }}">
                                            <button type="submit" class="btn btn-success btn-sm" title="Valider">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        </form>
                                        <form action="{{ path('app_admin_demission_refuser', {'id': demission.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Confirmer le refus de cette démission ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('demission_action_' ~ demission.id) }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Refuser">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                    <!-- Accordion Toggle Button -->
                                    <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDemission-{{ demission.id }}" aria-expanded="false" title="Détails / Motif">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- 2. ACCORDION DROP-DOWN ROW -->
                        <tr>
                            <td colspan="6" class="p-0 border-0">
                                <div class="collapse bg-light p-3 border-bottom" id="collapseDemission-{{ demission.id }}">
                                    <div class="card card-body border-0 shadow-sm rounded-3">
                                        <h6 class="fw-bold text-primary mb-2">
                                            <i class="bi bi-info-circle me-1"></i>Informations complémentaires & Motif
                                        </h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p class="mb-1 text-muted small"><strong>Entreprise :</strong> {{ demission.entreprise.nom|default('N/A') }}</p>
                                                {% if demission.validePar %}
                                                    <p class="mb-0 text-muted small"><strong>Traité par :</strong> {{ demission.validePar.prenom }} {{ demission.validePar.nom }} le {{ demission.valideLe|date('d/m/Y à H:i') }}</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-md-6">
                                                <p class="mb-1 text-muted small"><strong>Motif fourni par l'employé :</strong></p>
                                                <div class="p-2 bg-white rounded border text-dark">
                                                    {{ demission.motif ? demission.motif|nl2br : '<em class="text-muted">Aucun motif spécifié.</em>' }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Aucune démission trouvée pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Total : {{ demissions.getTotalItemCount }} demande(s)
                    </small>
                    {% if demissions.pageCount > 1 %}{{ knp_pagination_render(demissions) }}{% endif %}
                </div>
        </div>

    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
