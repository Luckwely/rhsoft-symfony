{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Gestion des Avances sur salaire{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Gestion des Avances sur salaire
            </h3>
            <p class="text-muted mb-0">
                Filet de sécurité : traite notamment les demandes du RH lui-même, qu'il ne peut pas s'auto-approuver
            </p>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- TABS NAVIGATION -->
    <ul class="nav nav-tabs border-0 gap-2 mb-3">
        <li class="nav-item">
            <a href="{{ path('app_admin_conge') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-hourglass-split me-1"></i>Congés
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_demission_list') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-calendar3 me-1"></i>Démissions
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_demandes_avance') }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-coin me-1"></i>Avances sur salaire
                <span class="badge bg-white text-primary ms-1">{{ demandes|length }}</span>
            </a>
        </li>
    </ul>

    <!-- STATS AVANCES -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <span class="text-muted small">Total approuvé ce mois</span>
                    <div class="fs-3 fw-bold text-primary">{{ stats.total|number_format(0, ',', ' ') }} Ar</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <span class="text-muted small">En attente</span>
                    <div class="fs-3 fw-bold text-warning">{{ stats.nbEnAttente }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <span class="text-muted small">Montant moyen</span>
                    <div class="fs-3 fw-bold">{{ stats.moyenne|number_format(0, ',', ' ') }} Ar</div>
                </div>
            </div>
        </div>
    </div>

    <!-- AVANCES APPROUVÉES EN ATTENTE DE VERSEMENT -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-transparent border-0">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-cash-coin text-success me-2"></i>Approuvées, en attente de versement
            </h5>
            <small class="text-muted">Ces avances ont été approuvées mais l'argent n'a pas encore été transféré à l'employé</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Employé</th>
                            <th class="py-3 text-end">Montant</th>
                            <th class="py-3">Approuvée le</th>
                            <th class="py-3 text-center pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for avance in aVerser %}
                        <tr>
                            <td class="ps-3">
                                <div class="fw-semibold">{{ avance.employee.nom }} {{ avance.employee.prenom }}</div>
                            </td>
                            <td class="text-end fw-bold">{{ avance.montant|number_format(0, ',', ' ') }} Ar</td>
                            <td>{{ avance.dateDemande|date('d/m/Y') }}</td>
                            <td class="text-center pe-3">
                                    <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#payerAvance{{ avance.id }}">
                                    <i class="bi bi-send-check me-1"></i>Marquer versée
                                </button>
                            </td>
                        </tr>

                        <div class="modal fade" id="payerAvance{{ avance.id }}" tabindex="-1">
                            <div class="modal-dialog">
                                <form method="post" action="{{ path('app_admin_avance_marquer_paye', {id: avance.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_avance_payer_' ~ avance.id) }}">
                                    <div class="modal-content">
                                        <div class="modal-header"><h5>Confirmer le versement de l'avance</h5></div>
                                        <div class="modal-body">
                                            <p>Montant à verser à {{ avance.employee.nom }} {{ avance.employee.prenom }} : <strong>{{ avance.montant|number_format(0, ',', ' ') }} Ar</strong></p>
                                            <div class="mb-3">
                                                <label class="form-label">Mode de paiement</label>
                                                <select name="mode_paiement" class="form-select" required>
                                                    <option value="" disabled selected>Sélectionner...</option>
                                                    {% for label, value in modesPaiement %}
                                                        <option value="{{ value }}">{{ label }}</option>
                                                    {% endfor %}
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Référence (n° virement, transaction...)</label>
                                                <input type="text" name="reference_paiement" class="form-control" placeholder="Optionnel">
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                            <button type="submit" class="btn btn-success">Confirmer le versement</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        {% else %}
                        <tr><td colspan="4" class="text-center py-4">Aucune avance en attente de versement</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if aVerser.pageCount > 1 %}
        <div class="card-footer bg-transparent border-0">{{ knp_pagination_render(aVerser) }}</div>
        {% endif %}
    </div>

    <!-- TABLEAU AVANCES -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-coin text-info me-2"></i>Demandes en attente
            </h5>
            <small class="text-muted">{{ demandes|length }} demande(s) à traiter</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Employé</th>
                            <th class="py-3 text-end">Montant</th>
                            <th class="py-3">Motif</th>
                            <th class="py-3">Date demande</th>
                            <th class="py-3 text-center">Statut</th>
                            <th class="py-3 text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                   <tbody>
                        {% for avance in demandes %}
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                        {{ avance.employee.prenom|first }}{{ avance.employee.nom|first }}
                                    </div>
                                    <div>
                                        <div class="fw-semibold">{{ avance.employee.nom }} {{ avance.employee.prenom }}</div>
                                        <small class="text-muted">{{ avance.employee.poste ?? 'N/A' }}</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-end fw-bold">{{ avance.montant|number_format(0, ',', ' ') }} Ar</td>
                            <td>{{ avance.motif }}</td>
                            <td>{{ avance.dateDemande|date('d/m/Y') }}</td>
                            <td class="text-center">
                                <span class="badge bg-warning-subtle text-warning rounded-pill">
                                    <i class="bi bi-clock-history me-1"></i>En attente
                                </span>
                            </td>
                            <td class="text-center pe-3">
                                <form method="post" action="{{ path('app_admin_avance_approuver', {id: avance.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_avance_approuver_' ~ avance.id) }}">
                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Approuver</button>
                                </form>
                                <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#refusAvance{{ avance.id }}">
                                    <i class="bi bi-x-lg me-1"></i>Rejeter
                                </button>
                            </td>
                        </tr>

                        <!-- Modal Rejet -->
                        <div class="modal fade" id="refusAvance{{ avance.id }}" tabindex="-1">
                        <div class="modal-dialog">
                            <form method="post" action="{{ path('app_admin_avance_rejeter', {id: avance.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_avance_rejeter_' ~ avance.id) }}">
                            <div class="modal-content">
                                <div class="modal-header"><h5>Rejeter la demande d'avance</h5></div>
                                <div class="modal-body">
                                <textarea name="motif" class="form-control" placeholder="Motif du rejet...">{{ avance.motif }}</textarea>
                                </div>
                                <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-danger">Confirmer le rejet</button>
                                </div>
                            </div>
                            </form>
                        </div>
                        </div>
                        {% else %}
                        <tr><td colspan="6" class="text-center py-4">Aucune demande d'avance</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>{{ demandes.getTotalItemCount }} demande(s) en attente de validation
            </small>
            {% if demandes.pageCount > 1 %}{{ knp_pagination_render(demandes) }}{% endif %}
        </div>
    </div>
</div>
{% endblock %}
