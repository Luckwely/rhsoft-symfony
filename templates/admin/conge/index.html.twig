

{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Gestion des Congés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- 1. HEADER STICKY -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Gestion des Congés
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-clock-history me-1"></i>Traitez les demandes de vos équipes
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0 flex-wrap">
            <button class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter
            </button>
        </div>
    </div>

    <!-- 2. FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- 3. TABS NAVIGATION -->
    <ul class="nav nav-tabs border-0 gap-2 mb-3" id="congeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                <i class="bi bi-hourglass-split me-1"></i>Toutes les Demandes / En Attente
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar" type="button" role="tab">
                <i class="bi bi-calendar3 me-1"></i>Calendrier
            </button>
        </li>
    </ul>

    <!-- TABS CONTENT -->
    <div class="tab-content" id="congeTabsContent">

        <!-- TAB 1: LISTE DES CONGÉS (DYNAMIQUE) -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-borderless mb-0">
                        <thead class="bg-light sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th class="ps-3 py-3" style="width: 50px;">#</th>
                                <th class="py-3">Employé</th>
                                <th class="py-3">Type</th>
                                <th class="py-3">Période</th>
                                <th class="py-3 text-center">Durée</th>
                                <th class="py-3 text-center">Statut</th>
                                <th class="py-3 text-center pe-3" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for conge in conges %}
                            <!-- 1. MAIN ROW -->
                            <tr>
                                <td class="ps-3"><span class="text-muted small">{{ loop.index }}</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                            {{ conge.employee.prenom|default('U')|slice(0, 1) }}{{ conge.employee.nom|default('')|slice(0, 1) }}
                                        </div>
                                        <div>
                                            <div class="fw-semibold">{{ conge.employee.prenom }} {{ conge.employee.nom }}</div>
                                            <div class="text-muted small">{{ conge.employee.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                        <i class="bi bi-umbrella me-1"></i>{{ conge.typeConge.libelle|default('Congé') }}
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold">{{ conge.dateDebut|date('d/m/Y') }}</span>
                                    <span class="text-muted mx-1">→</span>
                                    <span class="fw-semibold">{{ conge.dateFin|date('d/m/Y') }}</span>
                                </td>
                                <td class="text-center"><span class="fw-semibold">{{ conge.nbJours }} jours</span></td>
                                <td class="text-center">
                                    {% if conge.statut == 'demande' %}
                                        <span class="badge bg-warning text-dark">En attente</span>
                                    {% elseif conge.statut == 'valide' %}
                                        <span class="badge bg-success">Validé</span>
                                    {% else %}
                                        <span class="badge bg-danger">Refusé</span>
                                    {% endif %}
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex gap-1 justify-content-center">
                                        {% if conge.statut == 'demande' %}
                                            <form action="{{ path('app_admin_conge_valider', {'id': conge.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm" title="Valider">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            </form>
                                            <form action="{{ path('app_admin_conge_refuser', {'id': conge.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Refuser">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                        <!-- Accordion Toggle Button -->
                                        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseConge-{{ conge.id }}" aria-expanded="false" title="Détails / Motif">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- 2. ACCORDION DROP-DOWN ROW -->
                            <tr>
                                <td colspan="7" class="p-0 border-0">
                                    <div class="collapse bg-light p-3 border-bottom" id="collapseConge-{{ conge.id }}">
                                        <div class="card card-body border-0 shadow-sm rounded-3">
                                            <h6 class="fw-bold text-primary mb-2">
                                                <i class="bi bi-info-circle me-1"></i>Informations complémentaires & Motif
                                            </h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <p class="mb-1 text-muted small"><strong>Date de soumission :</strong> {{ conge.createdAt|date('d/m/Y à H:i') }}</p>
                                                    <p class="mb-0 text-muted small"><strong>Entreprise :</strong> {{ conge.entreprise.nom|default('N/A') }}</p>
                                                </div>
                                                <div class="col-md-6">
                                                    <p class="mb-1 text-muted small"><strong>Motif fourni par l'employé :</strong></p>
                                                    <div class="p-2 bg-white rounded border text-dark">
                                                        {{ conge.motif ? conge.motif|nl2br : '<em class="text-muted">Aucun motif spécifié.</em>' }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Aucune demande de congé trouvée pour le moment.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    </table>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Total : {{ conges|length }} demande(s)
                    </small>
                </div>
            </div>
        </div>

        <!-- TAB 2: CALENDRIER (Placeholder structural keep) -->
        <div class="tab-pane fade" id="calendar" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <h5 class="fw-bold mb-3"><i class="bi bi-calendar3 text-primary me-2"></i>Vue Calendrier Global</h5>
                <p class="text-muted">Le module calendrier complet de l'entreprise s'affichera ici.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}



