{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Gestion des Congés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- 1. HEADER STICKY -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Gestion des Congés
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-clock-history me-1"></i>Traitez les demandes de vos équipes
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0 flex-wrap">
            <button class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter
            </button>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newCongeModal">
                <i class="bi bi-plus-lg me-1"></i>Nouvelle Demande
            </button>
        </div>
    </div>

    <!-- 2. CARDS STATS 4 COLONNES -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">En Attente</span>
                            <h2 class="fw-bold mb-0 mt-1">8</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-hourglass-split text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Approuvées</span>
                            <h2 class="fw-bold mb-0 mt-1">24</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Refusées</span>
                            <h2 class="fw-bold mb-0 mt-1">3</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. TABS NAVIGATION -->
    <ul class="nav nav-tabs border-0 gap-2 mb-3" id="congeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                <i class="bi bi-hourglass-split me-1"></i>En Attente
                <span class="badge bg-warning ms-1">8</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                <i class="bi bi-check-circle me-1"></i>Approuvées
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4" id="refused-tab" data-bs-toggle="tab" data-bs-target="#refused" type="button" role="tab">
                <i class="bi bi-x-circle me-1"></i>Refusées
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar" type="button" role="tab">
                <i class="bi bi-calendar3 me-1"></i>Calendrier
            </button>
        </li>
    </ul>

    <!-- TABS CONTENT -->
    <div class="tab-content" id="congeTabsContent">

        <!-- TAB 1: EN ATTENTE -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-borderless mb-0">
                        <thead class="bg-light sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th class="ps-3 py-3" style="width: 50px;">#</th>
                                <th class="py-3">Employé</th>
                                <th class="py-3">Type</th>
                                <th class="py-3">Période</th>
                                <th class="py-3 text-center">Durée</th>
                                <th class="py-3 text-center">Solde Restant</th>
                                <th class="py-3 text-center pe-3" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- LIGNE 1 - Congé Payé -->
                            <tr>
                                <td class="ps-3"><span class="text-muted small">1</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">JD</div>
                                        <div>
                                            <div class="fw-semibold">Jean Dupont</div>
                                            <div class="text-muted small">RH</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                        <i class="bi bi-umbrella me-1"></i>Congé Payé
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold">25/10/2025</span>
                                    <span class="text-muted mx-1">→</span>
                                    <span class="fw-semibold">02/11/2025</span>
                                </td>
                                <td class="text-center"><span class="fw-semibold">7 jours</span></td>
                                <td class="text-center"><span class="fw-semibold">18j restants</span></td>
                                <td class="text-center pe-3">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-success btn-sm">
                                            <i class="bi bi-check2 me-1"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-x me-1"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage de 1 à 6 sur 8 demandes en attente
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- TAB 2: APPROUVEES -->
        <div class="tab-pane fade" id="approved" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">
                    <div class="bg-success-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-check-circle text-success fs-1"></i>
                    </div>
                    <h5 class="fw-bold">24 demandes approuvées ce mois</h5>
                    <p class="text-muted small">Consultez l'historique complet dans l'onglet dédié</p>
                </div>
            </div>
        </div>

        <!-- TAB 3: REFUSEES -->
        <div class="tab-pane fade" id="refused" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">
                    <div class="bg-danger-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-x-circle text-danger fs-1"></i>
                    </div>
                    <h5 class="fw-bold">3 demandes refusées</h5>
                    <p class="text-muted small">Dont 1 contestée - en cours de révision</p>
                </div>
            </div>
        </div>

        <!-- TAB 4: CALENDRIER -->
        <div class="tab-pane fade" id="calendar" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-calendar3 text-primary me-2"></i>Octobre 2025
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered text-center mb-0" style="border-color: #e9ecef;">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width: 14.28%;">Lun</th>
                                    <th style="width: 14.28%;">Mar</th>
                                    <th style="width: 14.28%;">Mer</th>
                                    <th style="width: 14.28%;">Jeu</th>
                                    <th style="width: 14.28%;">Ven</th>
                                    <th style="width: 14.28%;">Sam</th>
                                    <th style="width: 14.28%;">Dim</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>1</td>
                                    <td>2</td>
                                    <td>3</td>
                                    <td>4</td>
                                </tr>
                                <tr>
                                    <td>5</td>
                                    <td>6</td>
                                    <td>7</td>
                                    <td>8</td>
                                    <td>9</td>
                                    <td>10</td>
                                    <td>11</td>
                                </tr>
                                <tr>
                                    <td>12</td>
                                    <td>13</td>
                                    <td>14</td>
                                    <td>15</td>
                                    <td>16</td>
                                    <td>17</td>
                                    <td>18</td>
                                </tr>
                                <tr>
                                    <td>19</td>
                                    <td>20</td>
                                    <td>21</td>
                                    <td>22</td>
                                    <td>23</td>
                                    <td>24</td>
                                    <td>25</td>
                                </tr>
                                <tr>
                                    <td class="bg-primary-subtle rounded-3">
                                        <span class="fw-semibold">26</span>
                                        <br>
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 8px;">P. Dubois</span>
                                    </td>
                                    <td>27</td>
                                    <td class="bg-warning-subtle rounded-3">
                                        <span class="fw-semibold">28</span>
                                        <br>
                                        <span class="badge bg-info-subtle text-info" style="font-size: 8px;">M. Martin</span>
                                    </td>
                                    <td class="bg-warning-subtle rounded-3">
                                        <span class="fw-semibold">29</span>
                                        <br>
                                        <span class="badge bg-info-subtle text-info" style="font-size: 8px;">M. Martin</span>
                                    </td>
                                    <td class="bg-danger-subtle rounded-3">
                                        <span class="fw-semibold">30</span>
                                        <br>
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 8px;">S. Laurent</span>
                                    </td>
                                    <td class="bg-danger-subtle rounded-3">
                                        <span class="fw-semibold">31</span>
                                        <br>
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 8px;">S. Laurent</span>
                                    </td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 d-flex flex-wrap gap-3">
                        <span class="text-muted small">Légende :</span>
                        <span class="badge bg-primary-subtle text-primary">Congé Payé</span>
                        <span class="badge bg-info-subtle text-info">RTT</span>
                        <span class="badge bg-danger-subtle text-danger">Maladie</span>
                        <span class="badge bg-warning-subtle text-warning">Sans Solde</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link .badge {
        font-size: 10px;
        padding: 3px 8px;
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}


    <!-- 8. LEGENDE BADGES TYPES EN BAS -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <span class="fw-semibold small">Types de congés :</span>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Congé Payé</span>
                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">RTT</span>
                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">Maladie</span>
                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">Sans Solde</span>
                <span class="text-muted small ms-2">
                    <i class="bi bi-arrow-repeat me-1"></i>Mise à jour en temps réel
                </span>
            </div>
        </div>
    </div>
