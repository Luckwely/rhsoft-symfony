{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Gestion de la Paie - Préparer{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Gestion de la Paie</h3>
            <p class="text-muted mb-0">Préparez et générez les fiches de paie en toute sécurité</p>
        </div>
        <a href="{{ path('app_admin_paie_exporter', {mois: mois, annee: annee}) }}" class="btn btn-outline-dark btn-sm mt-3 mt-lg-0">
            <i class="bi bi-file-earmark-arrow-down me-1"></i>Exporter (CSV)
        </a>
    </div>

    <!-- NAVIGATION -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link active border-0 rounded-3 px-4" href="{{ path('app_admin_paie_preparer', {mois: mois, annee: annee}) }}">
                <i class="bi bi-calculator text-info me-2"></i>Préparer la paie
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link border-0 rounded-3 px-4 text-secondary" href="{{ path('app_admin_paie_generer', {mois: mois, annee: annee}) }}">
                <i class="bi bi-file-earmark-text text-info me-2"></i>Générer fiches de paie
                {% if totalCalculated > 0 %}<span class="badge bg-primary ms-1">{{ totalCalculated }}</span>{% endif %}
            </a>
        </li>
    </ul>

    <!-- KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Employés payables</small>
                    <div class="fs-4 fw-bold">{{ totalEmployees }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Paies calculées</small>
                    <div class="fs-4 fw-bold text-primary">{{ totalCalculated }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Payées &amp; envoyées</small>
                    <div class="fs-4 fw-bold text-success">{{ totalPaid }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Masse salariale estimée</small>
                    <div class="fs-5 fw-bold">{{ totalMasse|number_format(0, ',', ' ') }} Ar</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- COLONNE GAUCHE -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                        <form method="get" class="d-flex gap-2">
                            <select class="form-select form-select-sm" style="width: 190px;" name="periode" onchange="const [m,a]=this.value.split('-'); window.location.href='{{ path('app_admin_paie_preparer') }}?mois='+m+'&annee='+a;">
                                {% for p in periods %}
                                    <option value="{{ p.mois }}-{{ p.annee }}" {% if p.current %}selected{% endif %}>{{ p.label }}</option>
                                {% endfor %}
                            </select>
                        </form>

                        <form method="post" action="{{ path('app_admin_paie_calculer_tout') }}" onsubmit="return confirm('Lancer le calcul de la paie pour tous les employés éligibles de {{ moisLabel }} {{ annee }} ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('calculer-tout') }}">
                            <input type="hidden" name="mois" value="{{ mois }}">
                            <input type="hidden" name="annee" value="{{ annee }}">
                            <button type="submit" class="btn btn-primary btn-sm" {% if pendingCount <= 0 %}disabled{% endif %}>
                               Lancer le calcul
                                {% if pendingCount > 0 %}<span class="badge bg-light text-primary ms-1">{{ pendingCount }}</span>{% endif %}
                            </button>
                        </form>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Service</th>
                                    <th class="py-3 text-center">Nb Employés</th>
                                    <th class="py-3 text-end">Masse Salariale Estimée</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for row in breakdown %}
                                <tr>
                                    <td class="ps-3"><i class="bi bi-diagram-3 text-primary me-2"></i>{{ row.service }}</td>
                                    <td class="text-center">{{ row.total_employees }}</td>
                                    <td class="text-end fw-bold">{{ row.masse|number_format(0, ',', ' ') }} Ar</td>
                                    <td class="text-center pe-3">
                                        {% if row.calculated == 0 %}
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                                <i class="bi bi-clock-history me-1"></i>En attente
                                            </span>
                                        {% elseif row.calculated < row.total_employees %}
                                            <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>{{ row.calculated }}/{{ row.total_employees }} calculé(s)
                                            </span>
                                        {% elseif row.paid == row.total_employees %}
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>Payé
                                            </span>
                                        {% else %}
                                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>Calculé
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Aucun employé avec un salaire de base configuré. Renseignez le salaire de base dans la fiche employé pour pouvoir préparer sa paie.
                                    </td>
                                </tr>
                            {% endfor %}
                            {% if breakdown|length > 0 %}
                                <tr class="table-light fw-bold">
                                    <td class="ps-3">Total</td>
                                    <td class="text-center">{{ totalEmployees }}</td>
                                    <td class="text-end">{{ totalMasse|number_format(0, ',', ' ') }} Ar</td>
                                    <td class="text-center pe-3"></td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLONNE DROITE: ETAPES -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0"><i class="bi bi-list-check text-primary me-2"></i>Étapes de préparation</h5>
                    <small class="text-muted">{{ moisLabel }} {{ annee }}</small>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 32px; height: 32px; font-size: 14px; font-weight: 600;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Vérifier pointages</div>
                            <small class="text-muted">Les absences sont récupérées automatiquement</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-{{ pendingCount > 0 ? 'primary' : 'success' }} text-white rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 32px; height: 32px; font-size: 14px; font-weight: 600;">2</div>
                        <div>
                            <div class="fw-semibold">Calculer</div>
                            <small class="text-muted">{{ totalCalculated }}/{{ totalEmployees }} paie(s) calculée(s)</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-{{ totalPaid == totalEmployees and totalEmployees > 0 ? 'success' : 'secondary' }} text-white rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 32px; height: 32px; font-size: 14px; font-weight: 600;">3</div>
                        <div>
                            <div class="fw-semibold">Valider &amp; Payer</div>
                            <small class="text-muted">{{ totalPaid }}/{{ totalEmployees }} payée(s) et envoyée(s)</small>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link { color: #6c757d; font-weight: 500; transition: all 0.3s ease; }
    .nav-tabs .nav-link:hover { background-color: #f8f9fa; color: #0d6efd; }
    .nav-tabs .nav-link.active { background-color: #0d6efd; color: #ffffff; box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3); }
    .nav-tabs .nav-link.active .badge { background-color: rgba(255,255,255,0.25) !important; color: #ffffff !important; }
</style>
{% endblock %}
