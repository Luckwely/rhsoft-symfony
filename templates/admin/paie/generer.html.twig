{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Gestion de la Paie - Générer{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-md-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Gestion de la Paie</h3>
            <p class="text-muted mb-0">Validez, payez et partagez automatiquement les fiches de paie</p>
        </div>
        <a href="{{ path('app_admin_paie_exporter', {mois: mois, annee: annee}) }}" class="btn btn-outline-dark btn-sm mt-3 mt-lg-0">
            <i class="bi bi-file-earmark-arrow-down me-1"></i>Exporter (CSV)
        </a>
    </div>

    <!-- NAVIGATION -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link border-0 rounded-3 px-4 text-secondary" href="{{ path('app_admin_paie_preparer', {mois: mois, annee: annee}) }}">
                <i class="bi bi-calculator text-info me-2"></i>Préparer la paie
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active border-0 rounded-3 px-4" href="{{ path('app_admin_paie_generer', {mois: mois, annee: annee}) }}">
                <i class="bi bi-file-earmark-text text-info me-2"></i>Générer fiches de paie
                {% if totalCount > 0 %}<span class="badge bg-primary ms-1">{{ totalCount }}</span>{% endif %}
            </a>
        </li>
    </ul>

    <!-- KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Fiches ({{ moisLabel }} {{ annee }})</small>
                    <div class="fs-4 fw-bold">{{ totalCount }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Payées &amp; envoyées</small>
                    <div class="fs-4 fw-bold text-success">{{ totalPaid }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Total brut</small>
                    <div class="fs-5 fw-bold">{{ totalBrut|number_format(0, ',', ' ') }} Ar</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <small class="text-muted">Total net</small>
                    <div class="fs-5 fw-bold text-success">{{ totalNet|number_format(0, ',', ' ') }} Ar</div>
                </div>
            </div>
        </div>
    </div>

    <form method="post" action="{{ path('app_admin_paie_valider_selection') }}" id="formValiderSelection" onsubmit="return confirm('Confirmer la validation et le paiement des fiches sélectionnées ? La fiche de paie sera envoyée automatiquement par email à chaque employé.');">
        <input type="hidden" name="_token" value="{{ csrf_token('valider-selection') }}">
        <input type="hidden" name="mois" value="{{ mois }}">
        <input type="hidden" name="annee" value="{{ annee }}">

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>Fiches de paie - {{ moisLabel }} {{ annee }}
                    </h5>
                    <select class="form-select form-select-sm" style="width: 190px; max-width: 100%;" onchange="const [m,a]=this.value.split('-'); window.location.href='{{ path('app_admin_paie_generer') }}?mois='+m+'&annee='+a;">
                        {% for p in periods %}
                            <option value="{{ p.mois }}-{{ p.annee }}" {% if p.current %}selected{% endif %}>{{ p.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" name="all" value="1" class="btn btn-success btn-sm" {% if totalPaid == totalCount %}disabled{% endif %}>
                    <i class="bi bi-send-check me-1"></i>Valider, payer &amp; envoyer tout
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-borderless mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3 py-3" style="width: 50px;">
                                    <input type="checkbox" class="form-check-input" id="checkAll" onclick="document.querySelectorAll('.paie-check').forEach(c => c.checked = this.checked);">
                                </th>
                                <th class="py-3">Employé</th>
                                <th class="py-3 d-none d-md-table-cell">Poste</th>
                                <th class="py-3 text-end d-none d-md-table-cell">Salaire Brut</th>
                                <th class="py-3 text-end d-none d-md-table-cell">Cotisations</th>
                                <th class="py-3 text-end">Salaire Net</th>
                                <th class="py-3 text-center">Statut</th>
                                <th class="py-3 text-center pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for paie in paies %}
                            {% set e = paie.employee %}
                            <tr>
                                <td class="ps-3">
                                    {% if not paie.isPaid %}
                                        <input type="checkbox" class="form-check-input paie-check" name="selected_paies[]" value="{{ paie.id }}">
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 36px; height: 36px; font-size: 13px;">
                                            {{ e.prenom|slice(0,1) }}{{ e.nom|slice(0,1) }}
                                        </div>
                                        <div class="overflow-hidden">
                                            <div class="fw-semibold text-truncate">{{ e.prenom }} {{ e.nom }}</div>
                                            <small class="text-muted d-block text-truncate">{{ e.poste|default(e.service)|default('-') }}</small>
                                            <small class="text-muted d-md-none d-block">{{ paie.salaireBrut|number_format(0, ',', ' ') }} Ar brut · -{{ paie.cotisations|number_format(0, ',', ' ') }} Ar cot.</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell">{{ e.poste|default('-') }}</td>
                                <td class="text-end d-none d-md-table-cell">{{ paie.salaireBrut|number_format(0, ',', ' ') }} Ar</td>
                                <td class="text-end text-danger d-none d-md-table-cell">-{{ paie.cotisations|number_format(0, ',', ' ') }} Ar</td>
                                <td class="text-end fw-bold text-success">{{ paie.salaireNet|number_format(0, ',', ' ') }} Ar</td>
                                <td class="text-center">
                                    {% if paie.isPaid %}
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2" title="{% if paie.validePar %}Validée par {{ paie.validePar.prenom }} {{ paie.validePar.nom }}{% if paie.paidAt %} le {{ paie.paidAt|date('d/m/Y H:i') }}{% endif %}{% endif %}{% if paie.payslipSentAt %} — Envoyée le {{ paie.payslipSentAt|date('d/m/Y H:i') }}{% else %} — Envoi email en échec{% endif %}">
                                            <i class="bi bi-check-circle-fill me-1"></i><span class="d-none d-sm-inline">Payée{% if paie.payslipSentAt %} &amp; envoyée{% else %} (email non envoyé){% endif %}</span>
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2" title="Calculée, en attente de validation">
                                            <i class="bi bi-clock-history me-1"></i><span class="d-none d-sm-inline">Calculée</span>
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-center pe-3 text-nowrap">
                                    <a href="{{ path('app_admin_paie_voir', {id: paie.id}) }}" class="btn btn-sm btn-light border-0" title="Voir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_admin_paie_telecharger', {id: paie.id}) }}" class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    {% if not paie.isPaid %}
                                        <button type="submit" form="valider-{{ paie.id }}" class="btn btn-sm btn-outline-success" title="Valider, payer et envoyer">
                                            <i class="bi bi-send-check"></i>
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    Aucune fiche de paie calculée pour cette période. Rendez-vous dans l'onglet « Préparer la paie » pour lancer le calcul.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>{{ totalCount }} fiche(s) de paie pour {{ moisLabel|lower }} {{ annee }}
                </small>
            </div>
        </div>
    </form>

    <!-- Formulaires individuels de validation (hors du form de sélection pour éviter les conflits de soumission) -->
    {% for paie in paies %}
        {% if not paie.isPaid %}
            <form method="post" action="{{ path('app_admin_paie_valider', {id: paie.id}) }}" id="valider-{{ paie.id }}" class="d-none" onsubmit="return confirm('Valider et payer la fiche de {{ paie.employee.prenom }} {{ paie.employee.nom }} ? La fiche sera envoyée automatiquement par email.');">
                <input type="hidden" name="_token" value="{{ csrf_token('valider-' ~ paie.id) }}">
            </form>
        {% endif %}
    {% endfor %}
</div>

<style>
    .nav-tabs .nav-link { color: #6c757d; font-weight: 500; transition: all 0.3s ease; }
    .nav-tabs .nav-link:hover { background-color: #f8f9fa; color: #0d6efd; }
    .nav-tabs .nav-link.active { background-color: #0d6efd; color: #ffffff; box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3); }
    .nav-tabs .nav-link.active .badge { background-color: rgba(255,255,255,0.25) !important; color: #ffffff !important; }
</style>
{% endblock %}
