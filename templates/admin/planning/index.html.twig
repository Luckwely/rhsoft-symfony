{% extends 'layouts/base_admin.html.twig' %}
{% block title %}Planning de l'équipe{% endblock %}
{% block body %}
<div class="container-fluid px-4 py-3">
    <div class="card border-0 bg-light rounded-4 shadow-sm mb-3 p-3">
        <form method="GET" action="{{ path('app_admin_planning') }}">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <input type="text" name="q" value="{{ search }}" placeholder="Rechercher employé..." class="form-control" style="max-width: 250px; flex: 1 1 200px;">
                <select name="role" class="form-select" style="max-width: 200px; flex: 1 1 150px;">
                    <option value="">Tous les rôles</option>
                    <option value="ROLE_ADMIN" {{ role=='ROLE_ADMIN'?'selected' }}>Admin</option>
                    <option value="ROLE_RH" {{ role=='ROLE_RH'?'selected' }}>RH</option>
                    <option value="ROLE_MANAGER" {{ role=='ROLE_MANAGER'?'selected' }}>Manager</option>
                    <option value="ROLE_EMPLOYE" {{ role=='ROLE_EMPLOYE'?'selected' }}>Agent</option>
                </select>
                <button class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Filtrer</button>
            </div>
        </form>
    </div>

    <form method="POST" action="{{ path('app_admin_planning_save') }}">
        <input type="hidden" name="week_start" value="{{ weekStart|date('Y-m-d') }}">

        <!-- HEADER -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h3 class="fw-bold mb-1">Planning de l'équipe ({{ employees.getTotalItemCount }})</h3>
                <p class="text-muted mb-0">
                    <i class="bi bi-calendar3 me-1"></i> Semaine {{ weekStart|date('W') }} - {{ weekStart|date('d M') }} au {{ weekStart|date_modify('+6 days')|date('d M Y') }}
                    {% if not canEdit %}<span class="badge bg-danger ms-2">Lecture seule - Semaine passée</span>{% endif %}
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_admin_planning', {week: prevWeek|date('Y-m-d'), q: search, role: role}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></a>
                <a href="{{ path('app_admin_planning', {q: search, role: role}) }}" class="btn btn-outline-secondary btn-sm">Aujourd'hui</a>
                <a href="{{ path('app_admin_planning', {week: nextWeek|date('Y-m-d'), q: search, role: role}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></a>
                {% if canEdit %}<button type="submit" class="btn btn-success btn-sm"><i class="bi bi-save me-1"></i>Enregistrer</button>{% endif %}
            </div>
        </div>

        <!-- TABLEAU -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" style="font-size: 12px;">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 150px;">Employé</th>
                            {% for day in days %}
                                <th class="text-center">
                                    {{ day|date('D')|capitalize }}<br>
                                    <small class="text-muted">{{ day|date('d/m') }}</small>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                    {% for employe in employees %}
                        <tr>
                            <td class="fw-semibold">{{ employe.prenom }} {{ employe.nom }}</td>
                            {% for day in days %}
                                {% set dayIndex = loop.index0 %} {# 0,1,2... #}
                                {% set dayName = dayNames[dayIndex] %} {# 'lundi', 'mardi'... garanti FR #}
                                {% set p = planningMap[employe.id][dayName]?? null %}

                                <td class="p-1 {{ not canEdit? 'bg-light' }} {{ p and p.isConge and p.status == 'valide' ? 'bg-info-subtle' }}">
                                    {% if p and p.isConge and p.status == 'valide' %}
                                        <div class="text-center py-2" title="Congé validé — non modifiable ici">
                                            <i class="bi bi-lock-fill text-info"></i><br>
                                            <span class="badge bg-info-subtle text-info" style="font-size:9px">
                                                <i class="bi bi-airplane-fill me-1"></i>Congé
                                            </span>
                                        </div>
                                    {% else %}
                                    <div class="d-flex flex-column gap-1">
                                        {% if not canEdit %}
                                            <input type="hidden" name="planning[{{ employe.id }}][{{ dayIndex }}][isDayOff]" value="{{ p and p.isDayOff? '1' : '0' }}">
                                        {% endif %}
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox"
                                                name="planning[{{ employe.id }}][{{ dayIndex }}][isDayOff]"
                                                value="1" {{ p and p.isDayOff? 'checked' }} {{ not canEdit? 'disabled' }}>
                                            <label class="form-check-label" style="font-size:10px">Repos</label>
                                        </div>
                                        <label class="form-check-label" style="font-size:9px">Début</label>
                                        <input type="time" class="form-control form-control-sm {{ not canEdit? 'bg-light' }}"
                                            name="planning[{{ employe.id }}][{{ dayIndex }}][heureDebut]"
                                            value="{{ p and p.heureDebut? p.heureDebut|date('H:i') : '08:00' }}" {{ not canEdit? 'readonly' }}>
                                        <label class="form-check-label" style="font-size:9px">Fin</label>
                                        <input type="time" class="form-control form-control-sm {{ not canEdit? 'bg-light' }}"
                                            name="planning[{{ employe.id }}][{{ dayIndex }}][heureFin]"
                                            value="{{ p and p.heureFin? p.heureFin|date('H:i') : '17:00' }}" {{ not canEdit? 'readonly' }}>
                                        
                                    </div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- CALENDRIER DES CONGÉS DE LA SEMAINE -->
        <div class="card border-0 shadow-sm rounded-4 mt-3">
            <div class="card-header bg-transparent border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-week text-info me-2"></i>Calendrier des congés — semaine du {{ weekStart|date('d/m') }}</h6>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    {% for day in days %}
                        {% set key = day|date('Y-m-d') %}
                        {% set employesEnConge = congesSemaine[key]|default([]) %}
                        <div class="col">
                            <div class="border rounded-3 p-2 h-100 {{ employesEnConge|length > 0 ? 'bg-info-subtle' : 'bg-light' }}">
                                <div class="small fw-semibold text-center mb-1">{{ day|date('D')|capitalize }} {{ day|date('d/m') }}</div>
                                {% if employesEnConge|length > 0 %}
                                    {% for emp in employesEnConge %}
                                        <div class="small text-info-emphasis text-truncate" title="{{ emp.prenom }} {{ emp.nom }}">
                                            <i class="bi bi-airplane-fill me-1"></i>{{ emp.prenom }} {{ emp.nom|slice(0,1) }}.
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="small text-muted text-center">—</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- PAGINATION -->
        <div class="card-footer bg-transparent border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 py-3">
            <div class="text-muted small"><i class="bi bi-info-circle me-1"></i> {{ employees.getTotalItemCount }} employés au total</div>
            <div>{{ knp_pagination_render(employees) }}</div>
        </div>
    </form>
</div>
{% endblock %}
