{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Rapports & Analyses RH{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- 1. HEADER STICKY -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>Rapports & Analyses RH
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar3 me-1"></i>Vue globale de l'activité du 01/10/2025 au 31/10/2025
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0 flex-wrap">
            <input type="month" class="form-control form-control-sm" value="2025-10" style="max-width: 160px;">
            <button class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter PDF
            </button>
            <button class="btn btn-outline-dark btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i>Exporter Excel
            </button>
        </div>
    </div>

    <!-- 2. SECTION KPI CARDS 4 COLONNES -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Masse Salariale</span>
                            <h2 class="fw-bold mb-0 mt-1">45 200 €</h2>
                            <div class="mt-2">
                                <span class="badge bg-success-subtle text-success rounded-pill">
                                    <i class="bi bi-arrow-up me-1"></i>+3.2%
                                </span>
                            </div>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-euro text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Taux d'Absentéisme</span>
                            <h2 class="fw-bold mb-0 mt-1">4.8%</h2>
                            <div class="mt-2">
                                <span class="badge bg-danger-subtle text-danger rounded-pill">
                                    <i class="bi bi-arrow-up me-1"></i>+0.5%
                                </span>
                            </div>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-person-x text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Heures Travaillées</span>
                            <h2 class="fw-bold mb-0 mt-1">18 450h</h2>
                            <div class="mt-2">
                                <span class="badge bg-success-subtle text-success rounded-pill">
                                    <i class="bi bi-arrow-up me-1"></i>+5.1%
                                </span>
                            </div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-clock text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Turnover</span>
                            <h2 class="fw-bold mb-0 mt-1">2.1%</h2>
                            <div class="mt-2">
                                <span class="badge bg-success-subtle text-success rounded-pill">
