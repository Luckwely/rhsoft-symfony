{% extends 'layouts/base_admin.html.twig' %}

{% block title %}Rapports & Analyses RH{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- 1. HEADER STICKY -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Rapports & Analyses RH
            </h3>
            <p class="text-muted mb-0">
                Analyse annuelle {{ reportData.year }}
            </p>
        </div>

    </div>

    <!-- 2. SECTION KPI CARDS 4 COLONNES -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Masse Salariale</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ reportData.payrollMass|number_format(0, ',', ' ') }} Ar</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-euro text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Taux d'Absentéisme</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ reportData.absentRate }}%</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-person-x  fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Effectif total</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ reportData.totalEmployees }}</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. SECTION 2 GRAPHIQUES 2 COLONNES -->
    <div class="row g-4 mb-4">
        <!-- Graphique 1: Évolution des effectifs -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            Départs sur 6 mois
                        </h5>
                        <small class="text-muted">Tendance des départs au fil des mois</small>
                    </div>

                </div>
                <div class="card-body">
                    <canvas id="chartEffectif" height="120"></canvas>
                </div>
            </div>
        </div>

        <!-- Graphique 2: Répartition par Service -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        Répartition par Service
                    </h5>
                    <small class="text-muted">{{ reportData.totalEmployees }} employés au total</small>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="chartService" height="180"></canvas>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        {% for service in reportData.serviceDistribution %}
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">{{ service.service }}: {{ service.total }}</span>
                        {% else %}
                            <span class="text-muted">Aucun service</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. SECTION 2 TABLEAUX COTE A COTE -->
    <div class="row g-4 mb-4">
        <!-- Tableau 1: Coût par Service -->
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-1 ">
                        Coût par Service
                    </h5>
                    <small class="text-muted">Masse salariale mensuelle</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Service</th>
                                    <th class="text-center">Nb Employés</th>
                                    <th class="text-end">Masse Salariale</th>
                                    <th class="text-end pe-3">Coût Moyen</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set totalEmployeesCost = 0 %}
                                {% set totalPayrollCost = 0 %}
                                {% for row in reportData.serviceCosts %}
                                    {% set totalEmployeesCost = totalEmployeesCost + row.employeeCount %}
                                    {% set totalPayrollCost = totalPayrollCost + row.payrollMass %}
                                    <tr>
                                        <td class="ps-3"><span class="fw-semibold">{{ row.service ?: 'Non défini' }}</span></td>
                                        <td class="text-center">{{ row.employeeCount }}</td>
                                        <td class="text-end">{{ row.payrollMass|number_format(0, ',', ' ') }} Ar</td>
                                        <td class="text-end pe-3">{{ row.employeeCount > 0 ? (row.payrollMass / row.employeeCount)|number_format(0, ',', ' ') : 0 }} Ar</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Aucun service trouvé</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td class="ps-3 fw-bold">Total</td>
                                    <td class="text-center fw-bold">{{ reportData.totalEmployees }}</td>
                                    <td class="text-end fw-bold">{{ reportData.payrollMass|number_format(0, ',', ' ') }} Ar</td>
                                    <td class="text-end pe-3 fw-bold">{{ reportData.totalEmployees > 0 ? (reportData.payrollMass / reportData.totalEmployees)|number_format(0, ',', ' ') : 0 }} Ar</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau 2: Heures Supplémentaires -->
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 ">
                            Heures Supplémentaires
                        </h5>
                        <small class="text-muted">Top 5 des heures sup</small>
                    </div>

                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Employé</th>
                                    <th class="text-center">Service</th>
                                    <th class="text-center">Heures Sup</th>
                                    <th class="text-end pe-3">Coût</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in reportData.overtimeList %}
                                    {% set emp = item.employee %}
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                                    {{ ((emp.prenom|default('')|slice(0,1) ~ emp.nom|default('')|slice(0,1))|upper)|default('--') }}
                                                </div>
                                                <span class="fw-semibold">{{ emp.prenom ~ ' ' ~ emp.nom }}</span>
                                            </div>
                                        </td>
                                        <td class="text-center">{{ emp.service ?: 'N/A' }}</td>
                                        <td class="text-center"><span class="fw-semibold">{{ item.hours }}h</span></td>
                                        <td class="text-end pe-3">{{ item.cost|number_format(0, ',', ' ') }} Ar</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Aucune heure supplémentaire enregistrée</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    {% include 'admin/_advanced_analytics.html.twig' with {'advancedAnalytics': reportData.advancedAnalytics} %}
{% endblock %}

{% block javascripts %}
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Graphique 1: Évolution des effectifs - Line Chart
    const ctx1 = document.getElementById('chartEffectif').getContext('2d');

    const gradient1 = ctx1.createLinearGradient(0, 0, 0, 200);
    gradient1.addColorStop(0, 'rgba(13, 110, 253, 0.3)');
    gradient1.addColorStop(1, 'rgba(13, 110, 253, 0.0)');

    const labels1 = {{ reportData.chartLabels|json_encode|raw }};
    const values1 = {{ reportData.chartValues|json_encode|raw }};

    new Chart(ctx1, {
        type: 'line',
        data: {
            labels: labels1,
            datasets: [{
                label: 'Départs',
                data: values1,
                borderColor: '#0d6efd',
                backgroundColor: gradient1,
                borderWidth: 3,
                pointBackgroundColor: '#0d6efd',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return 'Départs: ' + context.parsed.y;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        stepSize: 10
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

    // Graphique 2: Répartition par Service - Doughnut Chart
    const ctx2 = document.getElementById('chartService').getContext('2d');

    const labels2 = [
        {% for service in reportData.serviceDistribution %}
            '{{ service.service|e('js') }}'{% if not loop.last %}, {% endif %}
        {% endfor %}
    ];
    const values2 = [
        {% for service in reportData.serviceDistribution %}
            {{ service.total }}{% if not loop.last %}, {% endif %}
        {% endfor %}
    ];

    new Chart(ctx2, {
        type: 'doughnut',
        data: {
            labels: labels2,
            datasets: [{
                data: values2,
                backgroundColor: [
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(25, 135, 84, 0.8)',
                    'rgba(255, 193, 7, 0.8)',
                    'rgba(13, 202, 240, 0.8)'
                ],
                borderColor: [
                    '#0d6efd',
                    '#198754',
                    '#ffc107',
                    '#0dcaf0'
                ],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 16,
                        usePointStyle: true,
                        pointStyle: 'circle',
                        font: {
                            size: 12,
                            weight: '500'
                        }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = ((context.parsed / total) * 100).toFixed(1);
                            return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                        }
                    }
                }
            },
            cutout: '65%'
        }
    });
});
</script>
{% endblock %}
