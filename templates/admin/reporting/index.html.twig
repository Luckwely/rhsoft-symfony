    <!-- 6. SECTION EXPORT RAPPORTS PREDEFINIS -->
    <div class="card border-0 bg-light rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Rapports prédéfinis
            </h5>
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-3 text-center p-3 h-100" style="cursor: pointer;">
                        <div class="bg-primary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                            <i class="bi bi-file-earmark-text text-primary fs-4"></i>
                        </div>
                        <h6 class="fw-semibold mb-0 small">Bilan Social</h6>
                        <span class="text-muted small">PDF</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-3 text-center p-3 h-100" style="cursor: pointer;">
                        <div class="bg-success-subtle rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                            <i class="bi bi-calendar-check text-success fs-4"></i>
