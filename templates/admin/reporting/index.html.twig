                            <th style="width: 40%;">Motif</th>
                            <th style="width: 15%;">Jours</th>
                            <th style="width: 45%;">Répartition</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <span class="fw-semibold">Maladie</span>
                                <span class="badge bg-danger-subtle text-danger ms-2">24j</span>
                            </td>
                            <td>24j</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-danger" style="width: 45%;"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="fw-semibold">Congé Payé</span>
                                <span class="badge bg-primary-subtle text-primary ms-2">18j</span>
                            </td>
                            <td>18j</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary" style="width: 35%;"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="fw-semibold">RTT</span>
                                <span class="badge bg-info-subtle text-info ms-2">10j</span>
                            </td>
                            <td>10j</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-info" style="width: 20%;"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="fw-semibold">Sans Solde</span>
                                <span class="badge bg-warning-subtle text-warning ms-2">3j</span>
                            </td>
                            <td>3j</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-warning" style="width: 7%;"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="fw-semibold">Formation</span>
                                <span class="badge bg-secondary-subtle text-secondary ms-2">2j</span>
                            </td>
                            <td>2j</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-secondary" style="width: 5%;"></div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5. SECTION 2 TABLEAUX COTE A COTE -->
    <div class="row g-4 mb-4">
        <!-- Tableau 1: Coût par Service -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-wallet2 text-primary me-2"></i>Coût par Service
                    </h5>
                    <small class="text-muted">Masse salariale mensuelle</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Service</th>
                                    <th class="text-center">Nb Employés</th>
                                    <th class="text-end">Masse Salariale</th>
                                    <th class="text-end pe-3">Coût Moyen</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Tech</span></td>
                                    <td class="text-center">45</td>
                                    <td class="text-end">22 500 €</td>
                                    <td class="text-end pe-3">500 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Commercial</span></td>
                                    <td class="text-center">60</td>
                                    <td class="text-end">30 000 €</td>
                                    <td class="text-end pe-3">500 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">RH</span></td>
                                    <td class="text-center">12</td>
                                    <td class="text-end">6 000 €</td>
                                    <td class="text-end pe-3">500 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Compta</span></td>
                                    <td class="text-center">25</td>
                                    <td class="text-end">12 500 €</td>
                                    <td class="text-end pe-3">500 €</td>
                                </tr>
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td class="ps-3 fw-bold">Total</td>
                                    <td class="text-center fw-bold">142</td>
                                    <td class="text-end fw-bold">71 000 €</td>
                                    <td class="text-end pe-3 fw-bold">500 €</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau 2: Heures Supplémentaires -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock text-primary me-2"></i>Heures Supplémentaires
                        </h5>
                        <small class="text-muted">Top 5 des heures sup</small>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-warning">Total: 48h</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Employé</th>
                                    <th class="text-center">Service</th>
                                    <th class="text-center">Heures Sup</th>
                                    <th class="text-end pe-3">Coût</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">JD</div>
                                            <span class="fw-semibold">Jean Dupont</span>
                                        </div>
                                    </td>
                                    <td class="text-center">Tech</td>
                                    <td class="text-center"><span class="fw-semibold">12h</span></td>
                                    <td class="text-end pe-3">300 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">MM</div>
                                            <span class="fw-semibold">Marie Martin</span>
                                        </div>
                                    </td>
                                    <td class="text-center">Commercial</td>
                                    <td class="text-center"><span class="fw-semibold">10h</span></td>
                                    <td class="text-end pe-3">250 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">TB</div>
                                            <span class="fw-semibold">Thomas Bernard</span>
                                        </div>
                                    </td>
                                    <td class="text-center">Tech</td>
                                    <td class="text-center"><span class="fw-semibold">8h</span></td>
                                    <td class="text-end pe-3">200 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">JL</div>
                                            <span class="fw-semibold">Julie Lefèvre</span>
                                        </div>
                                    </td>
                                    <td class="text-center">RH</td>
                                    <td class="text-center"><span class="fw-semibold">6h</span></td>
                                    <td class="text-end pe-3">150 €</td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">PD</div>
                                            <span class="fw-semibold">Paul Dubois</span>
                                        </div>
                                    </td>
