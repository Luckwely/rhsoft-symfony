<!-- Logo -->
<div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
    <a href="{{ path('app_admin_dashboard') }}" class="sidebar-logo d-flex align-items-center">
        <i class="bi bi-building me-2"></i>
        <span>RH Soft Pro</span>
    </a>
    <span class="sidebar-badge ms-2">{{ app.user.entreprise.nom ?? 'Demo' }}</span>
</div>

<!-- Navigation Menu -->
<nav class="nav nav-pills flex-column mb-auto gap-1">
    <a href="{{ path('app_rh_dashboard') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_dashboard' %}active{% endif %}">
        <i class="bi bi-speedometer2 me-2"></i>
        Tableau de bord
    </a>
    <a href="{{ path('app_rh_employee') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_employee' %}active{% endif %}">
        <i class="bi bi-people me-2"></i>
        Employés
    </a>
    <a href="{{ path('app_rh_recrutement') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_recrutement' %}active{% endif %}">
        <i class="bi bi-megaphone me-2"></i>
        Recrutement
    </a>
    <a href="{{ path('app_rh_demandes') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_demandes' %}active{% endif %}">
        <i class="bi bi-clipboard-check me-2"></i>
        Demandes
    </a>
    <a href="{{ path('app_rh_planning') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_planning' %}active{% endif %}">
        <i class="bi bi-calendar-week me-2"></i>
        Planning
    </a>
    <a href="{{ path('app_rh_paie') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_paie' %}active{% endif %}">
        <i class="bi bi-wallet2 me-2"></i>
        Paie
    </a>
    <a href="{{ path('app_rh_pointage') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_pointage' %}active{% endif %}">
        <i class="bi bi-clock-history me-2"></i>
        Pointage
    </a>
    <a href="{{ path('app_rh_rapport') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_rh_rapport' %}active{% endif %}">
        <i class="bi bi-graph-up-arrow me-2"></i>
        Rapports
    </a>
</nav>

<!-- Sidebar Footer - User Info -->
<div class="sidebar-user">
    <div class="d-flex align-items-center">
        <div class="avatar-circle bg-primary">
            {{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
        </div>
        <div class="ms-2">
            <div class="user-name">{{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}</div>
            <div class="user-company">{{ app.user.entreprise.nom ?? 'Entreprise' }}</div>
        </div>
    </div>
</div>
