<!-- Logo -->
<div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
    <a href="{{ path('app_manager_monEquipe') }}" class="sidebar-logo d-flex align-items-center">
        <i class="bi bi-building me-2"></i>
        <span>RH Soft Pro</span>
    </a>
    <span class="sidebar-badge ms-2">{{ app.user.entreprise.nom ?? 'Demo' }}</span>
</div>

<!-- Navigation Menu -->
<nav class="nav nav-pills flex-column mb-auto gap-1">
    <a href="{{ path('app_manager_profile') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_manager_profile' %}active{% endif %}">
        <i class="bi bi-person-circle me-2"></i>
        Mon Profil
    </a>
    <a href="{{ path('app_manager_monEquipe') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_manager_monEquipe' %}active{% endif %}">
        <i class="bi bi-people me-2"></i>
        Mon Equipe
    </a>
    <a href="{{ path('app_manager_planning') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_manager_planning' %}active{% endif %}">
        <i class="bi bi-calendar-week me-2"></i>
        Planning Equipe
    </a>
    <a href="{{ path('app_manager_pointage') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_manager_pointage' %}active{% endif %}">
        <i class="bi bi-clock-history me-2"></i>
        Pointages
    </a>
    <a href="{{ path('app_manager_demandes') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_manager_demandes' %}active{% endif %}">
        <i class="bi bi-clipboard-check me-2"></i>
        Demandes
    </a>
</nav>

<!-- Sidebar Footer - User Info -->
<div class="sidebar-user">
    <div class="d-flex align-items-center">
        <div class="avatar-circle bg-primary">
            {{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
        </div>
        <div class="ms-2">
            <div class="user-name">{{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}</div>
            <div class="user-company">{{ app.user.entreprise.nom ?? 'Entreprise' }}</div>
        </div>
    </div>
</div>

