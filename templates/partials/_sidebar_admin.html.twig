 <!-- Logo -->
<div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
    <a href="{{ path('app_admin_dashboard') }}" class="sidebar-logo d-flex align-items-center">
        <span>RHSOFT</span>
    </a>
    <span class="sidebar-badge ms-2">{{ app.user.entreprise.nom ?? 'Demo' }}</span>
</div>

<!-- Navigation Menu -->
<nav class="nav nav-pills flex-column mb-auto gap-1">
    <a href="{{ path('app_admin_dashboard') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}active{% endif %}">
        <i class="bi bi-speedometer2 me-2"></i>
        Tableau de bord
    </a>
    <a href="{{ path('app_employee_list') }}"
        class="nav-link {% if app.request.attributes.get('_route') == 'app_employee_list' %}active{% endif %}">
        <i class="bi bi-people me-2"></i>
        Employés
    </a>
    <a href="{{ path('app_employee_planning') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_employee_planning' %}active{% endif %}">
        <i class="bi bi-calendar-week me-2"></i>
        Planning
    </a>
    <a href="{{ path('app_admin_pointage') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_pointage' %}active{% endif %}">
        <i class="bi bi-qr-code me-2"></i>
        Pointage
    </a>
    <a href="{{ path('app_admin_conge') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_conge' %}active{% endif %}">
        <i class="bi bi-calendar-check me-2"></i>
        Congés
    </a>
    <a href="{{ path('app_admin_reporting') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_reporting' %}active{% endif %}">
        <i class="bi bi-graph-up-arrow me-2"></i>
        Reporting
    </a>
    <a href="{{ path('app_admin_parametre') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_admin_parametre' %}active{% endif %}">
        <i class="bi bi-gear me-2"></i>
        Paramètres
    </a>
</nav>

<!-- Sidebar Footer - User Info -->
<div class="sidebar-user">
    <div class="d-flex align-items-center">
        <div class="avatar-circle bg-primary">
            {{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
        </div>
        <div class="ms-2">
            <div class="user-name">{{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}</div>
            <div class="user-company">{{ app.user.entreprise.nom ?? 'Entreprise' }}</div>
        </div>
    </div>
</div>
