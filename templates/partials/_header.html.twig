 <!-- Mobile Toggle -->
<button class="sidebar-toggle d-lg-none me-3" onclick="toggleSidebar()" aria-label="Toggle sidebar">
    <i class="bi bi-list fs-4"></i>
</button>

<!-- Right Side -->
<div class="d-flex align-items-center gap-2 ms-auto">

    <!-- User Dropdown -->
    <div class="dropdown">
        <button class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-2"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="avatar-circle">
                {{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
            </div>
            <span class="d-none d-sm-inline fw-semibold text-dark small">
                {{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}
            </span>
            <i class="bi bi-chevron-down text-secondary small d-none d-sm-inline"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-custom dropdown-menu-end">
            {% if not is_granted('ROLE_MANAGER') %}
                <li>
                    <a class="dropdown-item" href="{{
                        is_granted('ROLE_SUPER_ADMIN') ? path('app_super_admin_profile') :
                        is_granted('ROLE_ADMIN') ? path('app_admin_profile') :
                        is_granted('ROLE_RH') ? path('app_rh_profile') :
                        path('app_employe_profile')
                    }}">
                        <i class="bi bi-person me-2"></i>Mon profil
                    </a>
                </li>
            {% endif %}
            <li>
                <a class="dropdown-item" href="{{
                    is_granted('ROLE_SUPER_ADMIN') ? path('app_super_admin_parametre') :
                    is_granted('ROLE_ADMIN') ? path('app_admin_parametre') :
                    is_granted('ROLE_RH') ? path('app_rh_parametre') :
                    is_granted('ROLE_MANAGER') ? path('app_manager_parametre') :
                    path('app_employe_parametre')
                }}">
                    <i class="bi bi-gear me-2"></i>Paramètres
                </a>
            </li>

            <li><hr class="dropdown-divider-custom"></li>
            <li>
                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                </a>
            </li>
        </ul>
    </div>
</div>
