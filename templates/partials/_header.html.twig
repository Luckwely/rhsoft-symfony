 <!-- Mobile Toggle -->
<button class="sidebar-toggle d-lg-none me-3" onclick="toggleSidebar()" aria-label="Toggle sidebar">
    <i class="bi bi-list fs-4"></i>
</button>

<!-- Search Bar -->
<div class="search-wrapper flex-grow-1 me-3" style="max-width: 400px;">
    <i class="bi bi-search"></i>
    <input type="text" class="search-input w-100" placeholder="Rechercher..." aria-label="Rechercher">
</div>

<!-- Right Side -->
<div class="d-flex align-items-center gap-2 ms-auto">
    <!-- Notifications -->
    <button class="notification-btn position-relative" type="button">
        <i class="bi bi-bell fs-5"></i>
        <span class="notification-badge">3</span>
    </button>

    <!-- User Dropdown -->
    <div class="dropdown">
        <button class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-2"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="avatar-circle">
                {{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
            </div>
            <span class="d-none d-sm-inline fw-semibold text-dark small">
                {{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}
            </span>
            <i class="bi bi-chevron-down text-secondary small d-none d-sm-inline"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-custom dropdown-menu-end">
            <li>
                <a class="dropdown-item" href="#">
                    <i class="bi bi-person me-2"></i>Mon profil
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#">
                    <i class="bi bi-gear me-2"></i>Paramètres
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#">
                    <i class="bi bi-building me-2"></i>Entreprise
                </a>
            </li>
            <li><hr class="dropdown-divider-custom"></li>
            <li>
                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                </a>
            </li>
        </ul>
    </div>
</div>
