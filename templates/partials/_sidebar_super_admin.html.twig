<!-- Logo -->
<div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
	<a href="{{ path('app_super_admin_dashboard') }}" class="sidebar-logo d-flex align-items-center">
		<i class="bi bi-building me-2"></i>
		<span>RH Soft Pro</span>
	</a>
	<span class="sidebar-badge ms-2">{{ app.user.entreprise.nom ?? 'Demo' }}</span>
</div>

<!-- Navigation Menu -->
<nav class="nav nav-pills flex-column mb-auto gap-1">
	<a href="{{ path('app_super_admin_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_super_admin_dashboard' %}active{% endif %}">
		<i class="bi bi-speedometer2 me-2"></i>
		Dashboard Global
	</a>
	<a href="{{ path('app_super_admin_entreprise') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_super_admin_entreprise' %}active{% endif %}">
		<i class="bi bi-people me-2"></i>
		Gestion Entreprises
	</a>
	<a href="{{ path('app_super_admin_facturation') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_super_admin_facturation' %}active{% endif %}">
		<i class="bi bi-calendar-week me-2"></i>
		Facturation
	</a>
	<a href="{{ path('app_super_admin_module') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_super_admin_module' %}active{% endif %}">
		<i class="bi bi-qr-code me-2"></i>
		Modules
	</a>
	<a href="{{ path('app_super_admin_parametre') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_super_admin_parametre' %}active{% endif %}">
		<i class="bi bi-graph-up-arrow me-2"></i>
		Paramètres Système
	</a>
</nav>

<!-- Sidebar Footer - User Info -->
<div class="sidebar-user">
	<div class="d-flex align-items-center">
		<div class="avatar-circle bg-primary">
			{{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
		</div>
		<div class="ms-2">
			<div class="user-name">{{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}</div>
			<div class="user-company">{{ app.user.entreprise.nom ?? 'Entreprise' }}</div>
		</div>
	</div>
</div>
