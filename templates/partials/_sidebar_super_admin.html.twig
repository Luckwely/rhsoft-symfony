<!-- Logo -->
<div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
	<a href="{{ path('app_super_admin_dashboard') }}" class="sidebar-logo d-flex align-items-center text-xl">
		<span class="">RHSOFT</span>
	</a>
</div>

<!-- Navigation Menu -->
<nav class="nav nav-pills flex-column mb-auto gap-1">
    {% set current_route = app.request.attributes.get('_route') %}
	<a href="{{ path('app_super_admin_dashboard') }}" class="nav-link {% if 'app_super_admin_dashboard' in current_route %}active{% endif %}">
		<i class="bi bi-speedometer2 me-2"></i>
		Dashboard Global
	</a>
	<a href="{{ path('app_super_admin_entreprise') }}" class="nav-link {% if 'app_super_admin_entreprise' in current_route %}active{% endif %}">
		<i class="bi bi-buildings me-2"></i>
		Gestion Entreprises
	</a>
	<a href="{{ path('app_super_admin_facturation') }}" class="nav-link {% if 'app_super_admin_facturation' in current_route %}active{% endif %}">
		<i class="bi bi-receipt me-2"></i>
		Facturation
	</a>
	<a href="{{ path('app_super_admin_module') }}" class="nav-link {% if 'app_super_admin_module' in current_route %}active{% endif %}">
		<i class="bi bi-grid-3x3-gap-fill me-2"></i>
		Modules
	</a>
	<a href="{{ path('app_super_admin_parametre') }}" class="nav-link {% if 'app_super_admin_parametre' in current_route %}active{% endif %}">
		<i class="bi bi-gear me-2"></i>
        Administration
	</a>
</nav>

<!-- Sidebar Footer - User Info -->
<div class="sidebar-user">
	<div class="d-flex align-items-center">
		<div class="avatar-circle bg-primary">
			{{ app.user.prenom ? app.user.prenom|slice(0, 1)|upper : 'U' }}
		</div>
		<div class="ms-2">
			<div class="user-name">{{ app.user.prenom ? app.user.prenom ~ ' ' ~ app.user.nom : app.user.email }}</div>
			<div class="user-company">{{ app.user.entreprise.nom ?? 'Entreprise' }}</div>
		</div>
	</div>
</div>
