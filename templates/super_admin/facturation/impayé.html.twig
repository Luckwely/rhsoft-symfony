                            <td class="text-center">
                                <span class="text-muted small">01/07/2026</span>
                                <br>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary small">Aucune</span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm">
                                    <i class="bi bi-send me-1"></i>Relancer
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" title="Voir facture">
