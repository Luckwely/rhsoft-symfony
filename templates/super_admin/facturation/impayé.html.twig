        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" class="form-control ps-5" placeholder="Rechercher une entreprise..." aria-label="Rechercher">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option value="">Tous les retards</option>
                        <option value="7">Moins de 7 jours</option>
                        <option value="15">8-15 jours</option>
                        <option value="30">16-30 jours</option>
                        <option value="30">Plus de 30 jours</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option value="">Toutes les relances</option>
                        <option value="none">Aucune</option>
                        <option value="1">1 relance</option>
                        <option value="2">2 relances</option>
                        <option value="3">3+ relances</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrer
                    </button>
                </div>
            </div>
        </div>
