                <i class="bi bi-exclamation-triangle text-danger me-2"></i>Factures en Retard
            </h1>
            <p class="text-muted small mb-0">Gérez les impayés et relancez vos clients</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary">
                <i class="bi bi-download me-2"></i>Exporter
            </button>
            <button class="btn btn-primary">
                <i class="bi bi-send me-2"></i>Relancer toutes
            </button>
        </div>
    </div>

    <!-- Alerte globale -->
    <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3" role="alert">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-danger bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                <i class="bi bi-clock-history text-danger fs-4"></i>
            </div>
            <div>
                <h5 class="alert-heading fw-bold mb-0">7 factures en retard</h5>
                <p class="mb-0 small">Un total de <strong>4 200 €</strong> est actuellement impayé</p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2">
                <i class="bi bi-arrow-right me-1"></i>Action requise
            </span>
        </div>
    </div>

    <!-- Statistiques des impayés -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-danger mb-1">Total</span>
                    <h5 class="fw-bold mb-0 text-danger">7</h5>
                    <small class="text-muted">Factures</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-warning mb-1">Montant</span>
                    <h5 class="fw-bold mb-0 text-warning">4 200 €</h5>
                    <small class="text-muted">Impayé</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-secondary mb-1">Moyenne</span>
                    <h5 class="fw-bold mb-0">18</h5>
                    <small class="text-muted">Jours de retard</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <span class="badge bg-info mb-1">Relances</span>
                    <h5 class="fw-bold mb-0 text-info">3</h5>
                    <small class="text-muted">En attente</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres -->
