{% extends "layouts/base_super_admin.html.twig" %}

{% block title %}Tous les Abonnements{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-0">
                Tous les Abonnements
            </h1>
            <p class="text-muted small mb-0">
                <i class="bi bi-database me-1"></i>Gérez tous les abonnements des entreprises
            </p>
        </div>
    </div>

    <!-- Filtres -->
    <form method="GET">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="position-relative">
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" name="q" value="{{ app.request.query.get('q') }}" class="form-control ps-5" placeholder="Rechercher une entreprise...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="plan" class="form-select">
                            <option value="">Tous les plans</option>
                            <option value="starter" {{ app.request.query.get('plan') == 'starter' ? 'selected' : '' }}>Starter</option>
                            <option value="pro" {{ app.request.query.get('plan') == 'pro' ? 'selected' : '' }}>Premium</option>
                            <option value="enterprise" {{ app.request.query.get('plan') == 'enterprise' ? 'selected' : '' }}>VIP</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="">Tous les statuts</option>
                            <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Actif</option>
                            <option value="canceled" {{ app.request.query.get('status') == 'canceled' ? 'selected' : '' }}>Annulé</option>
                            <option value="expired" {{ app.request.query.get('status') == 'expired' ? 'selected' : '' }}>Expiré</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100 mt-1">
                            <i class="bi bi-funnel me-1"></i>Filtrer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total</span>
                            <h5 class="fw-bold mb-0 mt-1">{{ stats.total }}</h5>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-building text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Actifs</span>
                            <h5 class="fw-bold mb-0 mt-1 text-success">{{ stats.actifs }}</h5>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Annulés</span>
                            <h5 class="fw-bold mb-0 mt-1 text-danger">{{ stats.annules }}</h5>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">CA Mensuel</span>
                            <h5 class="fw-bold mb-0 mt-1 text-primary">{{ stats.ca|number_format(2, ',', ' ') }} €</h5>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-euro text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Entreprise</th>
                            <th class="py-3">Plan</th>
                            <th class="py-3 text-end">Prix/Mois</th>
                            <th class="py-3 text-center">Prochaine Facturation</th>
                            <th class="py-3 text-center pe-3">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for entreprise in pagination %}
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-2">
                                {% if entreprise.logo %}
                                    <img src="{{ asset('uploads/logos/'~entreprise.logo) }}" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;">
                                {% else %}
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:36px;height:36px;font-size:13px;">
                                        {{ entreprise.nom|slice(0,2)|upper }}
                                    </div>
                                {% endif %}
                                <div>
                                    <div class="fw-semibold">{{ entreprise.nom }}</div>
                                    <div class="text-muted small">{{ entreprise.email }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">{{ entreprise.plan|capitalize }}</span>
                        </td>
                        <td class="text-end fw-semibold">{{ entreprise.prixMois|default(0) }} €</td>
                        <td class="text-center">{{ entreprise.dateFinAbonnement ? entreprise.dateFinAbonnement|date('d/m/Y') : '-' }}</td>
                        <td class="text-center pe-3">
                            {% set color = entreprise.status == 'active' ? 'success' : (entreprise.status == 'canceled' ? 'danger' : 'warning') %}
                            {% set icon = entreprise.status == 'active' ? 'bi-check-circle-fill' : (entreprise.status == 'canceled' ? 'bi-x-circle-fill' : 'bi-clock-history') %}
                            <span class="badge bg-{{ color }}-subtle text-{{ color }} rounded-pill px-3 py-2">
                                <i class="bi {{ icon }} me-1"></i>{{ entreprise.status|capitalize }}
                            </span>
                        </td>
                    </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center p-5">
                                <i class="bi bi-search text-muted fs-2 d-block mb-2"></i>
                                <h6 class="fw-bold">Aucune entreprise trouvée</h6>
                                <p class="text-muted small mb-0">Essayez de modifier vos filtres de recherche</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>{{ pagination.getTotalItemCount }} abonnements au total
            </small>
            <div>
                {{ knp_pagination_render(pagination, null, app.request.query.all) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
