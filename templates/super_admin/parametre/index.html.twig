{% extends "layouts/base_super_admin.html.twig" %}

{% block title %}Administration - Paramètres Système{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-0">
                Administration Système
            </h1>
            <p class="text-muted small mb-0">Gérez les paramètres, templates et logs de la plateforme</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary bg-opacity-10 text-secondary d-flex align-items-center px-3">
                <i class="bi bi-clock-history me-2"></i>Dernière mise à jour : {{ "now"|date("d/m/Y H:i") }}
            </span>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="connexions-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#connexions"
                    type="button"
                    role="tab"
                    aria-controls="connexions"
                    aria-selected="true">
                <i class="bi bi-box-arrow-in-right me-2"></i>Connexions
                <span class="badge bg-danger ms-2">156</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="erreurs-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#erreurs"
                    type="button"
                    role="tab"
                    aria-controls="erreurs"
                    aria-selected="false">
                <i class="bi bi-exclamation-triangle me-2"></i>Logs Erreurs
                <span class="badge bg-warning ms-2">342</span>
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="adminTabsContent">

        <!-- TAB 4: CONNEXIONS -->
        <div class="tab-pane fade show active" id="connexions" role="tabpanel" aria-labelledby="connexions-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-box-arrow-in-right text-primary me-2"></i>Historique des Connexions
                    </h5>
                    <small class="text-muted">Suivez toutes les connexions des utilisateurs</small>
                </div>
                <button class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-2"></i>Exporter
                </button>
            </div>

            <!-- Filtres Connexions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Date de début</label>
                            <input type="date" class="form-control" value="2026-07-01">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Date de fin</label>
                            <input type="date" class="form-control" value="2026-07-15">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Statut</label>
                            <select class="form-select">
                                <option value="">Tous</option>
                                <option value="success">Succès</option>
                                <option value="failed">Échec</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100 mt-2">
                                <i class="bi bi-funnel me-1"></i>Filtrer
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tableau des connexions -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Date</th>
                                    <th class="py-3">Email</th>
                                    <th class="py-3">Entreprise</th>
                                    <th class="py-3">IP</th>
                                    <th class="py-3 text-center">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">
                                        <span class="fw-semibold">15/07/2026</span>
                                        <span class="text-muted small d-block">14:32:18</span>
                                    </td>
                                    <td>jean.dupont@techinnovate.com</td>
                                    <td>TechInnovate</td>
                                    <td><code>192.168.1.45</code></td>
                                    <td class="text-center">
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>Succès
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage de 1 à 6 sur 156 connexions
                    </small>
                    <nav aria-label="Pagination des connexions">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- TAB 5: ERREURS -->
        <div class="tab-pane fade" id="erreurs" role="tabpanel" aria-labelledby="erreurs-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>Logs Système
                    </h5>
                    <small class="text-muted">Suivez les erreurs et événements système</small>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-download me-2"></i>Exporter
                    </button>
                    <button class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-repeat me-2"></i>Rafraîchir
                    </button>
                </div>
            </div>

            <!-- Alerte dernière erreur critique -->
            <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between" role="alert">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-bug text-danger fs-4"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading fw-bold mb-0">Dernière erreur critique</h5>
                        <p class="mb-0 small"><strong>Message :</strong> Database connection timeout on production server</p>
                        <p class="mb-0 small text-muted">Fichier : /src/Repository/UserRepository.php • Ligne 42 • 15/07/2026 14:32:18</p>
                    </div>
                </div>
                <div>
                    <span class="badge bg-danger">Critique</span>
                </div>
            </div>

            <!-- Filtres Erreurs -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-3">
                            <div class="position-relative">
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                <input type="text" class="form-control ps-5" placeholder="Rechercher..." aria-label="Rechercher">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select">
                                <option value="">Tous les niveaux</option>
                                <option value="critical">Critique</option>
                                <option value="error">Erreur</option>
                                <option value="warning">Avertissement</option>
                                <option value="info">Info</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select">
                                <option value="">Tous les fichiers</option>
                                <option value="controller">Controller</option>
                                <option value="repository">Repository</option>
                                <option value="service">Service</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100">
                                <i class="bi bi-funnel me-1"></i>Filtrer
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tableau des erreurs -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Date</th>
                                    <th class="py-3">Niveau</th>
                                    <th class="py-3">Message</th>
                                    <th class="py-3 pe-3">Fichier</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-danger">
                                    <td class="ps-3">
                                        <span class="fw-semibold">15/07/2026</span>
                                        <span class="text-muted small d-block">14:32:18</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-circle me-1"></i>Critique
                                        </span>
                                    </td>
                                    <td>Database connection timeout on production server</td>
                                    <td class="pe-3">
                                        <code class="small">UserRepository.php:42</code>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination -->
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Affichage de 1 à 6 sur 342 logs
                    </small>
                    <nav aria-label="Pagination des logs">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
        padding: 10px 20px;
    }

    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }

    .nav-tabs .nav-link .badge {
        font-size: 10px;
        padding: 3px 8px;
    }

    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }

    .tab-pane {
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
