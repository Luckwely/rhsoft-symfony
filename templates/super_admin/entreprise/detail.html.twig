{% extends "layouts/base_super_admin.html.twig" %}

{% block title %}Détails Entreprise - RH Soft SARL{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Tableau de bord</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_super_admin_entreprise') }}" class="text-decoration-none">Entreprises</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Détails de l'entreprise: {{ entreprise.nom }}</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">
                {{ entreprise.nom }}
            </h1>
            <p class="text-muted small mb-0">
                #Id-{{ entreprise.id }} • Créée le {{ entreprise.createdAt|date('d/m/Y') }}
                <!--{% set status = entreprise.status|default('inactif') %}
                {% set color = status == 'active'? 'success' : (status == 'suspendu'? 'warning' : (status == 'essai'? 'info' : 'danger')) %}
                <span class="badge bg-{{ color }} ms-1">
                    <i class="bi bi-check-circle-fill me-1"></i>{{ status|capitalize }}
                </span>-->
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_super_admin_entreprise') }}">
                <button class="btn btn-secondary">
                    <i class="bi bi-box-arrow-left me-2"></i>Retour
                </button>
            </a>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="entrepriseTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4 {{ activeTab == 'info' ? 'active' : '' }}"
                    id="info-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#info"
                    type="button"
                    role="tab">
                <i class="bi bi-info-circle me-2"></i>Infos
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4 {{ activeTab == 'users' ? 'active' : '' }}"
                    id="users-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#users"
                    type="button"
                    role="tab">
                <i class="bi bi-people me-2"></i>Utilisateurs <span class="badge bg-primary ms-2">{{ nbUsers }}</span>
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="entrepriseTabsContent">

        <!-- TAB 1: Infos -->
        <div class="tab-pane fade {{ activeTab == 'info' ? 'show active' : '' }}" id="info" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                Informations Générales
                            </h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 fw-semibold">Nom de l'entreprise</dt>
                                <dd class="col-sm-8">{{ entreprise.nom }}</dd>

                                <dt class="col-sm-4 fw-semibold">SIRET</dt>
                                <dd class="col-sm-8">{{ entreprise.nif }}</dd>

                                <dt class="col-sm-4 fw-semibold">Email</dt>
                                <dd class="col-sm-8">{{ entreprise.email }}</dd>

                                <dt class="col-sm-4 fw-semibold">Téléphone</dt>
                                <dd class="col-sm-8">{{ entreprise.tel }}</dd>

                                <dt class="col-sm-4 fw-semibold">Adresse</dt>
                                <dd class="col-sm-8">{{ entreprise.adresse }}</dd>

                                <dt class="col-sm-4 fw-semibold">Plan</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-primary bg-opacity-10 text-primary">{{ entreprise.plan }}</span>
                                </dd>

                                <dt class="col-sm-4 fw-semibold">Date d'inscription</dt>
                                <dd class="col-sm-8">{{ entreprise.createdAt|date('d/m/Y') }}</dd>

                                <dt class="col-sm-4 fw-semibold">Utilisateurs</dt>
                                <dd class="col-sm-8">
                                    {% set max = entreprise.maxUsers|default(500) %}
                                    {% set color = nbUsers >= max ? 'danger' : (nbUsers / max > 0.8 ? 'warning' : 'success') %}

                                    <span class="badge bg-{{ color }} bg-opacity-10 text-{{ color }}">
                                        {{ nbUsers }}
                                    </span>
                                </dd>

                                <dt class="col-sm-4 fw-semibold">Statut</dt>
                                <dd class="col-sm-8">
                                    {% set status = entreprise.status|default('inactif') %}
                                    {% set color = status == 'active'? 'success' : (status == 'suspendu'? 'warning' : (status == 'essai'? 'info' : 'danger')) %}
                                    <span class="badge bg-{{ color }}">
                                        <i class="bi bi-check-circle-fill me-1"></i>{{ status }}
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0 text-center">
                                Gérant
                            </h5>
                        </div>
                        <div class="card-body text-center">
                        {% if admin %}
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mx-auto text-white fw-bold"
                                 style="width: 80px; height: 80px; font-size: 28px;">
                                {% if admin.photo %}
                                <img src="{{ asset('uploads/avatars/' ~ admin.photo) }}" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                            {% else %}
                                {{ admin.prenom|slice(0,1)|upper ~ admin.nom|slice(0,1)|upper }}
                            {% endif %}
                            </div>
                            <h5 class="fw-bold mt-3 mb-1">{{ admin.prenom }} {{ admin.nom }}</h5>
                            <p class="text-muted small">{{ admin.email }}</p>
                            <span class="badge bg-primary">Administrateur</span>

                        {% else %}
                            <i class="bi bi-person-x fs-1 text-muted"></i>
                            <p class="text-muted mt-2">Aucun administrateur trouvé</p>
                        {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: Utilisateurs -->
        <div class="tab-pane fade {{ activeTab == 'users' ? 'show active' : '' }}" id="users" role="tabpanel">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-people text-primary me-2"></i>Liste des Utilisateurs
                    </h5>
                </div>
                <!-- Barre de recherche et filtres -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-3">
                    <form method="GET" action="{{ path('app_super_admin_entreprise_details', {id: entreprise.id}) }}">
                        <input type="hidden" name="tab" value="users"> {# <- pour rester sur l'onglet users #}
                        <div class="row g-3 align-items-center">
                            <div class="col-md-5">
                                <div class="position-relative">
                                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                    <input
                                        type="text"
                                        value="{{ app.request.query.get('q') }}"
                                        name="q" class="form-control ps-5" placeholder="Rechercher une employe..." aria-label="Rechercher">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-select">
                                    <option value="">Tous les statuts</option>
                                    <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Actif</option>
                                    <option value="inactif" {{ app.request.query.get('status') == 'inactif' ? 'selected' : '' }}>Inactif</option>
                                    <option value="essai" {{ app.request.query.get('status') == 'essai' ? 'selected' : '' }}>En essai</option>
                                    <option value="suspendu" {{ app.request.query.get('status') == 'suspendu' ? 'selected' : '' }}>Suspendu</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-funnel me-1"></i>Filtrer
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a class="btn btn-outline-secondary w-100" href="{{ path('app_super_admin_entreprise_details', {id: entreprise.id}) }}">
                                    <i class="bi bi-arrow-repeat me-1"></i>Réinitialiser
                                </a>
                            </div>
                        </div>
                        </form>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Nom</th>
                                    <th class="py-3">Email</th>
                                    <th class="py-3 text-center">Rôle</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in pagination %}
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                                {% if user.photo %}
                                                    <img src="{{ asset('uploads/employees/' ~ user.photo) }}" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                                                {% else %}
                                                    {{ user.prenom|slice(0,1)|upper ~ user.nom|slice(0,1)|upper }}
                                                {% endif %}
                                            </div>
                                            <span class="fw-semibold">{{ user.prenom }} {{ user.nom }}</span>
                                        </div>
                                    </td>
                                    <td>{{ user.email }}</td>
                                    <td class="text-center">
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                        {% set role = 'Admin' %}{% set badge = 'primary' %}
                                        {% elseif 'ROLE_RH' in user.roles %}
                                        {% set role = 'RH' %}{% set badge = 'info' %}
                                        {% elseif 'ROLE_MANAGER' in user.roles %}
                                        {% set role = 'Manager' %}{% set badge = 'warning' %}
                                        {% else %}
                                        {% set role = 'Agent' %}{% set badge = 'secondary' %}
                                        {% endif %}
                                        <span class="badge bg-{{ badge }}">{{ role }}</span>
                                    </td>
                                    <td class="text-center pe-3">
                                        {% set statut = user.statut|default('inactif') %} {# <- statut #}
                                        {% set color = statut == 'active' ? 'success' : (statut == 'suspendu' ? 'warning' : (statut == 'essai' ? 'info' : 'danger')) %}
                                        <span class="badge bg-{{ color }} bg-opacity-10 text-{{ color }}">
                                            <i class="bi bi-check-circle-fill me-1"></i>{{ statut|capitalize }}
                                        </span>
                                    </td>
                                </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center p-5">
                                            <i class="bi bi-search text-muted fs-2 d-block mb-2"></i>
                                            <h6 class="fw-bold">Aucune utilisateur trouvée</h6>
                                            <p class="text-muted small mb-0">Essayez de modifier vos filtres de recherche</p>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if pagination.getTotalItemCount > 0 %}
                <div class="card-footer bg-transparent border-0">
                    <small class="text-muted">
                        {% set data = pagination.getPaginationData() %}
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Affichage de {{ data.firstItemNumber }} à {{ data.lastItemNumber }} sur {{ data.totalCount }}
                            </small>
                       {{ knp_pagination_render(pagination, null,
                            {
                                'q': app.request.query.get('q'),
                                'status': app.request.query.get('status'),
                                'tab': 'users'
                            })
                        }}
                    </small>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
