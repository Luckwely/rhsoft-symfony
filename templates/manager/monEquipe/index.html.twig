{% extends "layouts/base_manager.html.twig" %}

{% block title %}Mes Employés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-people text-primary me-2"></i>Mes Employés
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-person-check me-1"></i>Gérez votre équipe et suivez leur activité
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a href="" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter équipe
            </a>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Effectif</span>
                            <h2 class="fw-bold mb-0 mt-1">6</h2>
                            <small class="text-muted">Employés dans l'équipe</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">En congé</span>
                            <h2 class="fw-bold mb-0 mt-1">1</h2>
                            <small class="text-muted">Absent aujourd'hui</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-x text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">En télétravail</span>
                            <h2 class="fw-bold mb-0 mt-1">2</h2>
                            <small class="text-muted">Aujourd'hui</small>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-laptop text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTRES -->
    <div class="card border-0 bg-light rounded-4 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <form class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-semibold small text-muted">Filtre par poste</label>
                    <select class="form-select">
                        <option value="">Tous les postes</option>
                        <option value="dev">Développeur</option>
                        <option value="designer">Designer</option>
                        <option value="manager">Manager</option>
                        <option value="commercial">Commercial</option>
                        <option value="rh">RH</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrer
                    </button>
                    <a href="" class="btn btn-outline-secondary" title="Réinitialiser">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLEAU DES EMPLOYÉS -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle table-borderless mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3 py-3" style="width: 50px;">#</th>
                        <th class="py-3">Employé</th>
                        <th class="py-3">Poste</th>
                        <th class="py-3 text-center">Statut</th>
                        <th class="py-3 text-center">Dernière présence</th>
                        <th class="py-3 text-center pe-3" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Employé 1 -->
                    <tr>
                        <td class="ps-3"><span class="text-muted small">1</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    JD
                                </div>
                                <div>
                                    <div class="fw-semibold">Jean Dupont</div>
                                    <div class="text-muted small">jean.dupont@rhsoft.com</div>
                                </div>
                            </div>
                        </td>
                        <td>Développeur</td>
                        <td class="text-center">
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Présent
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="small">Aujourd'hui 08:30</span>
                        </td>
                        <td class="text-center pe-3">
                            <a href="" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir fiche
                            </a>
                        </td>
                    </tr>

                    <!-- Employé 2 -->
                    <tr>
                        <td class="ps-3"><span class="text-muted small">2</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    MM
                                </div>
                                <div>
                                    <div class="fw-semibold">Marie Martin</div>
                                    <div class="text-muted small">marie.martin@rhsoft.com</div>
                                </div>
                            </div>
                        </td>
                        <td>Designer</td>
                        <td class="text-center">
                            <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                <i class="bi bi-laptop me-1"></i>Télétravail
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="small">Aujourd'hui 09:00</span>
                        </td>
                        <td class="text-center pe-3">
                            <a href="" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir fiche
                            </a>
                        </td>
                    </tr>

                    <!-- Employé 3 -->
                    <tr>
                        <td class="ps-3"><span class="text-muted small">3</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    PD
                                </div>
                                <div>
                                    <div class="fw-semibold">Paul Dubois</div>
                                    <div class="text-muted small">paul.dubois@rhsoft.com</div>
                                </div>
                            </div>
                        </td>
                        <td>Manager</td>
                        <td class="text-center">
                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                <i class="bi bi-calendar-x me-1"></i>En congé
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="small">14/10/2025</span>
                        </td>
                        <td class="text-center pe-3">
                            <a href="" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir fiche
                            </a>
                        </td>
                    </tr>

                    <!-- Employé 4 -->
                    <tr>
                        <td class="ps-3"><span class="text-muted small">4</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    JL
                                </div>
                                <div>
                                    <div class="fw-semibold">Julie Lefèvre</div>
                                    <div class="text-muted small">julie.lefevre@rhsoft.com</div>
                                </div>
                            </div>
                        </td>
                        <td>Commercial</td>
                        <td class="text-center">
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Présent
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="small">Aujourd'hui 08:15</span>
                        </td>
                        <td class="text-center pe-3">
                            <a href="" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir fiche
                            </a>
                        </td>
                    </tr>

                    <!-- Employé 5 -->
                    <tr>
                        <td class="ps-3"><span class="text-muted small">5</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    TB
                                </div>
                                <div>
                                    <div class="fw-semibold">Thomas Bernard</div>
                                    <div class="text-muted small">thomas.bernard@rhsoft.com</div>
                                </div>
                            </div>
                        </td>
                        <td>Développeur</td>
                        <td class="text-center">
                            <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                <i class="bi bi-laptop me-1"></i>Télétravail
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="small">Aujourd'hui 08:45</span>
                        </td>
                        <td class="text-center pe-3">
                            <a href="" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir fiche
                            </a>
                        </td>
                    </tr>

                    <!-- Employé 6 -->
                    <tr>
                        <td class="ps-3"><span class="text-muted small">6</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    SR
                                </div>
                                <div>
                                    <div class="fw-semibold">Sarah Rakoto</div>
                                    <div class="text-muted small">sarah.rakoto@rhsoft.com</div>
                                </div>
                            </div>
                        </td>
                        <td>RH</td>
                        <td class="text-center">
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Présent
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="small">Aujourd'hui 08:00</span>
                        </td>
                        <td class="text-center pe-3">
                            <a href="" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Voir fiche
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>Affichage de 1 à 6 sur 6 employés
            </small>
            <nav aria-label="Pagination">
                <ul class="pagination mb-0">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
