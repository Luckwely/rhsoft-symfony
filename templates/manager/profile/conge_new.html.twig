{% extends 'layouts/base_manager.html.twig' %}

{% block title %}Nouvelle demande de congé{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3" style="max-width: 700px;">
    <div class="mb-4">
        <a href="{{ path('app_manager_profile_solde') }}" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Retour au profil
        </a>
        <h3 class="fw-bold mt-2">
            Demander un congé
        </h3>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.typeConge, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.typeConge, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.typeConge) }}
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateDebut) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateFin) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.motif, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.motif, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                    {{ form_errors(form.motif) }}
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_manager_profile_solde') }}" class="btn btn-light px-4">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-send me-1"></i> Soumettre la demande
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
