{% extends 'layouts/base_manager.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-person-circle text-primary me-2"></i>Mon Profil
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-gear me-1"></i>Gérez vos informations et documents
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; font-size: 16px;">JD</div>
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-semibold">Jean Dupont</span>
                <small class="text-muted">Développeur - Tech</small>
            </div>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="profilTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-solde-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-solde"
                    type="button"
                    role="tab"
                    aria-controls="tab-solde"
                    aria-selected="true">
                <i class="bi bi-calendar-check text-primary me-2"></i>Mon solde congé
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-paie-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-paie"
                    type="button"
                    role="tab"
                    aria-controls="tab-paie"
                    aria-selected="false">
                <i class="bi bi-file-earmark-text text-success me-2"></i>Mes fiches de paie
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="profilTabsContent">

        <!-- ONGLET 1: MON SOLDE CONGÉ -->
        <div class="tab-pane fade show active" id="tab-solde" role="tabpanel" aria-labelledby="tab-solde-btn">
            <!-- CARDS SOLDE -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Solde CP</span>
                                    <h2 class="fw-bold mb-0 mt-1 text-primary">18</h2>
                                    <small class="text-muted">Jours restants</small>
                                </div>
                                <div class="bg-primary-subtle rounded-3 p-3">
                                    <i class="bi bi-umbrella text-primary fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Solde RTT</span>
                                    <h2 class="fw-bold mb-0 mt-1 text-info">5</h2>
                                    <small class="text-muted">Jours restants</small>
                                </div>
                                <div class="bg-info-subtle rounded-3 p-3">
                                    <i class="bi bi-clock text-info fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Pris</span>
                                    <h2 class="fw-bold mb-0 mt-1 text-warning">7</h2>
                                    <small class="text-muted">Jours utilisés</small>
                                </div>
                                <div class="bg-warning-subtle rounded-3 p-3">
                                    <i class="bi bi-calendar-check text-warning fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAU HISTORIQUE CONGÉS -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Historique des congés pris
                    </h5>
                    <button class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>Demander un congé
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Type</th>
                                    <th class="py-3">Période</th>
                                    <th class="py-3 text-center">Durée</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-umbrella me-1"></i>Congé Payé
                                        </span>
                                    </td>
                                    <td>15/07/2025 au 20/07/2025</td>
                                    <td class="text-center"><span class="fw-semibold">5 jours</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>RTT
                                        </span>
                                    </td>
                                    <td>10/08/2025</td>
                                    <td class="text-center"><span class="fw-semibold">1 jour</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-umbrella me-1"></i>Congé Payé
                                        </span>
                                    </td>
                                    <td>22/09/2025</td>
                                    <td class="text-center"><span class="fw-semibold">1 jour</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>3 congés pris sur 12 mois
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: MES FICHES DE PAIE -->
        <div class="tab-pane fade" id="tab-paie" role="tabpanel" aria-labelledby="tab-paie-btn">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-wallet2 text-success me-2"></i>Mes fiches de paie
                    </h5>
                    <button class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-download me-1"></i>Télécharger toutes
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Mois</th>
                                    <th class="py-3 text-end">Salaire Brut</th>
                                    <th class="py-3 text-end">Cotisations</th>
                                    <th class="py-3 text-end">Salaire Net</th>
                                    <th class="py-3 text-center pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Octobre 2025</span></td>
                                    <td class="text-end">2 800 €</td>
                                    <td class="text-end text-danger">-840 €</td>
                                    <td class="text-end fw-bold text-success">1 960 €</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                            <i class="bi bi-download me-1"></i>PDF
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Septembre 2025</span></td>
                                    <td class="text-end">2 800 €</td>
                                    <td class="text-end text-danger">-840 €</td>
                                    <td class="text-end fw-bold text-success">1 960 €</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                            <i class="bi bi-download me-1"></i>PDF
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Août 2025</span></td>
                                    <td class="text-end">2 800 €</td>
                                    <td class="text-end text-danger">-840 €</td>
                                    <td class="text-end fw-bold text-success">1 960 €</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                            <i class="bi bi-download me-1"></i>PDF
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Juillet 2025</span></td>
                                    <td class="text-end">2 800 €</td>
                                    <td class="text-end text-danger">-840 €</td>
                                    <td class="text-end fw-bold text-success">1 960 €</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                            <i class="bi bi-download me-1"></i>PDF
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Juin 2025</span></td>
                                    <td class="text-end">2 800 €</td>
                                    <td class="text-end text-danger">-840 €</td>
                                    <td class="text-end fw-bold text-success">1 960 €</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                            <i class="bi bi-download me-1"></i>PDF
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">Mai 2025</span></td>
                                    <td class="text-end">2 800 €</td>
                                    <td class="text-end text-danger">-840 €</td>
                                    <td class="text-end fw-bold text-success">1 960 €</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Télécharger PDF">
                                            <i class="bi bi-download me-1"></i>PDF
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>6 fiches de paie disponibles
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
