{% extends 'layouts/base_manager.html.twig' %}

{% block title %}Gestion des Demandes{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Gestion des Demandes
            </h3>
            <p class="text-muted mb-0">
                Validez les demandes de vos équipes
            </p>
        </div>
    </div>

    <!-- ONGLET 1: CONGES A VALIDER -->
    <div class="card border-0 shadow-sm rounded-4">
        <!-- FILTRES -->
        <form method="get" class="d-flex gap-2 flex-wrap">
            <select name="type" class="form-select form-select-sm" style="max-width: 200px; flex: 1 1 160px;" onchange="this.form.submit()">
                <option value="">Tous les types</option>
                {% for type in ['paye','rtt','maladie','sans_solde'] %}
                    <option value="{{ type }}" {{ currentType == type ? 'selected' : '' }}>{{ type|capitalize }}</option>
                {% endfor %}
            </select>
            <div class="position-relative" style="max-width: 250px; flex: 1 1 200px;">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" name="search" value="{{ currentSearch }}" class="form-control form-control-sm ps-5" placeholder="Rechercher un employé..." onkeyup="if(event.key==='Enter'){this.form.submit()}">
            </div>
        </form>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Employé</th>
                            <th class="py-3">Type</th>
                            <th class="py-3">Période</th>
                            <th class="py-3 text-center">Durée</th>
                            <th class="py-3 text-center">Solde restant</th>
                            <th class="py-3 text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for conge in demandes %}
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                        {{ conge.employee.prenom|first }}{{ conge.employee.nom|first }}
                                    </div>
                                    <div>
                                        <div class="fw-semibold">{{ conge.employee.nom }} {{ conge.employee.prenom }}</div>
                                        <small class="text-muted">{{ conge.employee.poste ?? 'N/A' }}</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">{{ conge.typeConge.nom }}</span></td>
                            <td>{{ conge.dateDebut|date('d/m/Y') }} au {{ conge.dateFin|date('d/m/Y') }}</td>
                            <td class="text-center"><span class="fw-semibold">{{ conge.nbJours }} jours</span></td>
                            <td class="text-center"><span class="fw-semibold">{{ conge_solde(conge.employee) }} jours</span></td>
                            <td class="text-center pe-3">
                                <form method="post" action="{{ path('app_manager_conge_valider', {id: conge.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('manager_conge_valider_' ~ conge.id) }}">
                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Valider</button>
                                </form>
                                <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#refusModal{{ conge.id }}">
                                    <i class="bi bi-x-lg me-1"></i>Refuser
                                </button>
                            </td>
                        </tr>

                        <!-- Modal Refus -->
                        <div class="modal fade" id="refusModal{{ conge.id }}" tabindex="-1">
                        <div class="modal-dialog">
                            <form method="post" action="{{ path('app_manager_conge_refuser', {id: conge.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('manager_conge_refuser_' ~ conge.id) }}">
                            <div class="modal-content">
                                <div class="modal-header"><h5>Refuser le congé</h5></div>
                                <div class="modal-body">
                                <textarea name="motif" class="form-control" placeholder="Motif du refus..." required></textarea>
                                </div>
                                <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-danger">Confirmer le refus</button>
                                </div>
                            </div>
                            </form>
                        </div>
                        </div>

                        {% else %}
                        <tr><td colspan="6" class="text-center py-4">Aucune demande en attente</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>{{ demandes.getTotalItemCount }} demande(s) en attente de validation
            </small>
            {% if demandes.getPageCount > 1 %}
                {{ knp_pagination_render(demandes) }}
            {% endif %}
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
