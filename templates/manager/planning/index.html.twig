                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Commentaire</label>
                            <textarea class="form-control" rows="3" placeholder="Informations complémentaires sur ce shift..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
