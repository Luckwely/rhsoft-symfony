{% extends 'layouts/base_manager.html.twig' %}

{% block title %}Tableau de bord manager{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Tableau de bord</h3>
            <p class="text-muted mb-0">Vue d'ensemble de votre équipe et de l'activité du jour</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <span class="text-muted small text-uppercase fw-semibold">Effectif équipe</span>
                    <div class="fs-2 fw-bold mt-2">{{ dashboard.teamSize }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <span class="text-muted small text-uppercase fw-semibold">Présents aujourd'hui</span>
                    <div class="fs-2 fw-bold mt-2">{{ dashboard.presentToday }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <span class="text-muted small text-uppercase fw-semibold">Absents</span>
                    <div class="fs-2 fw-bold mt-2">{{ dashboard.absentToday }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <span class="text-muted small text-uppercase fw-semibold">Retards</span>
                    <div class="fs-2 fw-bold mt-2">{{ dashboard.lateToday }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">Répartition par service</h5>
                    <small class="text-muted">Nombre d'employés par service</small>
                </div>
                <div class="card-body">
                    <canvas id="chartService" height="220"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">Demandes récentes</h5>
                    <small class="text-muted">Dernières pointages enregistrés</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-borderless table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Employé</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for pointage in dashboard.recentPointages %}
                                    <tr>
                                        <td>{{ pointage.employee.nom ~ ' ' ~ pointage.employee.prenom }}</td>
                                        <td>{{ pointage.statut }}</td>
                                        <td>{{ pointage.date ? pointage.date|date('d/m/Y H:i') : '-' }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">Aucun pointage récent</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const labels = [
            {% for service in dashboard.serviceDistribution %}
                '{{ service.service|e('js') }}'{% if not loop.last %}, {% endif %}
            {% endfor %}
        ];
        const data = [
            {% for service in dashboard.serviceDistribution %}
                {{ service.total }}{% if not loop.last %}, {% endif %}
            {% endfor %}
        ];

        const ctx = document.getElementById('chartService');
        if (ctx) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: [
                            'rgba(13,110,253,0.8)',
                            'rgba(25,135,84,0.8)',
                            'rgba(255,193,7,0.8)',
                            'rgba(13,202,240,0.8)',
                            'rgba(220,53,69,0.8)',
                            'rgba(108,117,125,0.8)'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    },
                    cutout: '70%'
                }
            });
        }
    });
</script>
{% endblock %}
