{% extends 'layouts/base_manager.html.twig' %}

{% block title %}Suivi des Pointages{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    {% include 'manager/pointage/_mon_pointage.html.twig' %}

    <!-- 1. HEADER STICKY -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Valider les Pointages de l'équipe</h3>
            <p class="text-muted mb-0">
                Vérifiez et validez les pointages de votre équipe
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0 flex-wrap">
            <form method="GET" action="{{ path('app_manager_pointage') }}" class="d-inline-flex">
                <input type="date" name="date" class="form-control form-control-sm" value="{{ date|date('Y-m-d') }}" style="max-width: 160px;" onchange="this.form.submit()">
                {% if service is defined and service %}<input type="hidden" name="service" value="{{ service }}">{% endif %}
                {% if status is defined and status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
                {% if q is defined and q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
            </form>

            <a href="{{ path('app_manager_pointage_export', {date: date|date('Y-m-d'), status: status, service: service, q: q}) }}" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter
            </a>

            {% if not isValide %}
                <button type="submit" form="genererForm" class="btn btn-success btn-sm">
                    <i class="bi bi-magic me-1"></i>Préparer les pointages
                </button>
                <a href="{{ path('app_manager_pointage_valider', {date: date|date('Y-m-d')}) }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-check2-circle me-1"></i>Valider
                </a>
            {% endif %}
        </div>
    </div>

    <form id="genererForm" method="POST" action="{{ path('app_manager_pointage_generer') }}" class="d-none">
        <input type="hidden" name="token" value="{{ csrf_token('generer_pointage') }}">
        <input type="hidden" name="date" value="{{ date|date('Y-m-d') }}">
    </form>

    <!-- 2. CARDS STATS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <a href="{{ path('app_manager_pointage', {status: 'present', date: date|date('Y-m-d')}) }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 h-100 hover-shadow">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Présents</span>
                                <h2 class="fw-bold mb-0 mt-1 text-success">{{ stats.present }}</h2>
                            </div>
                            <div class="bg-success bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-person-check text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a href="{{ path('app_manager_pointage', {status: 'retard', date: date|date('Y-m-d')}) }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 h-100 hover-shadow">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">En Retard</span>
                                <h2 class="fw-bold mb-0 mt-1 text-warning">{{ stats.retard }}</h2>
                            </div>
                            <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-clock text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a href="{{ path('app_manager_pointage', {status: 'absent', date: date|date('Y-m-d')}) }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 h-100 hover-shadow">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Absents</span>
                                <h2 class="fw-bold mb-0 mt-1 text-danger">{{ stats.absent }}</h2>
                            </div>
                            <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-person-x text-danger fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a href="{{ path('app_manager_pointage', {status: 'conge', date: date|date('Y-m-d')}) }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 h-100 hover-shadow">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">En Congé</span>
                                <h2 class="fw-bold mb-0 mt-1 text-info">{{ stats.conge }}</h2>
                            </div>
                            <div class="bg-info bg-opacity-10 rounded-3 p-3">
                                <i class="bi bi-calendar-x text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- 3. FILTRES -->
    <div class="card border-0 bg-light rounded-4 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="GET" action="{{ path('app_manager_pointage') }}" class="row g-3 align-items-center">
                <input type="hidden" name="date" value="{{ date|date('Y-m-d') }}">
                <div class="col-md-3">
                    <select name="service" class="form-select form-select-sm">
                        <option value="">Tous les services</option>
                        {% for s in services %}
                            <option value="{{ s.service }}" {{ service == s.service ? 'selected' : '' }}>{{ s.service|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">Tous les statuts</option>
                        <option value="present" {{ status == 'present' ? 'selected' : '' }}>Présent</option>
                        <option value="retard" {{ status == 'retard' ? 'selected' : '' }}>En Retard</option>
                        <option value="absent" {{ status == 'absent' ? 'selected' : '' }}>Absent</option>
                        <option value="conge" {{ status == 'conge' ? 'selected' : '' }}>En Congé</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" name="q" class="form-control form-control-sm ps-5" placeholder="Nom, prénom..." value="{{ q }}">
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filtrer</button>
                    <a href="{{ path('app_manager_pointage', {date: date|date('Y-m-d')}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. TABLEAU DESKTOP -->
    <div class="d-none d-lg-block">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light sticky-top" style="top: 0; z-index: 10;">
                        <tr>
                            <th class="ps-3 py-3" style="width: 50px;">#</th>
                            <th class="py-3">Employé</th>
                            <th class="py-3 text-center">Entrée</th>
                            <th class="py-3 text-center">Sortie</th>
                            <th class="py-3 text-center">Heures</th>
                            <th class="py-3 text-center">H.Sup</th>
                            <th class="py-3 text-center">Statut</th>
                            <th class="py-3 text-center pe-3" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for pointage in pointages %}
                    <tr class="{{ pointage.statutEffectif == 'absent' ? 'table-danger' : (pointage.statutEffectif == 'retard' ? 'table-warning' : '') }}">
                        <td class="ps-3"><span class="text-muted small">{{ loop.index }}</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                    {{ pointage.employee.prenom|first|upper }}{{ pointage.employee.nom|first|upper }}
                                </div>
                                <div>
                                    <div class="fw-semibold">{{ pointage.employee.prenom }} {{ pointage.employee.nom }}</div>
                                    <div class="text-muted small">{{ pointage.employee.poste }}</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold {{ pointage.statutEffectif == 'retard' ? 'text-warning' : '' }}">
                                {{ pointage.heureEntree ? pointage.heureEntree|date('H:i') : '-' }}
                            </span>
                            {% if pointage.heurePrevueDebut %}
                                <small class="d-block text-muted">Prévu {{ pointage.heurePrevueDebut|date('H:i') }}</small>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">
                                {{ pointage.heureSortie ? pointage.heureSortie|date('H:i') : '-' }}
                            </span>
                            {% if pointage.heurePrevueFin %}
                                <small class="d-block text-muted">Prévu {{ pointage.heurePrevueFin|date('H:i') }}</small>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <span class="fw-semibold">
                                {{ pointage.heuresTravaillees }}h
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="fw-bold text-success">
                                {{ pointage.heuresSup > 0 ? '+'~pointage.heuresSup~'h' : '-' }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-{{ pointage.statutEffectif == 'present' ? 'success' : (pointage.statutEffectif == 'retard' ? 'warning' : (pointage.statutEffectif == 'absent' ? 'danger' : 'info')) }}-subtle text-{{ pointage.statutEffectif == 'present' ? 'success' : (pointage.statutEffectif == 'retard' ? 'warning' : (pointage.statutEffectif == 'absent' ? 'danger' : 'info')) }} rounded-pill px-3 py-2">
                                <i class="bi bi-{{ pointage.statutEffectif == 'present' ? 'check-circle-fill' : (pointage.statutEffectif == 'retard' ? 'clock-fill' : (pointage.statutEffectif == 'absent' ? 'x-circle-fill' : 'calendar-x-fill')) }} me-1"></i>{{ pointage.statutLabel }}
                            </span>
                        </td>
                        <td class="text-center pe-3">
                            {% if not isValide %}
                            <button class="btn btn-sm btn-light border-0 rounded-3" data-bs-toggle="modal" data-bs-target="#modal{{ pointage.id }}">
                                <i class="bi bi-pencil"></i>
                            </button>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Aucun pointage pour cette date
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Affichage de {{ pointages|length }} pointages
                </small>
                {# Ensure knp_pagination bundle is installed if using this #}
                {% if knp_pagination_render is defined and pointages is not empty %}
                    {{ knp_pagination_render(pointages) }}
                {% endif %}
            </div>
        </div>
    </div>

    <!-- 5. VUE MOBILE CARDS -->
    <div class="d-lg-none">
        {% for pointage in pointages %}
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                            {{ pointage.employee.prenom|first|upper }}{{ pointage.employee.nom|first|upper }}
                        </div>
                        <div>
                            <div class="fw-semibold">
                                {{ pointage.employee.prenom }} {{ pointage.employee.nom }}
                            </div>
                            <div class="text-muted small">
                                {{ pointage.employee.poste }}
                            </div>
                        </div>
                    </div>
                    <span class="badge bg-{{ pointage.statutEffectif == 'present' ? 'success' : (pointage.statutEffectif == 'retard' ? 'warning' : (pointage.statutEffectif == 'absent' ? 'danger' : 'info')) }}-subtle text-{{ pointage.statutEffectif == 'present' ? 'success' : (pointage.statutEffectif == 'retard' ? 'warning' : (pointage.statutEffectif == 'absent' ? 'danger' : 'info')) }} rounded-pill px-3 py-2">
                        {{ pointage.statutLabel }}
                    </span>
                </div>

                <div class="row text-center g-2">
                    <div class="col-3">
                        <span class="text-muted small d-block">Entrée</span>
                        <span class="fw-semibold {{ pointage.statutEffectif == 'retard' ? 'text-warning' : '' }}">
                            {{ pointage.heureEntree ? pointage.heureEntree|date('H:i') : '-' }}
                        </span>
                        {% if pointage.heurePrevueDebut %}<small class="d-block text-muted">Prévu {{ pointage.heurePrevueDebut|date('H:i') }}</small>{% endif %}
                    </div>
                    <div class="col-3">
                        <span class="text-muted small d-block">Sortie</span>
                        <span class="fw-semibold">
                            {{ pointage.heureSortie ? pointage.heureSortie|date('H:i') : '-' }}
                        </span>
                        {% if pointage.heurePrevueFin %}<small class="d-block text-muted">Prévu {{ pointage.heurePrevueFin|date('H:i') }}</small>{% endif %}
                    </div>
                    <div class="col-3">
                        <span class="text-muted small d-block">Total</span>
                        <span class="fw-semibold">
                            {{ pointage.heuresTravaillees }}h
                        </span>
                    </div>
                    <div class="col-3">
                        <span class="text-muted small d-block">H.Sup</span>
                        <span class="fw-bold text-success">
                            {{ pointage.heuresSup > 0 ? '+'~pointage.heuresSup~'h' : '-' }}
                        </span>
                    </div>
                </div>
                {% if not isValide %}
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-outline-primary btn-sm flex-grow-1" data-bs-toggle="modal" data-bs-target="#modal{{ pointage.id }}">
                        <i class="bi bi-pencil me-1"></i>Corriger
                    </button>
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- 7. LEGENDE -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <span class="fw-semibold small">Légende :</span>
                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Présent</span>
                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">En Retard</span>
                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">Absent</span>
                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">En Congé</span>
            </div>
        </div>
    </div>

    <!-- 6. MODALS CORRIGER -->
    {% for pointage in pointages %}
    <div class="modal fade" id="modal{{ pointage.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="POST" action="{{ path('app_manager_pointage_corriger', {id: pointage.id}) }}" class="modal-content border-0 rounded-4 shadow-lg">
                <input type="hidden" name="token" value="{{ csrf_token('corriger_pointage_' ~ pointage.id) }}">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square text-primary me-2"></i>
                        Corriger: {{ pointage.employee.prenom }} {{ pointage.employee.nom }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Date</label>
                        <input type="date" name="date" class="form-control" value="{{ date|date('Y-m-d') }}" readonly>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Heure Entrée</label>
                            <input type="time" name="heureEntree" class="form-control" value="{{ pointage.heureEntree ? pointage.heureEntree|date('H:i') : '' }}">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Heure Sortie</label>
                            <input type="time" name="heureSortie" class="form-control" value="{{ pointage.heureSortie ? pointage.heureSortie|date('H:i') : '' }}">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Motif de correction</label>
                        <textarea name="motif" class="form-control" rows="3" placeholder="Oubli de badge..." required></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="notifier" id="notify{{ pointage.id }}" checked>
                        <label class="form-check-label" for="notify{{ pointage.id }}">
                            <i class="bi bi-envelope me-1"></i>Notifier l'employé
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i>Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
    {% endfor %}

</div>
{% endblock %}
