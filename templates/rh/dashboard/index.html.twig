{% extends "layouts/base_rh.html.twig" %}

{% block title %}Tableau de bord - Administration{% endblock %}

{% block body %}
<div class="container-fluid page-shell">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Tableau de bord
            </h3>
            <p class="text-muted mb-0">
                {{ "now"|date("d/m/Y") }} • Vue d'ensemble de l'activité
            </p>
        </div>
    </div>

    {% with {
        monPointage: dashboard.monPointage,
        planning: dashboard.planning|default(null),
        canPointerEntree: dashboard.canPointerEntree|default(false),
        canPointerSortie: dashboard.canPointerSortie|default(false),
        lateDeadlinePassed: dashboard.lateDeadlinePassed|default(false),
        heureLimitePointage: dashboard.heureLimitePointage|default(null),
        message: dashboard.message|default(null)
    } %}
        {% include 'rh/pointage/_mon_pointage.html.twig' %}
    {% endwith %}

    <!-- 4 KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Effectif</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.totalEmployees|default(0) }}</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Congés en attente</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.pendingLeaves|default(0) }}</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Absences aujourd'hui</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.absentToday|default(0) }}</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Retards aujourd'hui</span>
                            <h2 class="fw-bold mb-0 mt-1">{{ dashboard.lateToday|default(0) }}</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-file-earmark-person text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTIVITE RECENTE & ACTIONS RAPIDES -->
    <div class="row g-4">
        <!-- Card: Activité récente -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0">
                            Activité récente
                        </h5>
                        <small class="text-muted">Dernières actions sur la plateforme</small>
                    </div>
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('app_rh_pointage', {date: 'now'|date('Y-m-d')}) }}">
                        <i class="bi bi-arrow-right me-1"></i>Voir tout
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        {% for activity in dashboard.recentActivity %}
                            <div class="list-group-item border-0 d-flex align-items-center gap-3 py-3">
                                <div class="{{ activity.iconBg }} bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-{{ activity.icon }} {{ activity.iconBg|replace({'bg-': 'text-'}) }} fs-5"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">{{ activity.employee.prenom }} {{ activity.employee.nom }}</div>
                                    <div class="text-muted small">{{ activity.message }}</div>
                                </div>
                                <span class="badge {{ activity.badgeClass }} small">{{ activity.badgeLabel }}</span>
                            </div>
                        {% else %}
                            <div class="list-group-item border-0 py-4 text-center text-muted">
                                Aucune activité récente
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Card: Actions Rapides -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        Actions Rapides
                    </h5>
                    <small class="text-muted">Accédez aux tâches courantes</small>
                </div>
                <div class="card-body">
                    <a href="{{ path('app_rh_employee_embauche') }}" class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2 text-decoration-none text-reset">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;"><i class="bi bi-person-plus text-primary fs-5"></i></div>
                        <div class="flex-grow-1"><div class="fw-semibold">Inviter un employé</div><div class="text-muted small">Créer un dossier et envoyer une invitation</div></div><i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a href="{{ path('app_rh_offre_new') }}" class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2 text-decoration-none text-reset">
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;"><i class="bi bi-briefcase text-success fs-5"></i></div>
                        <div class="flex-grow-1"><div class="fw-semibold">Nouvelle offre d’emploi</div><div class="text-muted small">Publier une annonce de recrutement</div></div><i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a href="{{ path('app_rh_pointage', {date: 'now'|date('Y-m-d')}) }}" class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2 text-decoration-none text-reset">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;"><i class="bi bi-clock text-warning fs-5"></i></div>
                        <div class="flex-grow-1"><div class="fw-semibold">Gérer les pointages</div><div class="text-muted small">{{ dashboard.presentToday|default(0) }} présent(s) · {{ dashboard.lateToday|default(0) }} retard(s) aujourd’hui</div></div><i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a href="{{ path('app_rh_rapport') }}" class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 text-decoration-none text-reset">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;"><i class="bi bi-graph-up text-info fs-5"></i></div>
                        <div class="flex-grow-1"><div class="fw-semibold">Générer un rapport</div><div class="text-muted small">Consulter le rapport RH dynamique</div></div><i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <div class="text-center text-muted small">
                        <i class="bi bi-arrow-repeat me-1"></i>Dernière mise à jour : {{ "now"|date("H:i") }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
