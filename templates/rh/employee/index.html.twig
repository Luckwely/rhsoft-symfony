                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" title="Éditer">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>

                                <!-- Ligne 4 -->
                                <tr data-service="Compta">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">JL</div>
                                            <div>
                                                <div class="fw-semibold">Julie Leroy</div>
                                                <small class="text-muted">julie@rhsoft.com</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>Comptable</td>
                                    <td><span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2">Compta</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Actif
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-light border-0" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" title="Éditer">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>

                                <!-- Ligne 5 -->
                                <tr data-service="Tech">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">AL</div>
                                            <div>
                                                <div class="fw-semibold">Antoine Lefevre</div>
                                                <small class="text-muted">antoine@rhsoft.com</small>
                                            </div>
                                        </div>
