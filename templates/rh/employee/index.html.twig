{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion des Employés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    <!-- FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show border-0 rounded-4 shadow-sm" role="alert">
                <i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Gestion des Employés
        </h3>
        <p class="text-muted mb-0">
            <i class="bi bi-list-check me-1"></i>Gérez vos collaborateurs, embauches et sorties
        </p>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4"  >
        <li class="nav-item">
            <a href="{{ path('app_rh_employee') }}" class="nav-link active border-0 rounded-3 px-4"
                <i class="bi bi-list-ul me-2"></i>Liste des Employés
                <span class="badge bg-primary ms-1">5</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_embauche') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-person-plus text-success me-2"></i>Embauches
                <span class="badge bg-success ms-1">3</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_sortie') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-person-x text-danger me-2"></i>Sorties
                <span class="badge bg-danger ms-1">3</span>
            </a>
        </li>
    </ul>

        <!-- BARRE DE RECHERCHE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" name="q" class="form-control ps-5" placeholder="Rechercher par nom, prénom, email..." value="{{ app.request.query.get('q') }}">
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">
                        <i class="bi bi-search me-1"></i>Rechercher
                    </button>
                    <a href="{{ path('app_admin_employee') }}" class="btn btn-outline-secondary" title="Réinitialiser">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- CONTENU -->
    <form method="post" action="{{ path('app_admin_employee_bulk_delete') }}" id="bulk-form">
        <input type="hidden" name="_token" value="{{ csrf_token('bulk-delete') }}">

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                <div>
                    <span class="fw-semibold">
                        <i class="bi bi-list-ul text-primary me-2"></i>Liste des employés
                    </span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-borderless mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 50px;">Photo</th>
                                <th>{{ knp_pagination_sortable(employees, 'Nom & Prénom', 'u.nom') }}</th>
                                <th>{{ knp_pagination_sortable(employees, 'Email', 'u.email') }}</th>
                                <th style="width: 50px;">Rôle</th>
                                <th>{{ knp_pagination_sortable(employees, 'Statut', 'u.statut') }}</th>
                                <th style="width: 200px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for employee in employees %}
                            <tr>
                                <td>
                                {% if employee.photo %}
                                    <img src="{{ asset('uploads/employees/' ~ employee.photo) }}" width="40" height="40" class="rounded-circle object-fit-cover" style="object-fit:cover;">
                                {% else %}
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;font-size:14px">
                                        {{ employee.prenom|slice(0,1)|upper }}{{ employee.nom|slice(0,1)|upper }}
                                    </div>
                                {% endif %}
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        {{ employee.prenom }} {{ employee.nom }}
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        {{ employee.email }}
                                    </span>
                                </td>
                                <td>
                                {% if 'ROLE_SUPER_ADMIN' in employee.roles %}
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 fs-xs fw-semibold" style="font-size: 0.7rem;">Super Admin</span>
                                {% elseif 'ROLE_ADMIN' in employee.roles %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 fs-xs fw-semibold" style="font-size: 0.7rem;">Admin</span>
                                {% elseif 'ROLE_RH' in employee.roles %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 fs-xs fw-semibold" style="font-size: 0.7rem;">RH</span>
                                {% elseif 'ROLE_MANAGER' in employee.roles %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 fs-xs fw-semibold" style="font-size: 0.7rem;">Manager</span>
                                {% else %}
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 fs-xs fw-semibold" style="font-size: 0.7rem;">Employé</span>
                                {% endif %}
                                </td>
                                <td>
                                {% if employee.isActive %}
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="badge rounded-pill bg-info-subtle text-info px-3 py-2">
                                        <i class="bi bi-clock-history me-1"></i>En attente
                                    </span>
                                {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#details-{{ employee.id }}" title="Voir détails">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a href="{{ path('app_rh_employee_edit', {id: employee.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        {% if not employee.isActive %}
                                            <a href="{{ path('app_rh_resend', {id: employee.id}) }}" class="btn btn-sm btn-outline-info" title="Renvoyer l'invitation">
                                                <i class="bi bi-send"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>

                            <!-- ACCORDION FICHE RH COMPLETE MODERNISEE -->
                            <tr class="collapse" id="details-{{ employee.id }}">
                                <td colspan="7" class="p-0">
                                    <div class="bg-light p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="fw-bold mb-0">
                                                <i class="bi bi-person-badge text-primary me-2"></i>
                                                Fiche Complète: {{ employee.prenom }} {{ employee.nom }}
                                            </h6>
                                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                                ID: #{{ employee.id }}
                                            </span>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-telephone text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Téléphone</small>
                                                            <span class="fw-semibold">{{ employee.telephone ?? 'Non renseigné' }}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-geo-alt text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Adresse</small>
                                                            <span class="fw-semibold">{{ employee.adresse ?? 'Non renseignée' }}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-calendar3 text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Date Embauche</small>
                                                            <span class="fw-semibold">
                                                                {{ employee.dateEmbauche ? employee.dateEmbauche|date('d/m/Y') : 'N/A' }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-clock-history text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Ancienneté</small>
                                                            <span class="fw-semibold">
                                                                {{ employee.dateEmbauche ? date().diff(employee.dateEmbauche).y ~ ' ans' : 'N/A' }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm h-100">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-calendar-check text-primary"></i>
                                                        <div>
                                                            <small class="text-muted d-block">Solde Congé</small>
                                                            <span class="fw-semibold">{{ employee.soldeConge ?? '25' }} jours</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="bg-white rounded-3 p-3 shadow-sm">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-file-earmark-pdf text-danger"></i>
                                                        <div>
                                                            <small class="text-muted d-block">CV</small>
                                                            {% if employee.cv %}
                                                                <a href="{{ asset('uploads/employees/' ~ employee.cv) }}" target="_blank" class="fw-semibold text-primary text-decoration-none">
                                                                    <i class="bi bi-download me-1"></i>Télécharger PDF
                                                                </a>
                                                            {% else %}
                                                                <span class="text-muted">Non renseigné</span>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="bg-white rounded-3 p-3 shadow-sm">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <div>
                                                            <i class="bi bi-calendar-week text-primary me-2"></i>
                                                            <strong>Planning Semaine {{ "now"|date('W') }}</strong>
                                                            <span class="text-muted small ms-2">({{ "now"|date('d/m/Y') }} - {{ "now"|date_modify("+6 days")|date('d/m/Y') }})</span>
                                                        </div>
                                                    </div>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-hover mb-0">
                                                            <thead class="bg-light">
                                                                <tr>
                                                                    <th>Jour</th>
                                                                    <th>Shift</th>
                                                                    <th>Pause</th>
                                                                    <th>Statut</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>

                                                            {% set days = [
                                                                'lundi',
                                                                'mardi',
                                                                'mercredi',
                                                                'jeudi',
                                                                'vendredi',
                                                                'samedi',
                                                                'dimanche'
                                                            ] %}
                                                            {% set dayOrder = {
                                                                lundi:1,
                                                                mardi:2,
                                                                mercredi:3,
                                                                jeudi:4,
                                                                vendredi:5,
                                                                samedi:6,
                                                                dimanche:7
                                                            } %} {# MAP POUR TRIER #}
                                                            {% set monday = "monday this week"|date('Y-m-d') %}
                                                            {% set plannings = employee.plannings|filter(
                                                                p => p.weekStart|date('Y-m-d') == monday
                                                            ) %}

                                                            {% if plannings|length > 0 %}
                                                                {# TRI PAR JOUR AVEC LA MAP #}
                                                            {% set plannings = plannings|sort((a, b) => dayOrder[a.dayOfWeek] <=> dayOrder[b.dayOfWeek]) %}

                                                                {% for p in plannings %}
                                                                <tr class="{{ p.isDayOff ? 'table-info' : '' }}">
                                                                    <td><span class="fw-semibold">{{ p.dayOfWeek|capitalize }}</span></td>
                                                                    <td>
                                                                        {% if p.isDayOff %}
                                                                            <span class="badge bg-info-subtle text-info rounded-pill"><i class="bi bi-calendar-x me-1"></i>Repos</span>
                                                                        {% else %}
                                                                            <span class="text-primary">{{ p.heureDebut|date('H:i') }} - {{ p.heureFin|date('H:i') }}</span>
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ p.pauseMinutes ? p.pauseMinutes ~ ' min' : '-' }}</td>
                                                                    <td>
                                                                        {% if p.isDayOff %}
                                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Repos</span>
                                                                        {% else %}
                                                                            <span class="badge bg-success-subtle text-success rounded-pill">Présent</span>
                                                                        {% endif %}
                                                                    </td>
                                                                </tr>
                                                                {% endfor %}

                                                            {% else %}
                                                                {# DONNEES FACTICES #}
                                                                {% for day in days %}
                                                                <tr>
                                                                    <td><span class="fw-semibold">{{ day|capitalize }}</span></td>
                                                                    <td>
                                                                        {% if day in ['samedi', 'dimanche'] %}
                                                                            <span class="badge bg-info-subtle text-info rounded-pill"><i class="bi bi-calendar-x me-1"></i>Repos</span>
                                                                        {% else %}
                                                                            <span class="text-primary">09:00 - 17:00</span>
                                                                        {% endif %}
                                                                    </td>
                                                                    <td>{{ day in ['samedi', 'dimanche'] ? '-' : '60 min' }}</td>
                                                                    <td>
                                                                        {% if day in ['samedi', 'dimanche'] %}
                                                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Repos</span>
                                                                        {% else %}
                                                                            <span class="badge bg-success-subtle text-success rounded-pill">Présent</span>
                                                                        {% endif %}
                                                                    </td>
                                                                </tr>
                                                                {% endfor %}
                                                            {% endif %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="py-4">
                                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                            <i class="bi bi-people text-muted fs-1"></i>
                                        </div>
                                        <h5 class="fw-bold">Aucun employé trouvé</h5>
                                        <p class="text-muted small">Commencez par ajouter votre premier employé</p>
                                        <a href="{{ path('app_rh_employee_new') }}" class="btn btn-primary">
                                            <i class="bi bi-person-plus me-1"></i>Ajouter un employé
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-transparent border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 py-3">
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    {{ employees.getTotalItemCount }} employés au total
                </div>
                <div>
                    {{ knp_pagination_render(employees) }}
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>


{% endblock %}
