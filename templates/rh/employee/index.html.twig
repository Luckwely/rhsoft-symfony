                                <!-- Ligne 3 -->
                                <tr data-service="Commercial">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">PD</div>
                                            <div>
                                                <div class="fw-semibold">Paul Dubois</div>
                                                <small class="text-muted">paul@rhsoft.com</small>
                                            </div>
                                        </div>
