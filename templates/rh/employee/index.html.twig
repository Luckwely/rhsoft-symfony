                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>5 employés au total
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: EMBAUCHE -->
        <div class="tab-pane fade" id="tab-embauche" role="tabpanel" aria-labelledby="tab-embauche-btn">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-plus text-success me-2"></i>Nouvelle Embauche
                    </h5>
                    <small class="text-muted">Enregistrez un nouvel employé dans la plateforme</small>
                </div>
                <div class="card-body">
                    <form class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Dupont">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Prénom <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Jean">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" placeholder="jean.dupont@email.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Téléphone</label>
                            <input type="tel" class="form-control" placeholder="+261 34 12 345 67">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Poste <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Développeur Frontend">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Service <span class="text-danger">*</span></label>
                            <select class="form-select">
                                <option value="">Sélectionner un service</option>
                                <option value="tech">Tech</option>
                                <option value="commercial">Commercial</option>
                                <option value="rh">RH</option>
                                <option value="compta">Compta</option>
                                <option value="design">Design</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Date d'entrée <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" value="{{ "now"|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Salaire Brut <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" class="form-control" placeholder="2500" step="100">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Type de contrat</label>
                            <select class="form-select">
                                <option value="cdi">CDI</option>
                                <option value="cdd">CDD</option>
                                <option value="stage">Stage</option>
                                <option value="alternance">Alternance</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Période d'essai</label>
                            <select class="form-select">
                                <option value="1">1 mois</option>
                                <option value="2">2 mois</option>
                                <option value="3" selected>3 mois</option>
                                <option value="4">4 mois</option>
                                <option value="6">6 mois</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Notes</label>
                            <textarea class="form-control" rows="3" placeholder="Informations complémentaires..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked>
                                <label class="form-check-label fw-semibold">Envoyer un email de bienvenue</label>
                                <br>
                                <small class="text-muted">L'employé recevra ses identifiants de connexion</small>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-success">
                                <i class="bi bi-check2 me-1"></i>Valider l'embauche
                            </button>
                            <button class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Annuler
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

