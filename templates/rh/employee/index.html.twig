                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-person-x text-danger fs-2 d-block mb-2"></i>
                            <h5 class="fw-bold mb-0">3</h5>
