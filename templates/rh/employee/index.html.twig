{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion des Employés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            <i class="bi bi-people text-primary me-2"></i>Gestion des Employés
        </h3>
        <p class="text-muted mb-0">
            <i class="bi bi-list-check me-1"></i>Gérez vos collaborateurs, embauches et sorties
        </p>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="employeeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-liste-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-liste"
                    type="button"
                    role="tab"
                    aria-controls="tab-liste"
                    aria-selected="true">
                <i class="bi bi-list-ul me-2"></i>Liste des Employés
                <span class="badge bg-primary ms-1">5</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-embauche-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-embauche"
                    type="button"
                    role="tab"
                    aria-controls="tab-embauche"
                    aria-selected="false">
                <i class="bi bi-person-plus text-success me-2"></i>Embauches
                <span class="badge bg-success ms-1">3</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-sortie-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-sortie"
                    type="button"
                    role="tab"
                    aria-controls="tab-sortie"
                    aria-selected="false">
                <i class="bi bi-person-x text-danger me-2"></i>Sorties
                <span class="badge bg-danger ms-1">3</span>
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="employeeTabsContent">

        <!-- ONGLET 1: LISTE + FICHE + DOSSIER -->
