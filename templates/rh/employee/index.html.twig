                                            <div>
                                                <div class="fw-semibold">Lucas Bernard</div>
                                                <small class="text-muted">lucas@rhsoft.com</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>Tech</td>
                                    <td>28/08/2025</td>
                                    <td><span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">Licenciement</span></td>
