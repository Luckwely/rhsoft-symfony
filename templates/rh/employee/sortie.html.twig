{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion des Employés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Gestion des Employés
        </h3>
        <p class="text-muted mb-0">
            <i class="bi bi-list-check me-1"></i>Gérez vos collaborateurs, embauches et sorties
        </p>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a href="{{ path('app_rh_employee') }}" class="nav-link  border-0 rounded-3 px-4"
                <i class="bi bi-list-ul me-2"></i>Liste des Employés
                <span class="badge bg-primary ms-1">5</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_embauche') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-person-plus text-success me-2"></i>Embauches
                <span class="badge bg-success ms-1">3</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_sortie') }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-person-x text-danger me-2"></i>Sorties
                <span class="badge bg-danger ms-1">3</span>
            </a>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-x text-danger me-2"></i>Sorties d'employés
                </h5>
                <small class="text-muted">Historique des départs</small>
            </div>
            <button class="btn btn-outline-danger btn-sm">
                <i class="bi bi-download me-1"></i>Exporter
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3">Employé</th>
                            <th class="py-3">Poste</th>
                            <th class="py-3">Date Sortie</th>
                            <th class="py-3">Motif</th>
                            <th class="py-3 text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">TP</div>
                                    <div>
                                        <div class="fw-semibold">Thomas Petit</div>
                                        <small class="text-muted">thomas@rhsoft.com</small>
                                    </div>
                                </div>
                            </td>
                            <td>Commercial</td>
                            <td>15/09/2025</td>
                            <td><span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">Démission</span></td>
                            <td class="text-center pe-3">
                                <button class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-check me-1"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x me-1"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>Générer certificat
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>3 départs enregistrés
            </small>
            <nav aria-label="Pagination">
                <ul class="pagination mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Stats Sorties -->
    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-person-x text-danger fs-2 d-block mb-2"></i>
                    <h5 class="fw-bold mb-0">3</h5>
                    <small class="text-muted">Départs ce mois</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-text text-primary fs-2 d-block mb-2"></i>
                    <h5 class="fw-bold mb-0">2</h5>
                    <small class="text-muted">Certificats générés</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-clock-history text-warning fs-2 d-block mb-2"></i>
                    <h5 class="fw-bold mb-0">1</h5>
                    <small class="text-muted">En attente</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}

