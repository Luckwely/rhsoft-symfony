{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Fiche employé{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <a href="{{ path('app_rh_employee') }}" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Retour à la liste</a>
            <h3 class="fw-bold mb-1 mt-2">Fiche employé</h3>
            <p class="text-muted mb-0">Informations enregistrées dans l’entreprise.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_rh_employee_edit', {id: employee.id}) }}" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Modifier</a>
            {% if not employee.isActive %}<a href="{{ path('app_rh_employee_resend', {id: employee.id}) }}" class="btn btn-outline-info"><i class="bi bi-send me-1"></i>Renvoyer l’invitation</a>{% endif %}
            {% if employee.dateSortie %}<a href="{{ path('app_rh_employee_certificat', {id: employee.id}) }}" target="_blank" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>Certificat</a>{% endif %}
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body text-center p-4">
                    {% if employee.photo %}<img src="{{ asset('uploads/employees/' ~ employee.photo) }}" class="rounded-circle mb-3" style="width:110px;height:110px;object-fit:cover" alt="Photo de {{ employee.prenom }} {{ employee.nom }}">{% else %}<div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center fw-bold mb-3" style="width:110px;height:110px;font-size:30px">{{ employee.prenom|slice(0,1)|upper }}{{ employee.nom|slice(0,1)|upper }}</div>{% endif %}
                    <h4 class="fw-bold mb-1">{{ employee.prenom }} {{ employee.nom }}</h4>
                    <div class="text-muted">{{ employee.poste|default('Poste non renseigné') }}</div>
                    <div class="mt-3">{% if employee.isActive %}<span class="badge bg-success-subtle text-success rounded-pill">Actif</span>{% else %}<span class="badge bg-warning-subtle text-warning rounded-pill">En attente / inactif</span>{% endif %}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0"><h5 class="fw-bold mb-0"><i class="bi bi-person-vcard text-primary me-2"></i>Informations professionnelles et personnelles</h5></div>
                <div class="card-body"><div class="row g-3">
                    <div class="col-md-6"><small class="text-muted d-block">Email</small><span class="fw-semibold">{{ employee.email }}</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Téléphone</small><span class="fw-semibold">{{ employee.telephone|default('Non renseigné') }}</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Service</small><span class="fw-semibold">{{ employee.service|default('Non renseigné') }}</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Rôle</small><span class="fw-semibold">{{ employee.roles|join(', ') }}</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Date d’embauche</small><span class="fw-semibold">{{ employee.dateEmbauche ? employee.dateEmbauche|date('d/m/Y') : 'Non renseignée' }}</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Solde congé</small><span class="fw-semibold">{{ conge_solde(employee) }} jours</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Genre</small><span class="fw-semibold">{{ employee.genre|default('Non renseigné') }}</span></div>
                    <div class="col-md-6"><small class="text-muted d-block">Date de naissance</small><span class="fw-semibold">{{ employee.dateNaissance ? employee.dateNaissance|date('d/m/Y') : 'Non renseignée' }}</span></div>
                    <div class="col-12"><small class="text-muted d-block">Adresse</small><span class="fw-semibold">{{ employee.adresse|default('Non renseignée') }}</span></div>
                    {% if employee.dateSortie %}<div class="col-md-6"><small class="text-muted d-block">Date de sortie</small><span class="fw-semibold">{{ employee.dateSortie|date('d/m/Y') }}</span></div><div class="col-md-6"><small class="text-muted d-block">Motif de sortie</small><span class="fw-semibold">{{ employee.motifSortie|default('Non renseigné') }}</span></div>{% endif %}
                    <div class="col-12"><small class="text-muted d-block">CV</small>{% if employee.cv %}<a href="{{ asset('uploads/employees/' ~ employee.cv) }}" target="_blank">Télécharger le CV</a>{% else %}<span class="text-muted">Non renseigné</span>{% endif %}</div>
                </div></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
