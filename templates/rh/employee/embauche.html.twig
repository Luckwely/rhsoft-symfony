{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion des Employés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">
            Gestion des Employés
        </h3>
        <p class="text-muted mb-0">
            <i class="bi bi-list-check me-1"></i>Gérez vos collaborateurs, embauches et sorties
        </p>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4">
        <li class="nav-item">
            <a href="{{ path('app_rh_employee') }}" class="nav-link border-0 rounded-3 px-4"
                <i class="bi bi-list-ul me-2"></i>Liste des Employés
                <span class="badge bg-primary ms-1">5</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_embauche') }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-person-plus text-success me-2"></i>Embauches
                <span class="badge bg-success ms-1">3</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_employee_sortie') }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-person-x text-danger me-2"></i>Sorties
                <span class="badge bg-danger ms-1">3</span>
            </a>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-person-plus text-success me-2"></i>Nouvelle Embauche
            </h5>
            <small class="text-muted">Enregistrez un nouvel employé dans la plateforme</small>
        </div>
        <div class="card-body">
            <form class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Dupont">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Prénom <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Jean">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" placeholder="jean.dupont@email.com">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Téléphone</label>
                    <input type="tel" class="form-control" placeholder="+261 34 12 345 67">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Période d'essai</label>
                    <select class="form-select">
                        <option value="3" selected>3 mois</option>
                        <option value="6">6 mois</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Service <span class="text-danger">*</span></label>
                    <select class="form-select">
                        <option value="">Sélectionner un service</option>
                        <option value="tech">Tech</option>
                        <option value="commercial">Commercial</option>
                        <option value="rh">RH</option>
                        <option value="compta">Compta</option>
                        <option value="design">Design</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Date d'entrée <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" value="{{ "now"|date('Y-m-d') }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Salaire Brut <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">€</span>
                        <input type="number" class="form-control" placeholder="2500" step="100">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Type de contrat</label>
                    <select class="form-select">
                        <option value="cdi">CDI</option>
                        <option value="cdd">CDD</option>
                        <option value="stage">Stage</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Notes</label>
                    <textarea class="form-control" rows="3" placeholder="Informations complémentaires..."></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label fw-semibold">Envoyer un email de bienvenue</label>
                        <br>
                        <small class="text-muted">L'employé recevra ses identifiants de connexion</small>
                    </div>
                </div>
                <div class="col-12">
                    <button class="btn btn-success">
                        <i class="bi bi-check2 me-1"></i>Valider l'embauche
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
