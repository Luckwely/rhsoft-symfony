{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Mon Avance{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Mon Avance sur Salaire
            </h3>
            <p class="text-muted mb-0">
                Demandez une avance sur votre salaire
            </p>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row g-4">
        <!-- FORMULAIRE AVANCE -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        Demander une avance
                    </h5>
                    <small class="text-muted">Remplissez le formulaire ci-dessous</small>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="mb-3">
                            {{ form_label(form.montant, 'Montant demandé *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text">Ar</span>
                                {{ form_widget(form.montant, {'attr': {'class': 'form-control', 'placeholder': montantDisponible|number_format(0, ',', ' '), 'min': montantMinimum, 'max': montantDisponible, 'step': '10'}}) }}
                            </div>
                            {% if montantDisponible > 0 %}
                                <small class="text-muted">
                                    Montant disponible : <strong>{{ montantDisponible|number_format(0, ',', ' ') }} Ar</strong>
                                    (plafond {{ plafondPourcentage }}% du salaire de base{% if encours > 0 %}, moins {{ encours|number_format(0, ',', ' ') }} Ar d'avances en cours{% endif %})
                                </small>
                            {% else %}
                                <small class="text-danger">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Vous avez atteint votre plafond d'avance ({{ plafondMontant|number_format(0, ',', ' ') }} Ar). Aucune nouvelle demande possible tant que vos avances en cours ne sont pas remboursées.
                                </small>
                            {% endif %}
                            {{ form_errors(form.montant) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.motif, 'Motif *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.motif, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.motif) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.commentaire, 'Commentaire (optionnel)', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': '3', 'placeholder': 'Précisions complémentaires...'}}) }}
                            {{ form_errors(form.commentaire) }}
                        </div>

                        <button type="submit" class="btn btn-primary w-100"{% if montantDisponible <= 0 %} disabled{% endif %}>
                            <i class="bi bi-send me-2"></i>Envoyer la demande
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <!-- INFOS AVANCE & HISTORIQUE -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        Informations
                    </h5>
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                        <div>
                            <span class="text-muted small">Plafond total</span>
                            <div class="fw-bold text-primary fs-4">{{ plafondMontant|number_format(0, ',', ' ') }} Ar</div>
                        </div>
                        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">{{ plafondPourcentage }}% du salaire de base</span>
                    </div>
                    {% if encours > 0 %}
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mt-2">
                        <div>
                            <span class="text-muted small">Avances en cours (non remboursées)</span>
                            <div class="fw-bold text-warning fs-5">{{ encours|number_format(0, ',', ' ') }} Ar</div>
                        </div>
                    </div>
                    {% endif %}
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mt-2">
                        <div>
                            <span class="text-muted small">Disponible maintenant</span>
                            <div class="fw-bold {{ montantDisponible > 0 ? 'text-success' : 'text-danger' }} fs-4">{{ montantDisponible|number_format(0, ',', ' ') }} Ar</div>
                        </div>
                    </div>
                    <div class="mt-3 alert alert-warning border-0 rounded-3 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        L'avance sera déduite de votre prochain salaire.
                    </div>
                    <div class="mt-2 alert alert-info border-0 rounded-3 small mb-0">
                        <i class="bi bi-clock me-1"></i>
                        Délai de traitement: 48h ouvrées
                    </div>
                </div>
            </div>

            <!-- TABLEAU DEMANDES PRÉCÉDENTES -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        Demandes précédentes
                    </h5>
                    <small class="text-muted">Historique de vos avances</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-2">Montant</th>
                                    <th class="py-2">Date</th>
                                    <th class="py-2 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in demandesPrecedentes %}
                                    <tr>
                                        <td class="ps-3 fw-semibold">{{ item.montant }} Ar</td>
                                        <td>{{ item.dateDemande ? item.dateDemande|date('d/m/Y') : '-' }}</td>
                                        <td class="text-center pe-3">
                                            {% if item.statut == constant('App\\Entity\\AvanceSalaire::STATUS_VALIDE') %}
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                                </span>
                                            {% elseif item.statut == constant('App\\Entity\\AvanceSalaire::STATUS_REFUSE') %}
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                                </span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                                    <i class="bi bi-clock-fill me-1"></i>En attente
                                                </span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center py-3 text-muted">Aucune demande enregistrée.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>{{ demandesPrecedentes.getTotalItemCount }} demande(s) enregistrée(s)</small>
                    {% if demandesPrecedentes.pageCount > 1 %}<nav aria-label="Pagination des avances">{{ knp_pagination_render(demandesPrecedentes) }}</nav>{% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
