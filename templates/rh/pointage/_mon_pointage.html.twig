{# Widget "Mon Pointage" : pointage personnel contrôlé par le planning et la tolérance #}
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 rounded-3 p-3"><i class="bi bi-person-badge text-primary fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Mon pointage — {{ "now"|date('d/m/Y') }}</h6>
                    {% if planning and planning.isTravail %}
                        <div class="text-muted small mb-1">
                            Planning : {{ planning.heureDebut ? planning.heureDebut|date('H:i') : '--:--' }}{% if planning.heureFin %} → {{ planning.heureFin|date('H:i') }}{% endif %}
                            {% if heureLimitePointage %} · Entrée autorisée jusqu’à {{ heureLimitePointage }}{% endif %}
                        </div>
                    {% elseif message %}
                        <div class="text-info small mb-1"><i class="bi bi-calendar-event me-1"></i>{{ message }}</div>
                    {% else %}
                        <div class="text-muted small mb-1">Aucun planning de travail enregistré aujourd’hui.</div>
                    {% endif %}
                    {% if monPointage and monPointage.heureEntree and monPointage.heureSortie %}
                        <span class="text-success small"><i class="bi bi-check2-circle me-1"></i>Shift terminé — {{ monPointage.heureEntree|date('H:i') }} → {{ monPointage.heureSortie|date('H:i') }} ({{ monPointage.formattedHeuresTravaillees }})</span>
                    {% elseif monPointage and monPointage.heureEntree %}
                        <span class="text-warning small"><i class="bi bi-clock-history me-1"></i>Shift en cours depuis {{ monPointage.heureEntree|date('H:i') }}</span>
                    {% elseif lateDeadlinePassed %}
                        <span class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>Pointage d’entrée fermé : tolérance de retard dépassée.</span>
                    {% elseif planning and planning.isTravail %}
                        <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>Shift pas encore démarré aujourd’hui.</span>
                    {% endif %}
                    {% if monPointage and monPointage.valide %}<span class="badge bg-secondary-subtle text-secondary rounded-pill ms-2">Validé</span>{% endif %}
                </div>
            </div>
            <div class="d-flex gap-2">
                {% if monPointage and monPointage.valide %}
                    <span class="text-muted small fst-italic">Journée déjà validée.</span>
                {% else %}
                    <form method="POST" action="{{ path('app_rh_pointage_debut') }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('mon_pointage_debut') }}">
                        <button type="submit" class="btn btn-success btn-sm px-3" {% if not canPointerEntree|default(false) %}disabled{% endif %}><i class="bi bi-play-fill me-1"></i>Début shift</button>
                    </form>
                    <form method="POST" action="{{ path('app_rh_pointage_fin') }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('mon_pointage_fin') }}">
                        <button type="submit" class="btn btn-danger btn-sm px-3" {% if not canPointerSortie|default(false) %}disabled{% endif %}><i class="bi bi-stop-fill me-1"></i>Fin shift</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
