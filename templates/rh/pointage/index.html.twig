                                            <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">MM</div>
                                            <div>
                                                <div class="fw-semibold">Marie Martin</div>
                                                <small class="text-muted">RH</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center text-warning">08:15</td>
                                    <td class="text-center">17:00</td>
                                    <td class="text-center"><span class="fw-semibold">8h 45min</span></td>
                                    <td class="text-center">0h</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                            <i class="bi bi-clock-history me-1"></i>Retard
                                        </span>
                                    </td>
                                </tr>

                                <!-- Ligne 3 - Sortie manquante -->
                                <tr>
                                    <td class="ps-3">
                                        <input type="checkbox" class="form-check-input">
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">PD</div>
                                            <div>
                                                <div class="fw-semibold">Paul Dubois</div>
                                                <small class="text-muted">Commercial</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">08:00</td>
                                    <td class="text-center text-danger">--:--</td>
                                    <td class="text-center">--</td>
                                    <td class="text-center">--</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-x-circle-fill me-1"></i>Sortie manquante
                                        </span>
                                    </td>
                                </tr>

                                <!-- Ligne 4 - Complet -->
                                <tr>
                                    <td class="ps-3">
                                        <input type="checkbox" class="form-check-input" checked>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">JL</div>
                                            <div>
                                                <div class="fw-semibold">Julie Leroy</div>
                                                <small class="text-muted">Compta</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">07:58</td>
                                    <td class="text-center">16:55</td>
                                    <td class="text-center"><span class="fw-semibold">8h 57min</span></td>
                                    <td class="text-center">0h</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Complet
                                        </span>
                                    </td>
                                </tr>

                                <!-- Ligne 5 - Heures Sup -->
                                <tr>
                                    <td class="ps-3">
                                        <input type="checkbox" class="form-check-input" checked>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">AL</div>
                                            <div>
                                                <div class="fw-semibold">Antoine Lefevre</div>
                                                <small class="text-muted">Tech</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">09:00</td>
                                    <td class="text-center">18:30</td>
                                    <td class="text-center"><span class="fw-semibold">9h 30min</span></td>
                                    <td class="text-center"><span class="fw-semibold text-primary">1h 30min</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>Heures Sup
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>5 pointages à valider aujourd'hui
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: ANOMALIES -->
        <div class="tab-pane fade" id="tab-anomalies" role="tabpanel" aria-labelledby="tab-anomalies-btn">
            <!-- KPI CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="text-muted small text-uppercase fw-semibold">Retards</div>
                            <div class="fs-3 fw-bold text-warning">2</div>
                            <small class="text-muted">À traiter</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="text-muted small text-uppercase fw-semibold">Oubli Pointage</div>
                            <div class="fs-3 fw-bold text-danger">2</div>
                            <small class="text-muted">À corriger</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="text-muted small text-uppercase fw-semibold">Heures Sup</div>
                            <div class="fs-3 fw-bold text-primary">1</div>
                            <small class="text-muted">À valider</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAU ANOMALIES -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Anomalies à traiter
                    </h5>
                    <small class="text-muted">5 anomalies détectées</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Criticité</th>
                                    <th class="py-3">Employé</th>
                                    <th class="py-3">Date</th>
                                    <th class="py-3">Type</th>
                                    <th class="py-3">Description</th>
                                    <th class="py-3 text-center pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Ligne 1 - Haute -->
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-danger rounded-pill px-3 py-2">Haute</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">PD</div>
                                            <div class="fw-semibold">Paul Dubois</div>
                                        </div>
