                    </h5>
                    <button class="btn btn-primary btn-sm">
                        <i class="bi bi-check2-all me-1"></i>Valider la journée
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3" style="width: 50px;">
                                        <input type="checkbox" class="form-check-input" checked>
                                    </th>
                                    <th class="py-3">Employé</th>
                                    <th class="py-3 text-center">Entrée</th>
                                    <th class="py-3 text-center">Sortie</th>
                                    <th class="py-3 text-center">Heures</th>
                                    <th class="py-3 text-center">Heures Sup</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Ligne 1 - Complet -->
                                <tr>
                                    <td class="ps-3">
                                        <input type="checkbox" class="form-check-input" checked>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">JD</div>
                                            <div>
                                                <div class="fw-semibold">Jean Dupont</div>
                                                <small class="text-muted">Tech</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">08:02</td>
                                    <td class="text-center">17:05</td>
                                    <td class="text-center"><span class="fw-semibold">9h 03min</span></td>
                                    <td class="text-center"><span class="fw-semibold text-primary">1h 03min</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Complet
                                        </span>
                                    </td>
                                </tr>

                                <!-- Ligne 2 - Retard -->
                                <tr>
                                    <td class="ps-3">
                                        <input type="checkbox" class="form-check-input" checked>
                                    </td>
                                    <td>
