                                    <td>21/10/2025</td>
                                    <td>Oubli pointage</td>
                                    <td>Sortie non enregistrée</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil me-1"></i>Corriger
                                        </button>
                                    </td>
                                </tr>

                                <!-- Ligne 2 - Moyenne -->
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Moyenne</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">MM</div>
                                            <div class="fw-semibold">Marie Martin</div>
                                        </div>
                                    </td>
                                    <td>21/10/2025</td>
                                    <td>Retard</td>
                                    <td>Arrivée à 08:15 au lieu de 08:00</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil me-1"></i>Corriger
                                        </button>
                                    </td>
                                </tr>

                                <!-- Ligne 3 - Haute -->
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-danger rounded-pill px-3 py-2">Haute</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">SR</div>
                                            <div class="fw-semibold">Sarah Rakoto</div>
                                        </div>
                                    </td>
                                    <td>20/10/2025</td>
                                    <td>Oubli pointage</td>
                                    <td>Entrée et Sortie manquantes</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil me-1"></i>Corriger
                                        </button>
                                    </td>
                                </tr>

                                <!-- Ligne 4 - Faible -->
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-2">Faible</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">AL</div>
                                            <div class="fw-semibold">Antoine Lefevre</div>
                                        </div>
                                    </td>
                                    <td>21/10/2025</td>
                                    <td>Heures sup</td>
                                    <td>1h30 au delà de 17h</td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil me-1"></i>Corriger
                                        </button>
                                    </td>
                                </tr>

                                <!-- Ligne 5 - Moyenne -->
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Moyenne</span>
                                    </td>
