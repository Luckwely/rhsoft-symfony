{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Gestion du Pointage{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Gestion du Pointage
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-check2-circle me-1"></i>Validez les heures et traitez les anomalies
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0">
            <input type="date" class="form-control form-control-sm" value="2025-10-21" style="max-width: 160px;">
            <button class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter
            </button>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="pointageTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-validation-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-validation"
                    type="button"
                    role="tab"
                    aria-controls="tab-validation"
                    aria-selected="true">
                <i class="bi bi-check2-circle text-success me-2"></i>Valider pointages
                <span class="badge bg-primary ms-1">5</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-anomalies-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-anomalies"
                    type="button"
                    role="tab"
                    aria-controls="tab-anomalies"
                    aria-selected="false">
                <i class="bi bi-exclamation-triangle text-danger me-2"></i>Anomalies
                <span class="badge bg-danger ms-1">5</span>
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="pointageTabsContent">

