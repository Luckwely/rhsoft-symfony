{% extends 'layouts/base_rh.html.twig' %}
{% block title %}Candidatures - {{ offre.titre }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Candidatures pour :</h4>
            <p class="text-muted small mb-0"><i class="bi bi-database me-1"></i>{{ offre.titre }}</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a href="{{ path('app_rh_offre') }}" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>Retour aux offres
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Lettre de motivation</th>
                            <th>CV</th>
                            <th class="text-center">Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for candidature in candidatures %}
                        <tr>
                            <td class="fw-bold">{{ candidature.nom }}</td>
                            <td><a href="mailto:{{ candidature.email }}">{{ candidature.email }}</a></td>
                            <td>{{ candidature.telephone }}</td>
                            <td>{{ candidature.lettreMotivation|length > 50 ? candidature.lettreMotivation|slice(0, 50) ~ '...' : candidature.lettreMotivation }}</td>
                            <td>
                                {% if candidature.cv %}
                                    <a href="{{ asset('uploads/cv/' ~ candidature.cv) }}" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-file-earmark-pdf"></i> Voir le CV
                                    </a>
                                {% else %}
                                    <span class="text-muted">Aucun CV</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {# Bouton Accepter #}
                                <a href="{{ path('rh_candidature_accepter', {id: candidature.id}) }}"
                                   class="btn btn-sm btn-success rounded-pill px-3 me-1"
                                   title="Accepter et embaucher">
                                    <i class="bi bi-check-circle-fill me-1"></i> Accepter
                                </a>

                                {# Bouton Refuser #}
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                        title="Refuser"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmRefuseModal"
                                        data-url="{{ path('rh_candidature_refuser', {id: candidature.id}) }}"
                                        data-nom="{{ candidature.nom }}">
                                    <i class="bi bi-x-circle-fill me-1"></i> Refuser
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox"></i> Aucune candidature en attente pour cette offre.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation de refus -->
<div class="modal fade" id="confirmRefuseModal" tabindex="-1" aria-labelledby="confirmRefuseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmRefuseModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmer le refus
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Êtes-vous sûr de vouloir refuser la candidature de <strong id="candidateName" class="text-dark"></strong> ?</p>
                <p class="text-muted small mb-0">La candidature sera archivée avec le statut "Refusée".</p>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Annuler</button>
                <a id="confirmRefuseBtn" href="#" class="btn btn-danger btn-sm px-3">Confirmer le refus</a>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const confirmRefuseModal = document.getElementById('confirmRefuseModal');
    if (confirmRefuseModal) {
        confirmRefuseModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const url = button.getAttribute('data-url');
            const nom = button.getAttribute('data-nom');
            confirmRefuseModal.querySelector('#candidateName').textContent = nom;
            confirmRefuseModal.querySelector('#confirmRefuseBtn').setAttribute('href', url);
        });
    }
});
</script>
{% endblock %}
