{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Rapports RH{% endblock %}

{# Badge d'évolution réutilisable pour le tableau "Détail Bilan Social".
   value  : variation numérique, ou null si non calculable (ex: pas de donnée l'année précédente).
   invert : true quand une hausse de l'indicateur est un signal négatif (ex: départs, absentéisme).
   unit   : unité affichée après la valeur ('%' par défaut, 'pt' pour un écart en points). #}
{% macro evolution_badge(value, invert = false, unit = '%') %}
    {% if value is null %}
        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
            <i class="bi bi-dash me-1"></i>N/A
        </span>
    {% elseif value == 0 %}
        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
            <i class="bi bi-dash me-1"></i>Stable
        </span>
    {% else %}
        {% set isPositiveSignal = invert ? value < 0 : value > 0 %}
        <span class="badge {{ isPositiveSignal ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }} rounded-pill px-3 py-2">
            <i class="bi {{ value > 0 ? 'bi-arrow-up' : 'bi-arrow-down' }} me-1"></i>{{ value > 0 ? '+' : '' }}{{ value }}{{ unit }}
        </span>
    {% endif %}
{% endmacro %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Rapports RH
            </h3>
            <p class="text-muted mb-0">
                Analysez vos données RH et exportez vos bilans
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0">
            <form method="get" class="d-flex gap-2 align-items-center">
                <input type="number" name="year" min="2000" max="2100" class="form-control form-control-sm" style="width: 100px;" value="{{ reportData.year }}">
                <button type="submit" class="btn btn-outline-dark btn-sm">Année</button>
            </form>
            <a href="{{ path('app_rh_rapport_export_pdf', {year: reportData.year}) }}" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter PDF
            </a>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="rapportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-turnover-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-turnover"
                    type="button"
                    role="tab"
                    aria-controls="tab-turnover"
                    aria-selected="true">
                <i class="bi bi-arrow-left-right text-link me-2"></i>Turnover
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-bilan-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-bilan"
                    type="button"
                    role="tab"
                    aria-controls="tab-bilan"
                    aria-selected="false">
                <i class="bi bi-file-text text-link me-2"></i>Bilan Social
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="rapportTabsContent">

        <!-- ONGLET 1: TURNOVER -->
        <div class="tab-pane fade show active" id="tab-turnover" role="tabpanel" aria-labelledby="tab-turnover-btn">
            <!-- KPI CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Taux Turnover</span>
                            <div class="fs-3 fw-bold text-primary">{{ reportData.turnoverRate }}%</div>
                            <small class="text-muted">Année {{ reportData.year }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Arrivées</span>
                            <div class="fs-3 fw-bold text-success">{{ reportData.hires }}</div>
                            <small class="text-muted">Année {{ reportData.year }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Départs</span>
                            <div class="fs-3 fw-bold text-danger">{{ reportData.departures }}</div>
                            <small class="text-muted">Année {{ reportData.year }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Effectif Moyen</span>
                            <div class="fs-3 fw-bold">{{ reportData.totalEmployees }}</div>
                            <small class="text-muted">Année {{ reportData.year }}</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- GRAPHIQUE 1: LINE CHART 6 MOIS -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                Départs sur 6 mois
                            </h5>
                            <small class="text-muted">Tendance des départs</small>
                        </div>
                        <div class="card-body">
                            <canvas id="turnoverLineChart" height="120"></canvas>
                        </div>
                    </div>
                </div>

                <!-- GRAPHIQUE 2: DOUGHNUT MOTIFS DEPART -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                Départs par motif
                            </h5>
                            <small class="text-muted">Analyse du turnover</small>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <canvas id="departMotifChart" height="180"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: BILAN SOCIAL -->
        <div class="tab-pane fade" id="tab-bilan" role="tabpanel" aria-labelledby="tab-bilan-btn">
            <!-- CARDS STATS -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0 fw-semibold">
                            Répartition H/F
                        </div>
                        <div class="card-body">
                            <div style="position: relative; height: 200px;">
                                <canvas id="genreChart"></canvas>
                            </div>
                            <div class="d-flex justify-content-between mt-3 small">
                                <span><i class="bi bi-circle-fill text-primary me-1"></i>Hommes {{ reportData.genreDistribution.H }}</span>
                                <span><i class="bi bi-circle-fill text-info me-1"></i>Femmes {{ reportData.genreDistribution.F }}</span>
                                {% if reportData.genreDistribution.non_renseigne > 0 %}
                                    <span><i class="bi bi-circle-fill text-secondary me-1"></i>Non renseigné {{ reportData.genreDistribution.non_renseigne }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0 fw-semibold">
                            Répartition par Âge
                        </div>
                        <div class="card-body">
                            <div style="position: relative; height: 200px;">
                                <canvas id="ageChart"></canvas>
                            </div>
                            {% if reportData.ageDistributionWithoutBirthdate > 0 %}
                                <small class="text-muted mt-2 d-block text-center">
                                    {{ reportData.ageDistributionWithoutBirthdate }} employé(s) sans date de naissance renseignée, exclu(s) du graphique
                                </small>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0 fw-semibold">
                            Ancienneté Moyenne
                        </div>
                        <div class="card-body text-center">
                            {% if reportData.ancienneteMoyenne is not null %}
                                <div class="fs-1 fw-bold text-primary">{{ reportData.ancienneteMoyenne }} <small class="fs-5 text-muted">ans</small></div>
                                <small class="text-muted mt-2 d-block">Basée sur les employés actifs avec une date d'embauche renseignée</small>
                            {% else %}
                                <i class="bi bi-database-slash fs-1 text-muted opacity-50 mb-2 d-block"></i>
                                <p class="text-muted small mb-0">Aucune date d'embauche renseignée pour le moment</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAUX EXPORTABLES -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">
                        Détail Bilan Social {{ reportData.year }}
                    </h5>
                    <a href="{{ path('app_rh_rapport_export_bilan_pdf', {year: reportData.year}) }}" class="btn btn-success btn-sm">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Exporter PDF Bilan Social
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Indicateur</th>
                                    <th class="py-3 text-end">Valeur</th>
                                    <th class="py-3 text-center pe-3">Évolution vs {{ reportData.year - 1 }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3 fw-semibold">Effectif Total</td>
                                    <td class="text-end">{{ reportData.totalEmployees }}</td>
                                    <td class="text-center pe-3">{{ _self.evolution_badge(reportData.effectifEvolution) }}</td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Nombre d'embauches</td>
                                    <td class="text-end">{{ reportData.hires }}</td>
                                    <td class="text-center pe-3">{{ _self.evolution_badge(reportData.hiresEvolution) }}</td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Nombre de départs</td>
                                    <td class="text-end">{{ reportData.departures }}</td>
                                    <td class="text-center pe-3">{{ _self.evolution_badge(reportData.departuresEvolution, true) }}</td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Masse salariale</td>
                                    <td class="text-end">
                                        {% if reportData.masseSalariale > 0 %}
                                            {{ reportData.masseSalariale|number_format(0, ',', ' ') }} Ar
                                        {% else %}
                                            <span class="text-muted">Aucune fiche de paie {{ reportData.year }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center pe-3">{{ _self.evolution_badge(reportData.masseSalarialeEvolution) }}</td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Taux d'absentéisme</td>
                                    <td class="text-end">
                                        {% if reportData.tauxAbsenteisme > 0 or reportData.presentToday > 0 %}
                                            {{ reportData.tauxAbsenteisme }}%
                                        {% else %}
                                            <span class="text-muted">Aucun pointage {{ reportData.year }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center pe-3">{{ _self.evolution_badge(reportData.tauxAbsenteismeEvolution, true, 'pt') }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}

{% block javascripts %}
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. LINE CHART TURNOVER 6 MOIS
    const ctx1 = document.getElementById('turnoverLineChart').getContext('2d');

    const gradient1 = ctx1.createLinearGradient(0, 0, 0, 180);
    gradient1.addColorStop(0, 'rgba(13, 110, 253, 0.3)');
    gradient1.addColorStop(1, 'rgba(13, 110, 253, 0.0)');

    new Chart(ctx1, {
        type: 'line',
        data: {
            labels: {{ reportData.chartLabels|json_encode|raw }},
            datasets: [{
                label: 'Départs',
                data: {{ reportData.chartValues|json_encode|raw }},
                borderColor: '#0d6efd',
                backgroundColor: gradient1,
                borderWidth: 3,
                pointBackgroundColor: '#0d6efd',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return 'Départs: ' + context.parsed.y;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        precision: 0
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

    // 2. DOUGHNUT DEPARTS PAR MOTIF
    new Chart(document.getElementById('departMotifChart'), {
        type: 'doughnut',
        data: {
            labels: ['Démission', 'Fin de contrat', 'Licenciement', 'Retraite'],
            datasets: [{
                data: [45, 30, 15, 10],
                backgroundColor: [
                    '#0d6efd',
                    '#6c757d',
                    '#dc3545',
                    '#198754'
                ],
                borderColor: [
                    '#0d6efd',
                    '#6c757d',
                    '#dc3545',
                    '#198754'
                ],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 12,
                        usePointStyle: true,
                        pointStyle: 'circle',
                        font: {
                            size: 11,
                            weight: '500'
                        }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.parsed + '%';
                        }
                    }
                }
            },
            cutout: '60%'
        }
    });

    // 3. PIE CHART GENRE (répartition H/F réelle)
    new Chart(document.getElementById('genreChart'), {
        type: 'pie',
        data: {
            labels: ['Hommes', 'Femmes', 'Non renseigné'],
            datasets: [{
                data: [
                    {{ reportData.genreDistribution.H }},
                    {{ reportData.genreDistribution.F }},
                    {{ reportData.genreDistribution.non_renseigne }}
                ],
                backgroundColor: ['#0d6efd', '#0dcaf0', '#adb5bd'],
                borderColor: ['#ffffff', '#ffffff', '#ffffff'],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.parsed;
                        }
                    }
                }
            }
        }
    });

    // 4. BAR CHART AGE (répartition par tranche d'âge réelle)
    new Chart(document.getElementById('ageChart'), {
        type: 'bar',
        data: {
            labels: {{ reportData.ageDistributionLabels|json_encode|raw }},
            datasets: [{
                label: 'Nb Employés',
                data: {{ reportData.ageDistributionValues|json_encode|raw }},
                backgroundColor: [
                    'rgba(13, 110, 253, 0.7)',
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(13, 110, 253, 0.9)',
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(13, 110, 253, 0.6)'
                ],
                borderColor: '#0d6efd',
                borderWidth: 1,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.parsed.y + ' employés';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    },
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

});
</script>
{% endblock %}
