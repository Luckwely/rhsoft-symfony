{% extends 'layouts/base_rh.html.twig' %}

{% block title %}Rapports RH{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>Rapports RH
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-bar-chart-line me-1"></i>Analysez vos données RH et exportez vos bilans
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0">
            <select class="form-select form-select-sm" style="width: 150px;">
                <option value="2025" selected>2025</option>
                <option value="2024">2024</option>
                <option value="2023">2023</option>
            </select>
            <button class="btn btn-outline-dark btn-sm">
                <i class="bi bi-download me-1"></i>Exporter PDF
            </button>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="rapportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-turnover-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-turnover"
                    type="button"
                    role="tab"
                    aria-controls="tab-turnover"
                    aria-selected="true">
                <i class="bi bi-arrow-left-right text-primary me-2"></i>Turnover
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-bilan-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-bilan"
                    type="button"
                    role="tab"
                    aria-controls="tab-bilan"
                    aria-selected="false">
                <i class="bi bi-file-text text-success me-2"></i>Bilan Social
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="rapportTabsContent">

        <!-- ONGLET 1: TURNOVER -->
        <div class="tab-pane fade show active" id="tab-turnover" role="tabpanel" aria-labelledby="tab-turnover-btn">
            <!-- KPI CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Taux Turnover</span>
                            <div class="fs-3 fw-bold text-primary">2.1%</div>
                            <small class="text-success"><i class="bi bi-arrow-down me-1"></i>-0.4% vs mois dernier</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Arrivées</span>
                            <div class="fs-3 fw-bold text-success">8</div>
                            <small class="text-muted">Ce mois</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Départs</span>
                            <div class="fs-3 fw-bold text-danger">5</div>
                            <small class="text-muted">Ce mois</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <span class="text-muted small text-uppercase fw-semibold">Effectif Moyen</span>
                            <div class="fs-3 fw-bold">142</div>
                            <small class="text-muted">2025</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- GRAPHIQUE 1: LINE CHART 6 MOIS -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-graph-up text-primary me-2"></i>Évolution Turnover 6 mois
                            </h5>
                            <small class="text-muted">Tendance des départs</small>
                        </div>
                        <div class="card-body">
                            <canvas id="turnoverLineChart" height="120"></canvas>
                        </div>
                    </div>
                </div>

                <!-- GRAPHIQUE 2: DOUGHNUT MOTIFS DEPART -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-pie-chart text-primary me-2"></i>Départs par motif
                            </h5>
                            <small class="text-muted">5 départs analysés</small>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <canvas id="departMotifChart" height="180"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: BILAN SOCIAL -->
        <div class="tab-pane fade" id="tab-bilan" role="tabpanel" aria-labelledby="tab-bilan-btn">
            <!-- CARDS STATS -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-transparent border-0 fw-semibold">
                            <i class="bi bi-gender-ambiguous text-primary me-2"></i>Répartition H/F
                        </div>
                        <div class="card-body">
                            <canvas id="genreChart" height="160"></canvas>
                            <div class="d-flex justify-content-between mt-3">
                                <span><i class="bi bi-circle-fill text-primary me-1"></i>Hommes 62%</span>
                                <span><i class="bi bi-circle-fill text-info me-1"></i>Femmes 38%</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-transparent border-0 fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-2"></i>Répartition par Âge
                        </div>
                        <div class="card-body">
                            <canvas id="ageChart" height="160"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-transparent border-0 fw-semibold">
                            <i class="bi bi-clock-history text-primary me-2"></i>Ancienneté Moyenne
                        </div>
                        <div class="card-body text-center">
                            <div class="fs-1 fw-bold text-primary">3.2 <small class="fs-5 text-muted">ans</small></div>
                            <div class="progress mt-3" style="height: 8px;">
                                <div class="progress-bar bg-primary" style="width: 65%"></div>
                            </div>
                            <small class="text-muted mt-2 d-block">+0.3 an vs 2024</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAUX EXPORTABLES -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-file-text text-primary me-2"></i>Détail Bilan Social 2025
                    </h5>
                    <button class="btn btn-success btn-sm">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Exporter PDF Bilan Social
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Indicateur</th>
                                    <th class="py-3 text-end">Valeur</th>
                                    <th class="py-3 text-center pe-3">Évolution</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3 fw-semibold">Effectif Total</td>
                                    <td class="text-end">142</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-arrow-up me-1"></i>+5.2%
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Nombre d'embauches</td>
                                    <td class="text-end">28</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-arrow-up me-1"></i>+12%
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Nombre de départs</td>
                                    <td class="text-end">19</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-arrow-up me-1"></i>+3%
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Âge moyen</td>
                                    <td class="text-end">34.5 ans</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                            <i class="bi bi-dash me-1"></i>Stable
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Masse salariale</td>
                                    <td class="text-end">1 432 000 €</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-arrow-up me-1"></i>+8.1%
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Taux d'absentéisme</td>
                                    <td class="text-end">4.8%</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-arrow-up me-1"></i>+0.5%
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-semibold">Formation (heures/an)</td>
                                    <td class="text-end">18.5 h</td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-arrow-up me-1"></i>+15%
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}

{% block javascripts %}
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. LINE CHART TURNOVER 6 MOIS
    const ctx1 = document.getElementById('turnoverLineChart').getContext('2d');

    const gradient1 = ctx1.createLinearGradient(0, 0, 0, 180);
    gradient1.addColorStop(0, 'rgba(13, 110, 253, 0.3)');
    gradient1.addColorStop(1, 'rgba(13, 110, 253, 0.0)');

    new Chart(ctx1, {
        type: 'line',
        data: {
            labels: ['Mai', 'Juin', 'Juillet', 'Août', 'Sept', 'Oct'],
            datasets: [{
                label: 'Taux Turnover %',
                data: [2.8, 2.5, 2.9, 2.3, 2.5, 2.1],
                borderColor: '#0d6efd',
                backgroundColor: gradient1,
                borderWidth: 3,
                pointBackgroundColor: '#0d6efd',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return 'Taux: ' + context.parsed.y + '%';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 4,
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        callback: function(value) {
                            return value + '%';
                        }
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

    // 2. DOUGHNUT DEPARTS PAR MOTIF
    new Chart(document.getElementById('departMotifChart'), {
        type: 'doughnut',
        data: {
            labels: ['Démission', 'Fin de contrat', 'Licenciement', 'Retraite'],
            datasets: [{
                data: [45, 30, 15, 10],
                backgroundColor: [
                    '#0d6efd',
                    '#6c757d',
                    '#dc3545',
                    '#198754'
                ],
                borderColor: [
                    '#0d6efd',
                    '#6c757d',
                    '#dc3545',
                    '#198754'
                ],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 12,
                        usePointStyle: true,
                        pointStyle: 'circle',
                        font: {
                            size: 11,
                            weight: '500'
                        }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.parsed + '%';
                        }
                    }
                }
            },
            cutout: '60%'
        }
    });

    // 3. PIE CHART GENRE
    new Chart(document.getElementById('genreChart'), {
        type: 'pie',
        data: {
            labels: ['Hommes', 'Femmes'],
            datasets: [{
                data: [62, 38],
                backgroundColor: ['#0d6efd', '#0dcaf0'],
                borderColor: ['#ffffff', '#ffffff'],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.parsed + '%';
                        }
                    }
                }
            }
        }
    });

    // 4. BAR CHART AGE
    new Chart(document.getElementById('ageChart'), {
        type: 'bar',
        data: {
            labels: ['<25', '25-34', '35-44', '45-54', '55+'],
            datasets: [{
                label: 'Nb Employés',
                data: [18, 52, 41, 22, 9],
                backgroundColor: [
                    'rgba(13, 110, 253, 0.7)',
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(13, 110, 253, 0.9)',
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(13, 110, 253, 0.6)'
                ],
                borderColor: '#0d6efd',
                borderWidth: 1,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff',
                    cornerRadius: 8,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.parsed.y + ' employés';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0,0,0,0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        stepSize: 10
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}
