{% extends "layouts/base.html.twig" %}

{% block title %}Home{% endblock %}

{% block body %}
<style>
    .header {
         background: linear-gradient(to right, rgba(0, 0, 0, 1), rgba(0, 0, 0, 0)), url('../uploads/home/header-bg.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* Animations */
    @keyframes floatBg {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(30px, -30px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
    }

    @keyframes floatStat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    @keyframes slideLeft {
        from {
            opacity: 0;
            transform: translateX(-60px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes slideRight {
        from {
            opacity: 0;
            transform: translateX(60px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes pulseBadge {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.9; transform: scale(1.02); }
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    /* Button hover effect */
    .btn-light:hover .position-absolute {
        transform: translateX(0) !important;
    }

    .btn-light:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px rgba(255, 255, 255, 0.2);
    }

    .btn-outline-light:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px rgba(255, 255, 255, 0.1);
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Feature cards hover */
    .bg-white.bg-opacity-10:hover {
        background-color: rgba(255, 255, 255, 0.2) !important;
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }

    /* Responsive adjustments */
    @media (max-width: 991px) {
        .display-4 {
            font-size: 2.5rem;
        }

        .position-absolute .rounded-circle {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .display-4 {
            font-size: 2rem;
        }

        .position-absolute .rounded-circle {
            display: none;
        }

        .position-absolute.m-3 {
            padding: 6px 12px !important;
        }

        .position-absolute.m-3 .fw-bold {
            font-size: 14px !important;
        }

        .position-absolute.m-3 small {
            font-size: 8px !important;
        }
    }

    @media (max-width: 576px) {
        .display-4 {
            font-size: 1.75rem;
        }

        .btn-lg {
            font-size: 14px;
            padding: 10px 20px;
        }

        .gap-4 {
            gap: 12px !important;
        }

        .position-absolute.m-3 {
            display: none !important;
        }
    }
</style>
<!-- SECTION HERO / HEADER -->
