                                <small class="opacity-75 text-white text-nowrap" style="font-size: 10px;">Collaborateurs Actifs Centralisés</small>
                            </div>
                        </div>
                    </div>

                    <div class="position-absolute top-0 end-0 m-2 m-lg-4 rounded-3 p-2 px-3 shadow-lg"
