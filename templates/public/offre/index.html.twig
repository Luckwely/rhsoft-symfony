{% extends 'layouts/base_carriere.html.twig' %}

{% block hero %}
<section class="bg-light border-bottom py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold text-dark mb-2">{{ titre }}</h1>
        <p class="text-secondary lead mb-0">Trouvez le job de vos rêves parmi {{ offres|length }} offres disponibles</p>
    </div>
</section>
{% endblock %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<div class="container pb-5">
    <div class="row g-4">
    {% for offre in offres %}
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 transition-card bg-white">
                <div class="card-body d-flex flex-column p-4">

                    <!-- Badge Entreprise -->
                    <div class="mb-3">
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-building me-1 text-muted"></i> {{ offre.entreprise.nom }}
                        </span>
                    </div>

                    <!-- Titre & Lieu -->
                    <h5 class="card-title fw-bold text-dark mb-2">{{ offre.titre }}</h5>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-geo-alt me-1"></i> {{ offre.lieu ?? 'Remote' }}
                    </p>

                    <!-- Description tronquée -->
                    <p class="card-text text-secondary flex-grow-1 mb-4">
                        {{ offre.description|length > 120 ? offre.description|slice(0, 120) ~ '...' : offre.description }}
                    </p>

                    <!-- Bouton Action -->
                    <a href="{{ path('app_offre_show', {id: offre.id}) }}" class="btn btn-outline-dark w-100 rounded-pill py-2 fw-semibold">
                        Voir l'offre <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                </div>

                <!-- Footer avec Date -->
                <div class="card-footer bg-transparent border-top-0 px-4 pb-4 text-muted small">
                    <i class="bi bi-calendar3 me-1"></i> Publié le {{ offre.createdAt|date('d/m/Y') }}
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <div class="mb-3">
                <i class="bi bi-search fs-1 text-muted opacity-50"></i>
            </div>
            <h3 class="h4 fw-bold text-dark mb-1">Aucune offre pour le moment</h3>
            <p class="text-muted">Revenez un peu plus tard pour découvrir de nouvelles opportunités.</p>
        </div>
    {% endfor %}
    </div>
</div>
{% endblock %}
