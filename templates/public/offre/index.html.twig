{% extends 'layouts/base_carriere.html.twig' %}

{% block hero %}
<section class="hero text-white text-center py-5 mb-5">
    <div class="container">
        <h1 class="display-4 fw-bold">{{ titre }}</h1>
        <p class="lead">Trouvez le job de vos rêves parmi {{ offres|length }} offres</p>
    </div>
</section>
{% endblock %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row g-4">
{% for offre in offres %}
    <div class="col-md-6 col-lg-4">
        <div class="card card-offre h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge badge-entreprise mb-2 align-self-start">
                    <i class="bi bi-building"></i> {{ offre.entreprise.nom }}
                </span>
                <h5 class="card-title fw-bold">{{ offre.titre }}</h5>
                <p class="text-muted small"><i class="bi bi-geo-alt"></i> {{ offre.lieu ?? 'Remote' }}</p>
                <p class="card-text flex-grow-1">{{ offre.description|slice(0, 120) }}...</p>
                <a href="{{ path('app_offre_show', {id: offre.id}) }}" class="btn btn-outline-primary w-100 mt-auto">
                    Voir l'offre <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-footer bg-white border-0 text-muted small">
                Publié le {{ offre.createdAt|date('d/m/Y') }}
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12 text-center py-5">
        <i class="bi bi-search fs-1 text-muted"></i>
        <h2>Aucune offre pour le moment</h2>
    </div>
{% endfor %}
</div>
{% endblock %}
