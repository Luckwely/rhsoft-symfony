{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <div class="mb-4">
                <span class="display-1 fw-bold text-primary">{{ status_code }}</span>
            </div>
            <h1 class="h3 fw-bold mb-3">
                {% if status_code == 401 %}Connexion requise
                {% elseif status_code == 403 %}Accès refusé
                {% elseif status_code == 404 %}Page introuvable
                {% else %}Une erreur est survenue
                {% endif %}
            </h1>
            <p class="text-muted mb-4">{{ message }}</p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter</a>
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">Retour à l’accueil</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
