{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mon Planning & Pointage{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Mon Planning & Pointage
            </h3>
            <p class="text-muted mb-0">
                Gérez vos horaires et pointages
            </p>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="employeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-pointer-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-pointer"
                    type="button"
                    role="tab"
                    aria-controls="tab-pointer"
                    aria-selected="true">
                <i class="bi bi-clock-history text-success me-2"></i>Pointer Entrée/Sortie
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-historique-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-historique"
                    type="button"
                    role="tab"
                    aria-controls="tab-historique"
                    aria-selected="false">
                <i class="bi bi-list-check text-primary me-2"></i>Historique
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-planning-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-planning"
                    type="button"
                    role="tab"
                    aria-controls="tab-planning"
                    aria-selected="false">
                <i class="bi bi-calendar-week text-info me-2"></i>Mes Planning
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="employeTabsContent">

        <!-- ONGLET 1: POINTER ENTREE/SORTIE -->
        <div class="tab-pane fade show active" id="tab-pointer" role="tabpanel">
            <div class="row g-4">
                <!-- HORLOGE + BOUTONS -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 text-center">
                        <div class="card-body p-4 p-md-5">
                            <div class="display-1 fw-bold text-primary" id="clock">00:00:00</div>
                            <div class="text-muted mb-4">{{ "now"|date("d/m/Y") }}</div>

                            {% if message is defined and message %}
                                <div class="alert alert-warning border-0 rounded-3 mb-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i> {{ message }}
                                </div>
                            {% endif %}

                            <!-- Pointage Entree / Sortie -->
                            <div class="mb-3">
                                <form method="POST" action="{{ path('app_employe_pointage_entree') }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('pointer_entree') }}">
                                    <button type="submit" class="btn btn-success btn-md px-4 mb-2" {{ not (canPointerEntree ?? false) ? 'disabled' }}>
                                        <i class="bi bi-check-circle me-1"></i>Pointer Entrée
                                    </button>
                                </form>

                                <form method="POST" action="{{ path('app_employe_pointage_sortie') }}" class="d-inline ms-1">
                                    <input type="hidden" name="_token" value="{{ csrf_token('pointer_sortie') }}">
                                    <button type="submit" class="btn btn-danger btn-md px-4 mb-2" {{ not (canPointerSortie ?? false) ? 'disabled' }}>
                                        <i class="bi bi-x-circle me-1"></i>Pointer Sortie
                                    </button>
                                </form>
                            </div>

                            {% set badgeMap = {'travail':'primary', 'repos':'secondary', 'conge':'warning', 'ferie':'danger'} %}
                            <div class="mt-4 alert alert-{{ planning and planning.typeJour ? badgeMap[planning.typeJour] ?? 'info' : 'info' }} border-0 rounded-3">
                                <i class="bi bi-info-circle me-2"></i>
                                {% if planning is defined and planning and planning.isTravail() and planning.heureDebut %}
                                    Horaire prévu: {{ planning.heureDebut|date('H:i') }} - {{ planning.heureFin|date('H:i') }}<br>

                                {% elseif planning is defined and planning %}
                                    {{ planning.typeJour|capitalize }}
                                {% else %}
                                    Aucun planning défini pour aujourd'hui
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- INFOS POINTAGE -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-hourglass-split text-warning me-2"></i>Heures travaillées aujourd'hui
                            </h5>
                            <div class="text-center py-3">
                                <div class="display-4 fw-bold text-primary">{{ heuresTravaillees ?? '00:00' }}</div>
                                <small class="text-muted">Temps de travail effectif</small>
                                {% if retardMinutes is defined and retardMinutes > 0 %}
                                    <div class="text-danger small mt-1"><i class="bi bi-exclamation-triangle"></i> Retard: {{ retardMinutes }}min</div>
                                {% endif %}
                            </div>
                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <div class="bg-light rounded-3 p-2 text-center">
                                        <small class="text-muted">Entrée</small>
                                        <div class="fw-bold">{{ pointage is defined and pointage and pointage.heureEntree ? pointage.heureEntree|date('H:i') : '--:--' }}</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light rounded-3 p-2 text-center">
                                        <small class="text-muted">Sortie</small>
                                        <div class="fw-bold">{{ pointage is defined and pointage and pointage.heureSortie ? pointage.heureSortie|date('H:i') : '--:--' }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: HISTORIQUE -->
        <div class="tab-pane fade" id="tab-historique" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">Historique des pointages</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Date</th>
                                    <th class="py-3 text-center">Entrée</th>
                                    <th class="py-3 text-center">Sortie</th>
                                    <th class="py-3 text-center">Heures</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for p in historique ?? [] %}
                                    {% set minutes = p.heureEntree and p.heureSortie ? ((p.heureSortie.timestamp - p.heureEntree.timestamp) / 60)|round : 0 %}
                                    <tr>
                                        <td class="ps-3"><span class="fw-semibold">{{ p.date|date('d/m/Y') }}</span></td>
                                        <td class="text-center">{{ p.heureEntree ? p.heureEntree|date('H:i') : '--:--' }}</td>
                                        <td class="text-center">{{ p.heureSortie ? p.heureSortie|date('H:i') : '--:--' }}</td>
                                        <td class="text-center">
                                            <span class="fw-semibold">
                                                {% if p.heureEntree and p.heureSortie %}
                                                    {{ p.formattedHeuresTravaillees() }}
                                                {% else %}
                                                    --
                                                {% endif %}
                                            </span>
                                        </td>
                                        <td class="text-center pe-3">
                                            {% if not p.heureSortie %}
                                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                                    <i class="bi bi-play-circle me-1"></i>En cours
                                                </span>
                                            {% elseif minutes >= 480 %}
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Complet (8h+)
                                                </span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                                    <i class="bi bi-exclamation-circle-fill me-1"></i>Incomplet (< 8h)
                                                </span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">Aucun historique disponible.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 3: MES PLANNING -->
        <div class="tab-pane fade" id="tab-planning" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0"><i class="bi bi-calendar-week text-primary me-2"></i>Ma Semaine</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-bordered text-center align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="text-start ps-3">Jour</th>
                                            <th>Début</th>
                                            <th>Fin</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% set orderedDays = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'] %}
                                        {% for dayName in orderedDays %}
                                            {% set plan = null %}
                                            {% for p in planningsSemaine ?? [] %}
                                                {% if p.dayOfWeek|lower == dayName %}
                                                    {% set plan = p %}
                                                {% endif %}
                                            {% endfor %}
                                            <tr>
                                                <td class="fw-semibold text-start ps-3 text-capitalize">{{ dayName }}</td>
                                                <td>{{ plan and plan.heureDebut ? plan.heureDebut|date('H:i') : '--:--' }}</td>
                                                <td>{{ plan and plan.heureFin ? plan.heureFin|date('H:i') : '--:--' }}</td>

                                                <td>
                                                    {% set badgeTypes = {
                                                        'travail': ['success', 'check-circle', 'Travail'],
                                                        'repos': ['secondary', 'moon-fill', 'Repos'],
                                                        'conge': ['warning', 'umbrella', 'Congé'],
                                                        'ferie': ['danger', 'flag-fill', 'Férié']
                                                    } %}
                                                    {% set typeVal = plan ? plan.typeJour : 'repos' %}
                                                    {% set b = badgeTypes[typeVal] ?? ['info', 'info-circle', plan ? plan.typeJour|capitalize : 'Planifié'] %}
                                                    <span class="badge bg-{{ b[0] }}-subtle text-{{ b[0] }} rounded-pill px-3 py-2">
                                                        <i class="bi bi-{{ b[1] }} me-1"></i>{{ b[2] }}
                                                    </span>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RÉCAPITULATIF -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 mb-3 p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Récapitulatif</h5>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Jours travaillés</span> <span class="fw-semibold">{{ joursTravailles ?? 0 }}</span></li>
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Jours de congé</span> <span class="fw-semibold">{{ joursConges ?? 0 }}</span></li>
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Jours de repos</span> <span class="fw-semibold">{{ joursRepos ?? 0 }}</span></li>
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Jours fériés</span> <span class="fw-semibold">{{ joursFeries ?? 0 }}</span></li>
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Total heures planifiées</span> <span class="fw-bold text-primary">{{ totalHeuresSemaine ?? '0h 00min' }}</span></li>
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Total heures réelles</span> <span class="fw-bold text-primary">{{ totalHeuresReelles ?? '0h 00min' }}</span></li>

                            <li class="d-flex justify-content-between py-2"><span class="text-muted">Heures sup.</span> <span class="fw-bold text-primary">{{ totalHeuresSup ?? '0h 00min' }}</span></li>
                            <li class="d-flex justify-content-between py-2"><span class="text-muted">Total heures</span> <span class="fw-bold text-primary">{{ totalHeuresSemaine ?? '0h 00min' }}</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Styles -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .table-bordered td, .table-bordered th {
        border-color: #e9ecef;
    }
</style>

<!-- Scripts -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Horloge principale
    function updateClock() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const clockEl = document.getElementById('clock');
        if (clockEl) {
            clockEl.textContent = hours + ':' + minutes + ':' + seconds;
        }
    }
    updateClock();
    setInterval(updateClock, 1000);

    function formatSecondsAsTime(seconds) {
        const hours = String(Math.floor(seconds / 3600)).padStart(2, '0');
        const minutes = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
        const secs = String(seconds % 60).padStart(2, '0');
        return `${hours}:${minutes}:${secs}`;
    }

    if (btnDebut && btnFin) {


        btnDebut.addEventListener('click', () => {

            btnDebut.disabled = true;
            btnFin.disabled = false;
            btnFin.classList.remove('btn-secondary');
            btnFin.classList.add('btn-dark');
            counterContainer.classList.remove('d-none');


        });

        btnFin.addEventListener('click', () => {

            btnDebut.disabled = false;
            btnFin.disabled = true;
            btnFin.classList.remove('btn-dark');
            btnFin.classList.add('btn-secondary');
            counterContainer.classList.add('d-none');

            // Remise à zéro du chrono
            timerDisplay.textContent = "00:00:00";
        });
    }
});
</script>
{% endblock %}
