{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mon Planning & Pointage{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-calendar-clock text-primary me-2"></i>Mon Planning & Pointage
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-person-circle me-1"></i>Gérez vos horaires et pointages
            </p>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="employeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-pointer-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-pointer"
                    type="button"
                    role="tab"
                    aria-controls="tab-pointer"
                    aria-selected="true">
                <i class="bi bi-clock-history text-success me-2"></i>Pointer Entrée/Sortie
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-historique-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-historique"
                    type="button"
                    role="tab"
                    aria-controls="tab-historique"
                    aria-selected="false">
                <i class="bi bi-list-check text-primary me-2"></i>Historique
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-planning-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-planning"
                    type="button"
                    role="tab"
                    aria-controls="tab-planning"
                    aria-selected="false">
                <i class="bi bi-calendar-week text-info me-2"></i>Mes Planning
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="employeTabsContent">

        <!-- ONGLET 1: POINTER ENTREE/SORTIE -->
        <div class="tab-pane fade show active" id="tab-pointer" role="tabpanel">
            <div class="row g-4">
                <!-- HORLOGE + BOUTONS -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 text-center">
                        <div class="card-body p-4 p-md-5">
                            <div class="display-1 fw-bold text-primary" id="clock">00:00:00</div>
                            <div class="text-muted mb-4">{{ "now"|date("d/m/Y") }}</div>

                            {% if message %}
                                <div class="alert alert-warning border-0 rounded-3 mb-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i> {{ message }}
                                </div>
                            {% endif %}

                            <form method="POST" action="{{ path('app_employe_pointage_entree') }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('pointer_entree') }}">
                                <button type="submit" class="btn btn-success btn-lg px-5" {{ not canPointerEntree ? 'disabled' }}>
                                    <i class="bi bi-check-circle me-2"></i>Pointer Entrée
                                </button>
                            </form>

                            <form method="POST" action="{{ path('app_employe_pointage_sortie') }}" class="d-inline ms-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('pointer_sortie') }}">
                                <button type="submit" class="btn btn-danger btn-lg px-5" {{ not canPointerSortie ? 'disabled' }}>
                                    <i class="bi bi-x-circle me-2"></i>Pointer Sortie
                                </button>
                            </form>

                            <div class="mt-4 alert alert-info border-0 rounded-3">
                                <i class="bi bi-info-circle me-2"></i>
                                {% if planning and planning.heureDebut %}
                                    Horaire prévu: {{ planning.heureDebut|date('H:i') }} - {{ planning.heureFin|date('H:i') }}
                                {% else %}
                                    Aucun planning défini pour aujourd'hui
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- INFOS POINTAGE -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-hourglass-split text-warning me-2"></i>Heures travaillées aujourd'hui
                            </h5>
                            <div class="text-center py-3">
                                <div class="display-4 fw-bold text-primary">{{ heuresTravaillees }}</div>
                                <small class="text-muted">Temps de travail effectif</small>
                            </div>
                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <div class="bg-light rounded-3 p-2 text-center">
                                        <small class="text-muted">Entrée</small>
                                        <div class="fw-bold">{{ pointage and pointage.heureEntree ? pointage.heureEntree|date('H:i') : '--:--' }}</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light rounded-3 p-2 text-center">
                                        <small class="text-muted">Sortie</small>
                                        <div class="fw-bold">{{ pointage and pointage.heureSortie ? pointage.heureSortie|date('H:i') : '--:--' }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: HISTORIQUE -->
        <div class="tab-pane fade" id="tab-historique" role="tabpanel" aria-labelledby="tab-historique-btn">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm" style="width: 150px;">
                            <option value="10" selected>Octobre 2025</option>
                            <option value="9">Septembre 2025</option>
                            <option value="8">Août 2025</option>
                            <option value="7">Juillet 2025</option>
                        </select>
                        <select class="form-select form-select-sm" style="width: 150px;">
                            <option value="month">Ce mois</option>
                            <option value="3months">3 derniers mois</option>
                            <option value="year">Cette année</option>
                        </select>
                    </div>
                    <button class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-download me-1"></i>Exporter CSV
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Date</th>
                                    <th class="py-3 text-center">Entrée</th>
                                    <th class="py-3 text-center">Sortie</th>
                                    <th class="py-3 text-center">Heures</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for p in historique %}
                                <tr>
                                    <td class="ps-3"><span class="fw-semibold">{{ p.date|date('d/m/Y') }}</span></td>
                                    <td class="text-center">{{ p.heureEntree ? p.heureEntree|date('H:i') : '--:--' }}</td>
                                    <td class="text-center">{{ p.heureSortie ? p.heureSortie|date('H:i') : '--:--' }}</td>
                                    <td class="text-center">
                                        <span class="fw-semibold">
                                            {# Add a simple macro or inline diff logic if needed #}
                                            {{ p.heureEntree and p.heureSortie ? p.heureEntree.diff(p.heureSortie).format('%h0h %imin') : '--' }}
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-{{ p.statut == 'Retard' ? 'warning' : 'success' }}-subtle text-{{ p.statut == 'Retard' ? 'warning' : 'success' }} rounded-pill px-3 py-2">
                                            <i class="bi bi-{{ p.statut == 'Retard' ? 'clock-history' : 'check-circle-fill' }} me-1"></i>{{ p.statut ?? 'Complet' }}
                                        </span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Aucun historique disponible pour cette période.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>10 pointages pour Octobre 2025
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- ONGLET 3: MES PLANNING -->
        <div class="tab-pane fade" id="tab-planning" role="tabpanel" aria-labelledby="tab-planning-btn">
            <div class="row g-4">
                <!-- CARTE PLANNING HEBDOMADAIRE -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-calendar-week text-primary me-2"></i>Ma Semaine
                            </h5>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i></button>
                                <span class="fw-semibold">Semaine 42</span>
                                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-right"></i></button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                            <table class="table table-bordered text-center align-middle mb-0" style="border-color: #e9ecef;">
                                <thead class="bg-light">
                                    <tr>
                                        <th style="width: 120px;">Jour</th>
                                        <th>Début</th>
                                        <th>Fin</th>
                                        <th>Pause</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for plan in planningsSemaine %}
                                    <tr>
                                        <td class="fw-semibold text-start ps-3">{{ plan.dayOfWeek|capitalize }}</td>
                                        <td>{{ plan.heureDebut ? plan.heureDebut|date('H:i') : '--:--' }}</td>
                                        <td>{{ plan.heureFin ? plan.heureFin|date('H:i') : '--:--' }}</td>
                                        <td>{{ plan.pauseMinutes ? plan.pauseMinutes ~ ' min' : 'Aucune' }}</td>
                                        <td>
                                            {% if plan.isDayOff %}
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                                    <i class="bi bi-moon-fill me-1"></i>Repos
                                                </span>
                                            {% else %}
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                    <i class="bi bi-check-circle me-1"></i>Travail
                                                </span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">Aucun planning défini pour cette semaine.</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        </div>
                    </div>
                </div>

                <!-- RÉCAPITULATIF PLANNING -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 mb-3">
                        <div class="card border-0 shadow-sm p-4 mb-4">
                            <h5 class="card-title fw-bold mb-3">
                                <i class="bi bi-bar-chart-fill me-2 text-primary"></i>Récapitulatif
                            </h5>
                            <ul class="list-unstyled mb-0">
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Jours travaillés</span>
                                    <span class="fw-semibold">{{ joursTravailles }}</span>
                                </li>
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Jours de congé</span>
                                    <span class="fw-semibold">{{ joursConges }}</span>
                                </li>
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Jours de repos</span>
                                    <span class="fw-semibold">{{ joursRepos }}</span>
                                </li>
                                <li class="d-flex justify-content-between py-2">
                                    <span class="text-muted">Total heures</span>
                                    <span class="fw-bold text-primary">{{ totalHeuresSemaine }}</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-info-circle text-info me-2"></i>Mes horaires (Aujourd'hui)
                            </h5>
                            <div class="d-flex align-items-center gap-3 mb-3 p-2 bg-light rounded-3">
                                <i class="bi bi-clock text-primary fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Heure de début</small>
                                    <span class="fw-semibold">{{ planning and planning.heureDebut ? planning.heureDebut|date('H:i') : '--:--' }}</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3 mb-3 p-2 bg-light rounded-3">
                                <i class="bi bi-clock-fill text-danger fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Heure de fin</small>
                                    <span class="fw-semibold">{{ planning and planning.heureFin ? planning.heureFin|date('H:i') : '--:--' }}</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3">
                                <i class="bi bi-cup-hot text-warning fs-4"></i>
                                <div>
                                    <small class="text-muted d-block">Pause</small>
                                    <span class="fw-semibold">{{ planning and planning.pauseMinutes ? planning.pauseMinutes ~ ' min' : 'Aucune' }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .table-bordered td, .table-bordered th {
        border-color: #e9ecef;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function updateClock() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        document.getElementById('clock').textContent = hours + ':' + minutes + ':' + seconds;
    }
    updateClock();
    setInterval(updateClock, 1000);
});
</script>
{% endblock %}
