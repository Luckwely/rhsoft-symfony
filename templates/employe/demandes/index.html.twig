{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mes Demandes{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-clipboard2 text-primary me-2"></i>Mes Demandes
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-list-check me-1"></i>Gérez vos avances et attestations
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">JD</div>
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-semibold">Jean Dupont</span>
                <small class="text-muted">Développeur - Tech</small>
            </div>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="demandesTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-avance-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-avance"
                    type="button"
                    role="tab"
                    aria-controls="tab-avance"
                    aria-selected="true">
                <i class="bi bi-coin text-success me-2"></i>Avance
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-attestation-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-attestation"
                    type="button"
                    role="tab"
                    aria-controls="tab-attestation"
                    aria-selected="false">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Attestation
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="demandesTabsContent">

        <!-- ONGLET 1: AVANCE -->
        <div class="tab-pane fade show active" id="tab-avance" role="tabpanel" aria-labelledby="tab-avance-btn">
            <div class="row g-4">
                <!-- FORMULAIRE AVANCE -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-plus-circle text-success me-2"></i>Demander une avance
                            </h5>
                            <small class="text-muted">Remplissez le formulaire ci-dessous</small>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Montant demandé <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <input type="number" class="form-control" placeholder="500" min="50" max="800" step="10">
                                    </div>
                                    <small class="text-muted">Montant maximum autorisé: 800 €</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Motif <span class="text-danger">*</span></label>
                                    <select class="form-select">
                                        <option value="">Sélectionner un motif</option>
                                        <option value="urgent">Dépense urgente</option>
                                        <option value="medical">Frais médicaux</option>
                                        <option value="education">Frais de scolarité</option>
                                        <option value="logement">Logement / Loyer</option>
                                        <option value="transport">Transport / Véhicule</option>
                                        <option value="autre">Autre</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Date souhaitée</label>
                                    <input type="date" class="form-control" value="{{ "now"|date('Y-m-d') }}">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Commentaire</label>
                                    <textarea class="form-control" rows="3" placeholder="Précisez le motif de votre demande..."></textarea>
                                </div>
                                <button class="btn btn-primary w-100">
                                    <i class="bi bi-send me-2"></i>Envoyer la demande
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- INFOS AVANCE -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 mb-3">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-info-circle text-info me-2"></i>Informations
                            </h5>
                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                                <div>
                                    <span class="text-muted small">Maximum autorisé</span>
                                    <div class="fw-bold text-primary fs-4">800 €</div>
                                </div>
                                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">Par demande</span>
                            </div>
                            <div class="mt-3 alert alert-warning border-0 rounded-3 small">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                L'avance sera déduite de votre prochain salaire.
                            </div>
                            <div class="mt-2 alert alert-info border-0 rounded-3 small mb-0">
                                <i class="bi bi-clock me-1"></i>
                                Délai de traitement: 48h ouvrées
                            </div>
                        </div>
                    </div>

                    <!-- TABLEAU DEMANDES PRÉCÉDENTES -->
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-clock-history text-primary me-2"></i>Demandes précédentes
                            </h5>
                            <small class="text-muted">Historique de vos avances</small>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle table-borderless mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-3 py-2">Montant</th>
                                            <th class="py-2">Date</th>
                                            <th class="py-2 text-center pe-3">Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="ps-3 fw-semibold">300 €</td>
                                            <td>15/09/2025</td>
                                            <td class="text-center pe-3">
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="ps-3 fw-semibold">150 €</td>
                                            <td>20/08/2025</td>
                                            <td class="text-center pe-3">
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="ps-3 fw-semibold">500 €</td>
                                            <td>05/07/2025</td>
                                            <td class="text-center pe-3">
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: ATTESTATION -->
        <div class="tab-pane fade" id="tab-attestation" role="tabpanel" aria-labelledby="tab-attestation-btn">
            <div class="row g-4">
                <!-- ALERTE -->
                <div class="col-12">
                    <div class="alert alert-info border-0 rounded-4 shadow-sm d-flex align-items-center" role="alert">
                        <div class="bg-info-subtle rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 44px; height: 44px;">
                            <i class="bi bi-clock text-info fs-4"></i>
                        </div>
                        <div>
                            <h5 class="alert-heading fw-bold mb-0">Délai de génération: 24h</h5>
                            <p class="mb-0 small text-muted">Les attestations sont générées sous 24h ouvrées</p>
                        </div>
                    </div>
                </div>

                <!-- Carte 1: Attestation de travail -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="bg-primary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                                <i class="bi bi-building text-primary fs-2"></i>
                            </div>
                            <h5 class="fw-bold">Attestation de travail</h5>
                            <p class="text-muted small">Atteste votre emploi et vos fonctions au sein de l'entreprise</p>
                            <div class="d-flex flex-column gap-2 mt-3">
                                <button class="btn btn-primary w-100">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>Générer PDF
                                </button>
                                <small class="text-muted">Disponible sous 24h</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Carte 2: Attestation de salaire -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="bg-success-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                                <i class="bi bi-currency-euro text-success fs-2"></i>
                            </div>
                            <h5 class="fw-bold">Attestation de salaire</h5>
                            <p class="text-muted small">Certifie vos revenus et votre rémunération mensuelle</p>
                            <div class="d-flex flex-column gap-2 mt-3">
                                <button class="btn btn-primary w-100">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>Générer PDF
                                </button>
                                <small class="text-muted">Disponible sous 24h</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Carte 3: Certificat de présence -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body text-center p-4">
                            <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                                <i class="bi bi-calendar-check text-warning fs-2"></i>
                            </div>
                            <h5 class="fw-bold">Certificat de présence</h5>
                            <p class="text-muted small">Justifie votre présence au sein de l'entreprise</p>
                            <div class="d-flex flex-column gap-2 mt-3">
                                <button class="btn btn-primary w-100">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>Générer PDF
                                </button>
                                <small class="text-muted">Disponible sous 24h</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HISTORIQUE ATTESTATIONS -->
            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Historique des attestations
                    </h5>
                    <small class="text-muted">Vos dernières demandes</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Type</th>
                                    <th class="py-3">Date de demande</th>
                                    <th class="py-3 text-center">Statut</th>
                                    <th class="py-3 text-center pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-building me-1"></i>Attestation travail
                                        </span>
                                    </td>
                                    <td>20/10/2025</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Disponible
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-download me-1"></i>Télécharger
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-currency-euro me-1"></i>Attestation salaire
                                        </span>
                                    </td>
                                    <td>15/10/2025</td>
                                    <td class="text-center">
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                            <i class="bi bi-clock-history me-1"></i>En attente
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <span class="text-muted small">En cours</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                            <i class="bi bi-calendar-check me-1"></i>Certificat présence
                                        </span>
                                    </td>
                                    <td>05/10/2025</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Disponible
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-download me-1"></i>Télécharger
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
