{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mes Demandes - Démission{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-clipboard2 text-primary me-2"></i>Mes Demandes
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-list-check me-1"></i>Gérez vos avances et attestations
            </p>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="demandesTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a href="{{ path("app_employe_demandes_avance") }}" class="nav-link border-0 rounded-3 px-4">
                <i class="bi bi-coin text-success me-2"></i>Avance
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a href="{{ path("app_employe_demandes_demission") }}" class="nav-link active border-0 rounded-3 px-4">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Démission
            </a>
        </li>
    </ul>

    <!-- CONTENU -->
    <div class="tab-pane fade show active">
        <div class="row g-4">
            <!-- FORMULAIRE DEMISSION -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-file-earmark-text text-danger me-2"></i>Soumettre une démission
                        </h5>
                        <small class="text-muted">Remplissez le formulaire de préavis ci-dessous</small>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.dateDepart, 'Date de départ souhaitée *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.dateDepart, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.dateDepart) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.motif, 'Motif / Commentaires *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.motif, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.motif) }}
                            </div>
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-send me-2"></i>Envoyer la lettre de démission
                            </button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <!-- INFOS & HISTORIQUE DÉMISSION -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-info-circle text-info me-2"></i>Informations utiles
                        </h5>
                        <div class="mt-3 alert alert-warning border-0 rounded-3 small">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            La soumission d'une démission enclenche un préavis légal ou conventionnel.
                        </div>
                        <div class="mt-2 alert alert-info border-0 rounded-3 small mb-0">
                            <i class="bi bi-headset me-1"></i>
                            Contactez les Ressources Humaines pour toute question relative à votre solde de tout compte.
                        </div>
                    </div>
                </div>

                <!-- TABLEAU HISTORIQUE DÉMISSIONS -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock-history text-primary me-2"></i>Demandes précédentes
                        </h5>
                        <small class="text-muted">Historique de vos démissions</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-borderless mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3 py-2">Date départ</th>
                                        <th class="py-2">Date demande</th>
                                        <th class="py-2 text-center pe-3">Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in demissionsPrecedentes %}
                                        <tr>
                                            <td class="ps-3 fw-semibold">{{ item.dateDepart ? item.dateDepart|date('d/m/Y') : '-' }}</td>
                                            <td>{{ item.dateDemande ? item.dateDemande|date('d/m/Y') : '-' }}</td>
                                            <td class="text-center pe-3">
                                                {% if item.statut == 'validee' %}
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                                    </span>
                                                {% elseif item.statut == 'refusee' %}
                                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                                        <i class="bi bi-clock-fill me-1"></i>En attente
                                                    </span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center py-3 text-muted">Aucune demande enregistrée.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
