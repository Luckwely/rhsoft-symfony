{% extends 'layouts/base_employe.html.twig' %}
{% block title %}Mon Profil{% endblock %}
{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-person-circle text-primary me-2"></i>Mon Profil
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-gear me-1"></i>Consultez et gérez vos informations personnelles
            </p>
        </div>
        <a href="{{ path('app_employe_profile') }}" class="btn btn-outline-secondary btn-sm mt-3 mt-md-0">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Actualiser
        </a>
    </div>

    <!-- LAYOUT 2 COLONNES -->
    <div class="row g-4">
        <!-- COLONNE GAUCHE -->
        <div class="col-lg-4">
            <!-- CARD AVATAR -->
            <div class="card border-0 shadow-sm rounded-4 text-center">
                <div class="card-body p-4">
                    <div class="position-relative d-inline-block">
                        {% if app.user.photo %}
                            <img src="{{ asset('uploads/employees/' ~ app.user.photo) }}" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                        {% else %}
                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 48px; margin: 0 auto;">
                                {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                            </div>
                        {% endif %}
                        {% set color = app.user.isActive == 1 ? 'success' : 'warning' %}
                        <span class="position-absolute bottom-0 end-0 bg-{{ color }} rounded-circle border-2 border-white" style="width: 14px; height: 14px;"></span>
                    </div>
                    <h4 class="fw-bold mt-3 mb-1">{{ app.user.prenom }} {{ app.user.nom }}</h4>

                    {# ROLES + POSTE + SERVICE DYNAMIQUES #}
                    {% set mainRole = app.user.roles|filter(r => r!= 'ROLE_USER')|first %}
                    <p class="text-muted small mb-0">{{ app.user.poste?? mainRole|replace({'ROLE_': ''})|title }}/ <span class="text-muted small">{{ app.user.service?? app.user.entreprise.nom }}</span></p>
                    <hr>
                    <div class="text-start">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <i class="bi bi-envelope text-primary" style="width: 20px;"></i>
                            <div>
                                <small class="text-muted d-block">Email</small>
                                <span class="fw-semibold">{{ app.user.email }}</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <i class="bi bi-telephone text-primary" style="width: 20px;"></i>
                            <div>
                                <small class="text-muted d-block">Téléphone</small>
                                <span class="fw-semibold">{{ app.user.telephone?? '-' }}</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-geo-alt text-primary" style="width: 20px;"></i>
                            <div>
                                <small class="text-muted d-block">Adresse</small>
                                <span class="fw-semibold">{{ app.user.adresse?? '-' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLONNE DROITE -->
        <div class="col-lg-8">
            <!-- CARD INFORMATIONS -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle text-primary me-2"></i>Informations
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Date d'embauche</small>
                                <span class="fw-semibold">{{ app.user.dateEmbauche? app.user.dateEmbauche|date('d/m/Y') : '-' }}</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Heures contractuelles</small>
                                <span class="fw-semibold">{{ app.user.heuresContractuelles }}h/jour</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted d-block">Solde congés</small>
                                <span class="fw-semibold">
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">{{ app.user.soldeConge }} jours</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD SECURITE -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-shield-lock text-primary me-2"></i>Sécurité
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <div class="fw-semibold">Mot de passe</div>
                            <small class="text-muted">••••</small>
                        </div>
                        <a href="" class="btn btn-outline-primary">
                            <i class="bi bi-key me-2"></i>Changer mon mot de passe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
