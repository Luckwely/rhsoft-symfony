{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mes Fiches de Paie{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Mes Fiches de Paie</h1>
        <p class="text-muted mb-0">Consultez et téléchargez vos bulletins de salaire</p>
    </div>
    <div>
        <label for="yearSelect" class="visually-hidden">Année</label>
        <select id="yearSelect" class="form-select" onchange="window.location.href=this.value">
            {% for year in availableYears %}
                <option value="{{ path('app_employee_payslips', {year: year}) }}" {% if year == selectedYear %}selected{% endif %}>
                    {{ year }}
                </option>
            {% endfor %}
        </select>
    </div>
</div>

{# KPI cards - stack on mobile, 3-up from md #}
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card card-custom h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Dernier salaire net</div>
                <div class="fs-4 fw-bold">{{ kpis.lastNetSalary|number_format(0, ',', ' ') }} Ar</div>
                <div class="text-muted small">{{ kpis.lastPayslipMonth }}</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Salaire brut moyen</div>
                <div class="fs-4 fw-bold">{{ kpis.averageGrossSalary|number_format(0, ',', ' ') }} Ar</div>
                <div class="text-muted small">sur {{ selectedYear }}</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card card-custom h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Total cotisations</div>
                <div class="fs-4 fw-bold">{{ kpis.totalDeductions|number_format(0, ',', ' ') }} Ar</div>
                <div class="text-muted small">sur {{ selectedYear }}</div>
            </div>
        </div>
    </div>
</div>

{# Payslips: cards on mobile/tablet, table from lg up #}
<div class="card card-custom">
    <div class="card-body p-0">

        {# Mobile / tablet: stacked cards #}
        <div class="d-lg-none">
            {% for payslip in payslips %}
                <div class="p-3 {% if not loop.last %}border-bottom{% endif %}">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="fw-semibold">{{ payslip.mois }}/{{ payslip.annee }}</div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">{{ payslip.status }}</span>
                    </div>
                    <div class="row g-2 small text-muted mb-3">
                        <div class="col-6">Brut : <span class="text-dark">{{ payslip.salaireBrut }} Ar</span></div>
                        <div class="col-6">Net : <span class="text-dark fw-semibold">{{ payslip.salaireNet }} Ar</span></div>
                    </div>
                    <a href="{{ path('app_employee_payslip_download', {id: payslip.id}) }}" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-download me-1"></i>Télécharger
                    </a>
                </div>
            {% else %}
                <div class="p-4 text-center text-muted">
                    Aucune fiche de paie trouvée pour l'année {{ selectedYear }}.
                </div>
            {% endfor %}
        </div>

        {# Large screens: full table #}
        <div class="table-responsive d-none d-lg-block">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mois</th>
                        <th>Année</th>
                        <th>Salaire Brut</th>
                        <th>Salaire Net</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payslip in payslips %}
                        <tr>
                            <td>{{ payslip.mois }}</td>
                            <td>{{ payslip.annee }}</td>
                            <td>{{ payslip.salaireBrut }} Ar</td>
                            <td class="fw-semibold">{{ payslip.salaireNet }} Ar</td>
                            <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">{{ payslip.status }}</span></td>
                            <td class="text-end">
                                <a href="{{ path('app_employee_payslip_download', {id: payslip.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="bi bi-download me-1"></i>Télécharger
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4">Aucune fiche de paie trouvée pour l'année {{ selectedYear }}.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>
{% endblock %}
