{% extends 'layouts/base_employe.html.twig' %}

{% block title %}Mes Congés{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-umbrella text-primary me-2"></i>Mes Congés
            </h3>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar-check me-1"></i>Gérez vos demandes de congés
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">JD</div>
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-semibold">Jean Dupont</span>
                <small class="text-muted">Développeur - Tech</small>
            </div>
        </div>
    </div>

    <!-- NAVIGATION ONGLETS BOOTSTRAP -->
    <ul class="nav nav-tabs border-0 gap-2 mb-4" id="congeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active border-0 rounded-3 px-4"
                    id="tab-demander-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-demander"
                    type="button"
                    role="tab"
                    aria-controls="tab-demander"
                    aria-selected="true">
                <i class="bi bi-pencil-square text-success me-2"></i>Demander
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link border-0 rounded-3 px-4"
                    id="tab-solde-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-solde"
                    type="button"
                    role="tab"
                    aria-controls="tab-solde"
                    aria-selected="false">
                <i class="bi bi-wallet2 text-primary me-2"></i>Solde
                <span class="badge bg-info ms-1">18j</span>
            </button>
        </li>
    </ul>

    <!-- CONTENU ONGLETS -->
    <div class="tab-content" id="congeTabsContent">

        <!-- ONGLET 1: DEMANDER -->
        <div class="tab-pane fade show active" id="tab-demander" role="tabpanel" aria-labelledby="tab-demander-btn">
            <div class="row g-4">
                <!-- FORMULAIRE -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-plus-circle text-success me-2"></i>Nouvelle demande de congé
                            </h5>
                            <small class="text-muted">Remplissez le formulaire ci-dessous</small>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Type de congé <span class="text-danger">*</span></label>
                                    <select class="form-select">
                                        <option value="paye" selected>Congé Payé</option>
                                        <option value="rtt">RTT</option>
                                        <option value="maladie">Maladie</option>
                                        <option value="sans_solde">Sans Solde</option>
                                    </select>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">Date début <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" value="2025-11-10">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">Date fin <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" value="2025-11-15">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nombre de jours</label>
                                    <div class="bg-light rounded-3 p-3 text-center">
                                        <span class="fw-bold text-primary fs-4">5 jours</span>
                                        <small class="text-muted d-block">(du 10/11/2025 au 15/11/2025)</small>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Motif <span class="text-danger">*</span></label>
                                    <textarea class="form-control" rows="4" placeholder="Précisez le motif de votre demande..."></textarea>
                                </div>
                                <div class="mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="notifyManager">
                                        <label class="form-check-label" for="notifyManager">
                                            <i class="bi bi-bell me-1"></i>Notifier mon manager
                                        </label>
                                    </div>
                                </div>
                                <button class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-send me-2"></i>Envoyer la demande
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- RÉCAPITULATIF -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-clipboard-data text-primary me-2"></i>Récapitulatif
                            </h5>
                            <small class="text-muted">Vos soldes disponibles</small>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-2">
                                <div>
                                    <span class="text-muted small">Congés Payés</span>
                                    <div class="fw-bold">18 jours</div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Disponible</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-2">
                                <div>
                                    <span class="text-muted small">RTT</span>
                                    <div class="fw-bold">5 jours</div>
                                </div>
                                <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">Disponible</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                                <div>
                                    <span class="text-muted small">Maladie</span>
                                    <div class="fw-bold">N/A</div>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">Sur justificatif</span>
                            </div>
                            <hr>
                            <div class="alert alert-info border-0 rounded-3 small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Vous avez utilisé <strong>7 jours</strong> sur 25 cette année
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONGLET 2: SOLDE -->
        <div class="tab-pane fade" id="tab-solde" role="tabpanel" aria-labelledby="tab-solde-btn">
            <!-- CARDS KPI -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Solde CP</span>
                                    <h2 class="fw-bold mb-0 mt-1 text-primary">18</h2>
                                    <small class="text-muted">Jours restants</small>
                                </div>
                                <div class="bg-primary-subtle rounded-3 p-3">
                                    <i class="bi bi-umbrella text-primary fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Solde RTT</span>
                                    <h2 class="fw-bold mb-0 mt-1 text-info">5</h2>
                                    <small class="text-muted">Jours restants</small>
                                </div>
                                <div class="bg-info-subtle rounded-3 p-3">
                                    <i class="bi bi-clock text-info fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Maladie</span>
                                    <h2 class="fw-bold mb-0 mt-1">N/A</h2>
                                    <small class="text-muted">Sur justificatif</small>
                                </div>
                                <div class="bg-secondary-subtle rounded-3 p-3">
                                    <i class="bi bi-heart-pulse text-secondary fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TIMELINE DEMANDES -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Demandes passées
                    </h5>
                    <small class="text-muted">Historique de vos demandes</small>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <!-- Demande 1 - Approuvée -->
                        <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                            <div class="bg-success-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                <i class="bi bi-check-lg text-success fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">Congé Payé</div>
                                        <small class="text-muted">15/07/2025 au 20/07/2025 • 5 jours</small>
                                    </div>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Demande 2 - Refusée -->
                        <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                            <div class="bg-danger-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                <i class="bi bi-x-lg text-danger fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">RTT</div>
                                        <small class="text-muted">22/09/2025 • 1 jour</small>
                                    </div>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Demande 3 - En attente -->
                        <div class="d-flex gap-3">
                            <div class="bg-warning-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                <i class="bi bi-clock text-warning fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">Congé Payé</div>
                                        <small class="text-muted">10/11/2025 au 15/11/2025 • 5 jours</small>
                                    </div>
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                        <i class="bi bi-clock-history me-1"></i>En attente
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAU HISTORIQUE -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-list-check text-primary me-2"></i>Historique des congés pris
                    </h5>
                    <button class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-download me-1"></i>Exporter
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3 py-3">Type</th>
                                    <th class="py-3">Période</th>
                                    <th class="py-3 text-center">Durée</th>
                                    <th class="py-3 text-center pe-3">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-umbrella me-1"></i>Congé Payé
                                        </span>
                                    </td>
                                    <td>15/07/2025 au 20/07/2025</td>
                                    <td class="text-center"><span class="fw-semibold">5 jours</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>RTT
                                        </span>
                                    </td>
                                    <td>10/08/2025</td>
                                    <td class="text-center"><span class="fw-semibold">1 jour</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-heart-pulse me-1"></i>Maladie
                                        </span>
                                    </td>
                                    <td>05/09/2025</td>
                                    <td class="text-center"><span class="fw-semibold">2 jours</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>Approuvé
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-umbrella me-1"></i>Congé Payé
                                        </span>
                                    </td>
                                    <td>22/09/2025</td>
                                    <td class="text-center"><span class="fw-semibold">1 jour</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <i class="bi bi-x-circle-fill me-1"></i>Refusé
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                            <i class="bi bi-umbrella me-1"></i>Congé Payé
                                        </span>
                                    </td>
                                    <td>10/11/2025 au 15/11/2025</td>
                                    <td class="text-center"><span class="fw-semibold">5 jours</span></td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                            <i class="bi bi-clock-history me-1"></i>En attente
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>5 congés sur 12 mois
                    </small>
                    <nav aria-label="Pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Style pour les onglets modernes -->
<style>
    .nav-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    .nav-tabs .nav-link.active .badge {
        background-color: rgba(255,255,255,0.25) !important;
        color: #ffffff !important;
    }
    .tab-pane {
        animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}
