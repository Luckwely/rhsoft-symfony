<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}RHSOFT{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- Bootstrap Icons (for logo placeholder and social) -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <!-- Google Fonts (optional polish) -->
        <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

        <style>
            #navbar {
                transition: background-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
            }
            /* Class added dynamically via JS when scrolling */
            #navbar.scrolled {
                background-color: #ffffff !important; /* Solid background color (white here) */
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
            }
            /* Optional: Change text color if your initial navbar text is white and background becomes light */
            #navbar.scrolled .nav-link,
            #navbar.scrolled .navbar-brand {
                color: #212529 !important; /* Dark text color for light background */
            }
        </style>
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="">

        {# NAVBAR #}
        <div class="fixed-top">
            {% include 'partials/_navbar.html.twig' %}
        </div>

        {# MAIN #}
        <div class="">
            {% block body %}{% endblock %}
        </div>

        {# FOOTER #}
        <div class="">
            {% include 'partials/_footer.html.twig' %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const navbar = document.getElementById("navbar");

                window.addEventListener("scroll", function () {
                    if (window.scrollY > 50) {
                        navbar.classList.add("scrolled");
                    } else {
                        navbar.classList.remove("scrolled");
                    }
                });
            });
        </script>
    </body>
</html>
